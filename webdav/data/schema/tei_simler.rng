   <define name="tei_att.personal.attributes">
      <ref name="tei_att.naming.attributes"/>
      <ref name="tei_att.personal.attribute.full"/>
   </define>
   <define name="tei_att.personal.attribute.full">
      <optional>
         <attribute xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
                    name="full"
                    a:defaultValue="yes">
            <a:documentation>indicates whether the name component is given in full, as an abbreviation or simply as an initial.</a:documentation>
            <choice>
               <value>yes</value>
               <a:documentation>(yes) the name component is spelled out in full.</a:documentation>
               <value>abb</value>
               <a:documentation>(abbreviated) the name component is given in an abbreviated form.</a:documentation>
               <value>init</value>
               <a:documentation>(initial letter) the name component is indicated only by one initial.</a:documentation>
            </choice>
         </attribute>
      </optional>
   </define>
   <define name="tei_p">
      <element name="p">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(paragraph) A prose paragraph (e.g. closing formulae of a book, captions, header notes). [3.1. Paragraphs 7.2.6. Speech Contents]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_hi"/>
               <ref name="tei_rs"/>
               <ref name="tei_choice"/>
               <ref name="tei_unclear"/>
               <ref name="tei_supplied"/>
               <ref name="tei_num"/>
               <ref name="tei_note"/>
               <ref name="tei_ref"/>
               <ref name="tei_lg"/>
               <ref name="tei_anchor"/>
               <ref name="tei_fw"/>
               <ref name="tei_lb"/>
               <ref name="tei_pb"/>
            </choice>
         </zeroOrMore>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-p-abstractModel-structure-p-in-ab-or-p-constraint-rule-8">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:p">
               <sch:report test="(ancestor::tei:ab or ancestor::tei:p) and                        not( ancestor::tei:floatingText                           | parent::tei:exemplum                           | parent::tei:item                           | parent::tei:note                           | parent::tei:q                           | parent::tei:quote                           | parent::tei:remarks                           | parent::tei:said                           | parent::tei:sp                           | parent::tei:stage                           | parent::tei:cell                           | parent::tei:figure )">
          Abstract model violation: Paragraphs may not occur inside other paragraphs or &lt;ab&gt; elements.
        </sch:report>
            </sch:rule>
         </pattern>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-p-abstractModel-structure-p-in-l-constraint-rule-9">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:l//tei:p">
               <sch:assert test="ancestor::tei:floatingText | parent::tei:figure | parent::tei:note">
          Abstract model violation: Metrical lines (&lt;l&gt; elements) may not contain higher-level structural elements such as &lt;div&gt;, &lt;p&gt;, or &lt;ab&gt;, unless &lt;p&gt; is a child of &lt;figure&gt; or &lt;note&gt;, or is a descendant of &lt;floatingText&gt;.
        </sch:assert>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_hi">
      <element name="hi">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(highlighted) A typographically distinct span of the source. <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@rendition</code> is required on <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;hi&gt;</code> (it is optional elsewhere) and points to one or more <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;rendition&gt;</code> declarations in <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;tagsDecl&gt;</code>; tokens combine (e.g. #aq #b). <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;hi&gt;</code> may nest. The renditions of a line or block — alignment (#c, #right) and indent (#et, #et2, #et3) — are recorded on the block, not on <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;hi&gt;</code>. [3.3.2.2. Emphatic Words and Phrases 3.3.2. Emphasis, Foreign Words, and Unusual Language]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-hi-hi-block-rendition-constraint-rule-10">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:hi[tokenize(@rendition, '\s+') = ('#c', '#right', '#et', '#et2', '#et3', '#hr', '#twocol', '#acrostic')]">
               <sch:report role="warning" test="true()">[S-HI] Alignment, indent and the other
                  block renditions (#c, #right, #et, #et2, #et3, #hr, #twocol, #acrostic) belong on
                  the enclosing block (head, p, l, lg, milestone, …), not on hi.</sch:report>
            </sch:rule>
         </pattern>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-hi-hi-spanning-rendition-constraint-rule-11">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:hi[@rendition][ancestor::tei:text]">
               <sch:report role="warning"
                           test="parent::tei:*[local-name() = ('head', 'p', 'ab', 'signed', 'salute', 'closer', 'opener', 'dateline', 'byline', 'postscript', 'argument', 'epigraph', 'trailer', 'docTitle', 'titlePart', 'docAuthor', 'docEdition', 'docImprint', 'l', 'lg', 'label', 'speaker', 'stage', 'item', 'cell', 'note', 'fw')] and not(../text()[normalize-space()]) and count(../*[not(self::tei:lb or self::tei:pb or self::tei:cb or self::tei:milestone or self::tei:anchor or self::tei:space or self::tei:gap)]) = 1 and count(@*) = 1 and node() and not(tokenize(@rendition, '\s+') = ('#in', '#sup', '#sub', '#acroInit', '#acroFin'))">[S-HIB]
                  This hi covers the whole &lt;<sch:value-of select="local-name(..)"/>&gt;: its
                  rendition belongs on the &lt;<sch:value-of select="local-name(..)"/>&gt;
                  (merged with the block's own, in tagsDecl order), and the hi can go.</sch:report>
            </sch:rule>
         </pattern>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-hi-hi-adjacent-constraint-rule-12">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:hi[@rendition][count(@*) = 1][ancestor::tei:text][not(tokenize(@rendition, '\s+') = ('#in', '#sup', '#sub', '#acroInit', '#acroFin'))]">
               <sch:report role="warning"
                           test="let $n := following-sibling::*[not(self::tei:lb)][1] return $n[self::tei:hi][count(@*) = 1][@rendition = current()/@rendition] and exists(following-sibling::tei:lb[. &lt;&lt; $n]) and not(following-sibling::node()[. &lt;&lt; $n][self::comment() or self::processing-instruction() or self::text()[normalize-space()] or self::*[not(self::tei:lb)] or self::tei:lb[*]]) and string-length(normalize-space(.)) gt 1 and string-length(normalize-space($n)) gt 1 and (every $b in following-sibling::tei:lb[. &lt;&lt; $n] satisfies $b/@break = 'no' or ancestor::*[not(self::tei:hi)][1][local-name() = ('head', 'l', 'p', 'signed', 'closer', 'salute', 'dateline', 'byline', 'trailer', 'titlePart', 'docTitle', 'docAuthor', 'docImprint', 'docEdition', 'label', 'item')])">[S-HIA]
                  The next hi has the same rendition and only line ends stand between: one hi
                  across them.</sch:report>
            </sch:rule>
         </pattern>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-hi-hi-nesting-constraint-rule-13">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:hi[@rendition][ancestor::tei:text]">
               <sch:report role="warning"
                           test="parent::tei:hi and not(../text()[normalize-space()]) and count(../*[not(self::tei:lb or self::tei:pb or self::tei:cb or self::tei:milestone or self::tei:anchor or self::tei:space or self::tei:gap)]) = 1 and count(@*) = 1">[S-HIN]
                  This hi is the whole content of its parent hi: one hi with both renditions
                  (<sch:value-of select="../@rendition"/>
                  <sch:value-of select="@rendition"/>).</sch:report>
               <sch:report role="warning"
                           test="some $t in tokenize(normalize-space(@rendition), ' ') satisfies $t = (for $a in ancestor::*[@rendition] return tokenize(normalize-space($a/@rendition), ' '))">[S-HIR]
                  A token of this hi (<sch:value-of select="@rendition"/>) is already on an
                  ancestor: leave it out.</sch:report>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attribute.xmlid"/>
         <ref name="tei_att.global.attribute.n"/>
         <ref name="tei_att.global.attribute.xmllang"/>
         <ref name="tei_att.global.facs.attribute.facs"/>
         <ref name="tei_att.global.linking.attribute.corresp"/>
         <ref name="tei_att.global.linking.attribute.sameAs"/>
         <ref name="tei_att.global.linking.attribute.next"/>
         <ref name="tei_att.global.linking.attribute.prev"/>
         <ref name="tei_att.global.responsibility.attribute.cert"/>
         <ref name="tei_att.global.responsibility.attribute.resp"/>
         <attribute name="rendition">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(rendition reference) One or more pointers to <code xmlns="http://www.w3.org/1999/xhtml"
                     xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;rendition&gt;</code> elements in <code xmlns="http://www.w3.org/1999/xhtml"
                     xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;tagsDecl&gt;</code>, recording the appearance of the source passage (e.g. #aq, #aq #et), in the order of <code xmlns="http://www.w3.org/1999/xhtml"
                     xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;tagsDecl&gt;</code>.</a:documentation>
            <list>
               <oneOrMore>
                  <choice>
                     <value>#aq</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">Antiqua in a Fraktur work</a:documentation>
                     <value>#fr</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">Fraktur within Antiqua</a:documentation>
                     <value>#b</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">bold</a:documentation>
                     <value>#i</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">italic</a:documentation>
                     <value>#c</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">centred</a:documentation>
                     <value>#right</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">right-aligned</a:documentation>
                     <value>#g</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">letter-spaced (gesperrt)</a:documentation>
                     <value>#k</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">small capitals</a:documentation>
                     <value>#u</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">underlined</a:documentation>
                     <value>#in</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">initial</a:documentation>
                     <value>#sup</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">superscript</a:documentation>
                     <value>#sub</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">subscript</a:documentation>
                     <value>#larger</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">larger than the main text</a:documentation>
                     <value>#smaller</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">smaller than the main text</a:documentation>
                     <value>#et</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">indented</a:documentation>
                     <value>#et2</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">indented twice</a:documentation>
                     <value>#et3</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">indented three times</a:documentation>
                     <value>#hr</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a rule (line) between units</a:documentation>
                     <value>#twocol</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">two interleaved columns</a:documentation>
                     <value>#acrostic</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">an acrostic line</a:documentation>
                     <value>#acroInit</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">the acrostic's initial letter</a:documentation>
                     <value>#acroFin</value>
                     <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">the acrostic's final letter</a:documentation>
                  </choice>
               </oneOrMore>
            </list>
         </attribute>
         <empty/>
      </element>
   </define>
   <define name="tei_quote">
      <element name="quote">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(quotation) contains a phrase or passage attributed by the narrator or author to some agency external to the text. [3.3.3. Quotation 4.3.1. Grouped Texts]</a:documentation>
         <ref name="tei_macro.specialPara"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_cit">
      <element name="cit">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(cited quotation) contains a quotation from some other document, together with a bibliographic reference to its source. In a dictionary it may contain an example text with at least one occurrence of the word form, used in the sense being described, or a translation of the headword, or an example. [3.3.3. Quotation 4.3.1. Grouped Texts 10.3.5.1. Examples]</a:documentation>
         <oneOrMore>
            <choice>
               <ref name="tei_model.biblLike"/>
               <ref name="tei_model.egLike"/>
               <ref name="tei_model.entryPart"/>
               <ref name="tei_model.global"/>
               <ref name="tei_model.graphicLike"/>
               <ref name="tei_model.ptrLike"/>
               <ref name="tei_model.attributable"/>
            </choice>
         </oneOrMore>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_sic">
      <element name="sic">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(Latin for thus or so) The reading actually present in the source, retained unchanged. [3.5.1. Apparent Errors]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_corr">
      <element name="corr">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(correction) The editorial correction of an obvious printing error. [3.5.1. Apparent Errors]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.editLike.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_choice">
      <element name="choice">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(choice) Groups the source reading and the editors' one, the source first, as in the DTA base format: a printing error (<code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;sic&gt;</code>) and its correction (<code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;corr&gt;</code>), or an abbreviation (<code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;abbr&gt;</code>) and its expansion (<code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;expan&gt;</code>). [3.5. Simple Editorial Changes]</a:documentation>
         <oneOrMore>
            <choice>
               <ref name="tei_sic"/>
               <ref name="tei_corr"/>
               <ref name="tei_abbr"/>
               <ref name="tei_expan"/>
            </choice>
         </oneOrMore>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-choice-choice-order-constraint-rule-14">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:choice">
               <sch:report role="warning"
                           test="tei:corr[following-sibling::tei:sic] or tei:expan[following-sibling::tei:abbr]">[S-CHO]
                  In choice the source reading comes first: sic before corr, abbr before
                  expan.</sch:report>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_unclear">
      <element name="unclear">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(unclear) A passage that cannot be read with certainty; <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@reason</code> records why. [12.3.3.1. Damage, Illegibility, and Supplied Text 3.5.3. Additions, Deletions, and Omissions]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.dimensions.attributes"/>
         <ref name="tei_att.editLike.attributes"/>
         <optional>
            <attribute name="reason">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">indicates why the material is hard to transcribe.
Suggested values include: 1] uncleanPrint; 2] covered</a:documentation>
               <list>
                  <oneOrMore>
                     <choice>
                        <value>uncleanPrint</value>
                        <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">illegible because of poor / unclean printing</a:documentation>
                        <value>covered</value>
                        <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">covered or obscured on the page</a:documentation>
                        <data type="token">
                           <param name="pattern">[^\p{C}\p{Z}]+</param>
                        </data>
                     </choice>
                  </oneOrMore>
               </list>
            </attribute>
         </optional>
         <optional>
            <attribute name="agent">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">Where the difficulty in transcription arises from damage, categorizes the cause of the damage, if it can be identified.
Sample values include: 1] rubbing; 2] mildew; 3] smoke</a:documentation>
               <data type="token">
                  <param name="pattern">[^\p{C}\p{Z}]+</param>
               </data>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_name">
      <element name="name">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(name, proper noun) contains a proper noun or noun phrase. [3.6.1. Referring Strings]</a:documentation>
         <ref name="tei_macro.phraseSeq"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.datable.attributes"/>
         <ref name="tei_att.editLike.attributes"/>
         <ref name="tei_att.personal.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_rs">
      <element name="rs">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(referencing string) A referencing string identifying a named entity. <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@type</code> classifies the entity; <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@key</code> is the typed identifier of the entry in the project registers (its prefix should match <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@type</code>). [14.2.1. Personal Names 3.6.1. Referring Strings]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_hi"/>
               <ref name="tei_rs"/>
               <ref name="tei_choice"/>
               <ref name="tei_unclear"/>
               <ref name="tei_supplied"/>
               <ref name="tei_note"/>
               <ref name="tei_anchor"/>
               <ref name="tei_lb"/>
            </choice>
         </zeroOrMore>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-rs-rs-key-constraint-rule-15">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:rs">
               <sch:let name="register"
                        value="if (@type = 'org') then 'institution' else if (@type = 'bibl') then 'work' else string(@type)"/>
               <sch:assert test="every $key in tokenize(normalize-space(@key), ' ') satisfies matches($key, concat('^', $register, '_\d+$'))">[S-RK]
                  "<sch:value-of select="@key"/>" is not a list of keys of the <sch:value-of select="$register"/> register.</sch:assert>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.naming.attributes"/>
         <attribute name="type">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">characterizes the element in some sense, using any convenient classification scheme or typology.
Suggested values include: 1] person; 2] place; 3] org; 4] institution; 5] work; 6] bibl</a:documentation>
            <choice>
               <value>person</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">person</a:documentation>
               <value>place</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">place</a:documentation>
               <value>org</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">organisation</a:documentation>
               <value>institution</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">institution</a:documentation>
               <value>work</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">literary work</a:documentation>
               <value>bibl</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a Bible reference (never the research bibliography)</a:documentation>
               <data type="token">
                  <param name="pattern">[^\p{C}\p{Z}]+</param>
               </data>
            </choice>
         </attribute>
         <attribute name="key">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">The entry in the register of <code xmlns="http://www.w3.org/1999/xhtml"
                     xmlns:rng="http://relaxng.org/ns/structure/1.0">@type</code>, as {register}_{number} (e.g. person_049); a reference to several entries, such as zween treffliche Musikanten, lists them, separated by spaces (person_012 person_310); see rs-key.</a:documentation>
            <data type="string"/>
         </attribute>
         <empty/>
      </element>
   </define>
   <define name="tei_num">
      <element name="num">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(number) A number (Roman or Arabic) marked as such in the source. [3.6.3. Numbers and
Measures]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">indicates the type of numeric value.
Suggested values include: 1] cardinal; 2] ordinal; 3] fraction; 4] percentage</a:documentation>
               <choice>
                  <value>cardinal</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">absolute number, e.g. 21, 21.5</a:documentation>
                  <value>ordinal</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">ordinal number, e.g. 21st</a:documentation>
                  <value>fraction</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">fraction, e.g. one half or three-quarters</a:documentation>
                  <value>percentage</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a percentage</a:documentation>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <optional>
            <attribute name="value">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">supplies the value of the number in standard form.</a:documentation>
               <choice>
                  <data type="double"/>
                  <data type="token">
                     <param name="pattern">(\-?[\d]+/\-?[\d]+)</param>
                  </data>
                  <data type="decimal"/>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_measure">
      <element name="measure">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(measure) contains a word or phrase referring to some quantity of an object or commodity, usually comprising a number, a unit, and a commodity name. [3.6.3. Numbers and
Measures]</a:documentation>
         <ref name="tei_macro.phraseSeq"/>
         <ref name="tei_att.global.attributes"/>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">specifies the type of measurement in any convenient typology.
Suggested values include: 1] pages</a:documentation>
               <choice>
                  <value>pages</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">number of pages</a:documentation>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_date">
      <element name="date">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(date) contains a date in any format. [3.6.4. Dates and Times 2.2.4. Publication, Distribution, Licensing, etc. 2.6. The Revision Description 3.12.2.4. Imprint, Size of a Document, and Reprint Information 16.2.3. The Setting Description 14.4. Dates]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_model.gLike"/>
               <ref name="tei_model.phrase"/>
               <ref name="tei_model.global"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.canonical.attributes"/>
         <ref name="tei_att.datable.attributes"/>
         <ref name="tei_att.dimensions.attributes"/>
         <ref name="tei_att.editLike.attributes"/>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">characterizes the element in some sense, using any convenient classification scheme or typology.
Suggested values include: 1] publication; 2] firstPublication; 3] importDTA</a:documentation>
               <choice>
                  <value>publication</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">date of publication of the source</a:documentation>
                  <value>firstPublication</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">date of first publication</a:documentation>
                  <value>importDTA</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">date of the DTA import</a:documentation>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_abbr">
      <element name="abbr">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(abbreviation) An abbreviation as it appears in the source. [3.6.5. Abbreviations and Their Expansions]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(type) allows the encoder to classify the abbreviation according to some convenient typology.
Sample values include: 1] suspension (suspension); 2] contraction (contraction); 3] brevigraph; 4] superscription (superscription); 5] acronym (acronym); 6] title (title); 7] organization (organization); 8] geographic (geographic)</a:documentation>
               <data type="token">
                  <param name="pattern">[^\p{C}\p{Z}]+</param>
               </data>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_expan">
      <element name="expan">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(expansion) The editorial expansion of an abbreviation, beside it in <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;choice&gt;</code>. [3.6.5. Abbreviations and Their Expansions]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.editLike.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_ref">
      <element name="ref">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(reference) defines a reference to another location, possibly modified by additional text or comment. [3.7. Simple Links and Cross-References 17.1. Links]</a:documentation>
         <ref name="tei_macro.paraContent"/>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-ref-refAtts-constraint-rule-16">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:ref">
               <sch:report test="@target and @cRef">Only one of the attributes @target and @cRef may be supplied on &lt;<sch:name/>&gt;.</sch:report>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.cReferencing.attributes"/>
         <ref name="tei_att.pointing.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_list">
      <element name="list">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(list) A list. [3.8. Lists]</a:documentation>
         <zeroOrMore>
            <choice>
               <ref name="tei_head"/>
               <ref name="tei_item"/>
               <ref name="tei_lb"/>
               <ref name="tei_pb"/>
            </choice>
         </zeroOrMore>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-list-gloss-list-must-have-labels-constraint-rule-17">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:list[@type='gloss']">
               <sch:assert test="tei:label">
          The content of a "gloss" list should include a sequence of
          one or more pairs of a &lt;label&gt; element followed by an
          &lt;item&gt; element.
        </sch:assert>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attributes"/>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(type) describes the nature of the items in the list.
Suggested values include: 1] gloss (gloss); 2] index (index); 3] instructions (instructions); 4] litany (litany); 5] syllogism (syllogism)</a:documentation>
               <choice>
                  <value>gloss</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(gloss) each list item glosses some term or concept, which is given by a <code xmlns="http://www.w3.org/1999/xhtml"
                           xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;label&gt;</code> element preceding the list item.</a:documentation>
                  <value>index</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(index) each list item is an entry in an index such as the alphabetical topical index at the back of a print volume.</a:documentation>
                  <value>instructions</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(instructions) each list item is a step in a sequence of instructions, as in a recipe.</a:documentation>
                  <value>litany</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(litany) each list item is one of a sequence of petitions, supplications or invocations, typically in a religious ritual.</a:documentation>
                  <value>syllogism</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(syllogism) each list item is part of an argument consisting of two or more propositions and a final conclusion derived from them.</a:documentation>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_item">
      <element name="item">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(item) contains one component of a list. [3.8. Lists 2.6. The Revision Description]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_label">
      <element name="label">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(label) A label, typically the (often editorially supplied, bracketed) number of a heading or poem. [3.8. Lists]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.placement.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_head">
      <element name="head">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(heading) A heading of a <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;div&gt;</code>, <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lg&gt;</code>, <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;list&gt;</code> or <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;figure&gt;</code>. [4.2.1. Headings and Trailers]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_hi"/>
               <ref name="tei_label"/>
               <ref name="tei_num"/>
               <ref name="tei_rs"/>
               <ref name="tei_choice"/>
               <ref name="tei_unclear"/>
               <ref name="tei_supplied"/>
               <ref name="tei_note"/>
               <ref name="tei_fw"/>
               <ref name="tei_anchor"/>
               <ref name="tei_lb"/>
               <ref name="tei_pb"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attribute.xmlid"/>
         <ref name="tei_att.global.attribute.xmllang"/>
         <ref name="tei_att.global.facs.attribute.facs"/>
         <ref name="tei_att.global.linking.attribute.corresp"/>
         <ref name="tei_att.global.linking.attribute.sameAs"/>
         <ref name="tei_att.global.linking.attribute.next"/>
         <ref name="tei_att.global.linking.attribute.prev"/>
         <ref name="tei_att.global.rendition.attribute.rendition"/>
         <ref name="tei_att.global.responsibility.attribute.cert"/>
         <ref name="tei_att.global.responsibility.attribute.resp"/>
         <ref name="tei_att.placement.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <optional>
            <attribute name="n">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(number) gives a number (or other label) for an element, which is not necessarily unique within the document.</a:documentation>
               <data type="string"/>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_note">
      <element name="note">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(note) A note. Editorial notes (annotation) comment on a range delimited by an <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;anchor&gt;</code> and <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@targetEnd</code>, or without one on the whole division; Bible references, speaker names and marginalia are printed in the source. [3.9.1. Notes and Simple Annotation 2.2.6. The Notes Statement 3.12.2.8. Notes and Statement of Language 10.3.5.4. Notes within Entries]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_p"/>
               <ref name="tei_hi"/>
               <ref name="tei_rs"/>
               <ref name="tei_choice"/>
               <ref name="tei_unclear"/>
               <ref name="tei_supplied"/>
               <ref name="tei_note"/>
               <ref name="tei_anchor"/>
               <ref name="tei_lb"/>
            </choice>
         </zeroOrMore>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-note-note-range-constraint-rule-18">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:note[@targetEnd]">
               <sch:let name="id" value="replace(@targetEnd, '^#', '')"/>
               <sch:assert test="preceding::tei:anchor[@xml:id = $id]">[S-NR] targetEnd names no
                  preceding anchor.</sch:assert>
            </sch:rule>
         </pattern>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-note-note-type-constraint-rule-19">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:note[not(@targetEnd)]">
               <sch:assert role="warning" test="@type">[S-NT] A note without targetEnd needs a
                  type.</sch:assert>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.anchoring.attributes"/>
         <ref name="tei_att.pointing.attributes"/>
         <optional>
            <attribute name="place">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">specifies where this item is placed.
Suggested values include: 1] left; 2] right; 3] bottom</a:documentation>
               <list>
                  <oneOrMore>
                     <choice>
                        <value>left</value>
                        <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                        <value>right</value>
                        <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                        <value>bottom</value>
                        <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                        <data type="token">
                           <param name="pattern">[^\p{C}\p{Z}]+</param>
                        </data>
                     </choice>
                  </oneOrMore>
               </list>
            </attribute>
         </optional>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">characterizes the element in some sense, using any convenient classification scheme or typology.
Suggested values include: 1] annotation; 2] bibl; 3] speaker; 4] marginalia; 5] remarkResponsibility</a:documentation>
               <choice>
                  <value>annotation</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">an editorial annotation</a:documentation>
                  <value>bibl</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a marginal Bible reference printed in the source</a:documentation>
                  <value>speaker</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a speaker designation in dialogue verse</a:documentation>
                  <value>marginalia</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a marginal note printed in the source</a:documentation>
                  <value>remarkResponsibility</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a note on editorial responsibility</a:documentation>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_milestone">
      <element name="milestone">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(milestone) An empty milestone marking a structural section boundary in the source. <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@unit</code> is required; the rule it prints is its <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@rendition</code> (#hr, as in the DTA base format). [3.11.3. Milestone
Elements]</a:documentation>
         <empty/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <attribute name="unit">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">provides a conventional name for the kind of section changing at this milestone.
Suggested values include: 1] section</a:documentation>
            <choice>
               <value>section</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a section boundary within the text</a:documentation>
               <data type="token">
                  <param name="pattern">[^\p{C}\p{Z}]+</param>
               </data>
            </choice>
         </attribute>
         <empty/>
      </element>
   </define>
   <define name="tei_pb">
      <element name="pb">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(page beginning) Marks the beginning of a new printed page. <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@n</code> gives the printed page number (bracketed when editorially supplied); <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@facs</code> names the page image. [3.11.3. Milestone
Elements]</a:documentation>
         <empty/>
         <ref name="tei_att.global.attribute.xmlid"/>
         <ref name="tei_att.global.attribute.xmllang"/>
         <ref name="tei_att.global.linking.attribute.corresp"/>
         <ref name="tei_att.global.linking.attribute.sameAs"/>
         <ref name="tei_att.global.linking.attribute.next"/>
         <ref name="tei_att.global.linking.attribute.prev"/>
         <ref name="tei_att.global.rendition.attribute.rendition"/>
         <ref name="tei_att.global.responsibility.attribute.cert"/>
         <ref name="tei_att.global.responsibility.attribute.resp"/>
         <ref name="tei_att.typed.attributes"/>
         <optional>
            <attribute name="n">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(number) gives a number (or other label) for an element, which is not necessarily unique within the document.</a:documentation>
               <data type="string"/>
            </attribute>
         </optional>
         <optional>
            <attribute name="facs">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(facsimile) The image identifier of the page, relative to the root of the IIIF manifest named by <code xmlns="http://www.w3.org/1999/xhtml"
                        xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;idno&gt;</code>
                  <code xmlns="http://www.w3.org/1999/xhtml"
                        xmlns:rng="http://relaxng.org/ns/structure/1.0">@type</code>=URLIIIF (e.g. 4017111). Optional: absent for pages identified only by a printer's signature.</a:documentation>
               <data type="anyURI">
                  <param name="pattern">\S+</param>
               </data>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_lb">
      <element name="lb">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(line beginning) Marks the end of a printed line (Zeilenschluss), following the DTA base format convention (<a xmlns="http://www.w3.org/1999/xhtml"
               xmlns:rng="http://relaxng.org/ns/structure/1.0"
               href="https://www.deutschestextarchiv.de/doku/basisformat/lbAllg.html">lbAllg</a>). Placement rules:  * <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lb&gt;</code> is never implicit: every line end is marked explicitly, including the end of the first line of a block.  * when a line end coincides with the end of one or more elements, the <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lb&gt;</code> follows the element that holds the line (<code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;l&gt;</code>, <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;p&gt;</code>, <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;head&gt;</code>, <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;closer&gt;</code>, <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;fw&gt;</code>, …) and stays inside every further ancestor: the line belongs to its unit, so its end does too. The line end of a stanza's last verse follows that stanza's <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lg&gt;</code>, never its last <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;l&gt;</code>; in nested groups it stays inside the enclosing <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lg&gt;</code>, and it never follows a closing <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;div&gt;</code>. A <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;note&gt;</code> set on its verse's line does not move it; a <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;note&gt;</code> printed on a line of its own ends with its own <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lb&gt;</code>.  * only <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;pb&gt;</code>, <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;cb&gt;</code> and <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;space&gt;</code> stand without a following <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lb&gt;</code>; and no <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lb&gt;</code> is set immediately before <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;front&gt;</code>/<code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;body&gt;</code>/<code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;back&gt;</code>/<code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;titlePage&gt;</code> closes.  * for a word hyphenated across the line, the visible hyphen is kept in the transcription and <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@break</code>=no is set on the <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lb&gt;</code> at that line end, and no whitespace stands beside it ([S-LBW]). A hyphen that ends a word (an ellipsis, as in buß- und gnadbegierig) takes a plain <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lb&gt;</code>. No whitespace stands next to a joined line end in the text; where the XML line breaks with the printed one, the break stands inside the tag (`er-&lt;lb`⏎`break="no"/&gt;weißt`). The Schematron constraint lb-line-end-placement checks this placement. [3.11.3. Milestone
Elements 7.2.6. Speech Contents]</a:documentation>
         <empty/>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-lb-lb-line-end-placement-constraint-rule-20">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:lb[not(@break='no')]">
               <sch:let name="last"
                        value="not(following-sibling::node()[self::* or self::text()[normalize-space()]])"/>
               <sch:let name="prev"
                        value="preceding-sibling::node()[self::* or self::text()[normalize-space()]][1]"/>
               <sch:report role="warning"
                           test="$last and not($prev[self::tei:lg]) and (parent::tei:l or parent::tei:head                       or parent::tei:p or parent::tei:list or parent::tei:item or parent::tei:hi                       or parent::tei:closer or parent::tei:salute or parent::tei:signed                       or parent::tei:dateline or parent::tei:titlePart or parent::tei:figure                       or parent::tei:fw or parent::tei:body or parent::tei:front)">[S-LB]
                  A line break (lb) marks a line END and follows the element that holds the line;
                  here it is the last child of &lt;<sch:value-of select="local-name(parent::*)"/>&gt;.
                  Move it to immediately after &lt;/<sch:value-of select="local-name(parent::*)"/>&gt;.</sch:report>
               <sch:report role="warning"
                           test="$last and parent::tei:lg and preceding-sibling::node()[self::* or self::text()[normalize-space()]][not(self::tei:note)][1][self::tei:l]">[S-LBV]
                  The line end of a stanza's last verse follows the stanza: move this lb to
                  immediately after &lt;/lg&gt;.</sch:report>
               <sch:report role="warning"
                           test="$prev[not(self::tei:lb)]/descendant::node()[self::* or self::text()[normalize-space()]][last()][self::tei:lb[not(@break='no')]]">[S-LB2]
                  The line before this lb already ends with an lb inside the preceding
                  &lt;<sch:value-of select="local-name($prev)"/>&gt;: nothing is printed between the
                  two, so this one is a doubling (or an empty line, which is not encoded).</sch:report>
               <sch:report role="warning" test="$prev[self::tei:div]">[S-LBD]
                  The line end of a unit's last line belongs to the unit: move this lb before
                  &lt;/div&gt;.</sch:report>
               <sch:report role="warning"
                           test="$prev[self::tei:lg][node()[self::* or self::text()[normalize-space()]][not(self::tei:note[preceding-sibling::node()[self::* or self::text()[normalize-space()]][1][self::tei:l]])][last()][not(self::tei:l or self::tei:lb)]]">[S-LBG]
                  This lb ends the last line of the preceding &lt;lg&gt;, a line held by its last
                  child &lt;<sch:value-of select="local-name($prev/*[last()])"/>&gt;: move the lb inside, directly after
                  &lt;/<sch:value-of select="local-name($prev/*[last()])"/>&gt;.</sch:report>
            </sch:rule>
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="(tei:l | tei:p | tei:head | tei:closer)[not(ancestor::tei:note)]">
               <sch:let name="next"
                        value="following::node()[self::* or self::text()[normalize-space()]][1]"/>
               <sch:let name="end"
                        value="(descendant::node()[self::* or self::text()[normalize-space()]])[last()]"/>
               <sch:report role="warning"
                           test="$next[self::tei:div or self::tei:lg] and not($end[self::tei:lb])                       and replace(replace(string(.), '\$[^$]*\$', ''), '[\s\p{Z}]', '') ne ''">[S-LBM]
                  The line of this &lt;<sch:value-of select="local-name()"/>&gt; ends before a new
                  &lt;<sch:value-of select="local-name($next)"/>&gt;, but its line end is not marked:
                  add an lb after it (after the stanza's &lt;/lg&gt; for a verse).</sch:report>
            </sch:rule>
         </pattern>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-lb-lb-joined-constraint-rule-22">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:lb[@break='no']">
               <sch:report role="warning"
                           test="not(preceding-sibling::node()[normalize-space() or self::*])">[S-LBJ]
                  A joined line end opens its element.</sch:report>
               <sch:report role="warning"
                           test="preceding-sibling::*[1][self::tei:fw[@type='catch']]">[S-LBC]
                  The line of a catchword ends with a plain lb.</sch:report>
               <sch:report role="warning"
                           test="(preceding-sibling::node()[1][self::text()][matches(., '\s$')] or following-sibling::node()[1][self::text()][matches(., '^\s')]) and (not(parent::tei:lg or parent::tei:div or parent::tei:body or parent::tei:front or parent::tei:back) or preceding-sibling::node()[1][self::text()[normalize-space()]] or following-sibling::node()[1][self::text()[normalize-space()]]) and preceding-sibling::node()[not(self::text()[not(normalize-space())])][1][self::text() or self::tei:hi or self::tei:supplied or self::tei:choice or self::tei:sic or self::tei:corr or self::tei:orig or self::tei:reg or self::tei:abbr or self::tei:expan or self::tei:unclear or self::tei:rs or self::tei:num or self::tei:foreign or self::tei:g] and following-sibling::node()[not(self::text()[not(normalize-space())])][1][self::text() or self::tei:hi or self::tei:supplied or self::tei:choice or self::tei:sic or self::tei:corr or self::tei:orig or self::tei:reg or self::tei:abbr or self::tei:expan or self::tei:unclear or self::tei:rs or self::tei:num or self::tei:foreign or self::tei:g]">[S-LBW]
                  Whitespace next to a joined line end splits the word in plain text: write
                  er-&lt;lb break="no"/&gt;weißt (a line break may stand inside the tag:
                  &lt;lb⏎ break="no"/&gt;). If the two words are separate, the line end is a
                  plain lb instead. Next to page furniture, an anchor or another verse this is not
                  checked.</sch:report>
               <sch:report role="warning"
                           test="matches(string-join(following-sibling::node()[position() le 2] ! string(), ''), '^\s*und([\s/.,:;!?]|$)', 'i')">[S-LBU]
                  The next word is "und": the hyphen ends a word (Geburt- und Sterb-Getichte), so the
                  line end is a plain lb.</sch:report>
            </sch:rule>
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:lb[not(@break)]">
               <sch:let name="end"
                        value="(preceding-sibling::node()[normalize-space()][1]/descendant-or-self::text()[normalize-space()])[last()]"/>
               <sch:report role="warning"
                           test="matches($end, '(^|[^-])[-¬⸗­‐‑]\s*$')                     and not($end/ancestor::tei:fw or $end/ancestor::*[@next])                     and not(matches(following-sibling::node()[normalize-space()][1], '^\s*(und|oder)([\s/.,:;!?]|$)', 'i'))">[S-LBH]
                  A hyphen ends the line, but the line end is not joined: if the word continues,
                  write lb break="no"; if the hyphen ends a word, nothing is to be done.</sch:report>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <optional>
            <attribute name="break">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
               <choice>
                  <value>no</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">the line break falls inside a word (hyphenation): the following line continues the broken word</a:documentation>
                  <value>yes</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">the line break coincides with a word boundary (the default)</a:documentation>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_cb">
      <element name="cb">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(column beginning) A column break, as in the DTA base format's occasional columns: <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@type</code>=start where the page's columns begin, a plain <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;cb&gt;</code> where each further column begins, <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@type</code>=end where they end. The first column needs no <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;cb&gt;</code> of its own. A column set ends on its page: it closes before the page's foot and opens again after the next page's head. [3.11.3. Milestone
Elements]</a:documentation>
         <empty/>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-cb-cb-set-constraint-rule-24">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:cb">
               <sch:let name="open" value="preceding::tei:cb[@type][1]/@type = 'start'"/>
               <sch:report test="@type = 'start' and not(following::tei:cb[@type][1]/@type = 'end')">[S-CBS]
                  A column set without its end (cb type="end").</sch:report>
               <sch:report test="not(@type = 'start') and not($open)">[S-CBS] A column break
                  outside a column set (cb type="start" … cb type="end").</sch:report>
               <sch:report role="warning"
                           test="not(@type) and $open and not(preceding::text()[normalize-space()][1] &gt;&gt; preceding::tei:cb[@type][1])">[S-CBF]
                  The first column needs no cb of its own.</sch:report>
            </sch:rule>
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:pb | tei:fw[@place = 'bottom']">
               <sch:report test="preceding::tei:cb[@type][1]/@type = 'start'">[S-CBP] A column set
                  ends on its page: cb type="end" before the page's foot, cb type="start" after the
                  next page's head.</sch:report>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attributes"/>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">characterizes the element in some sense, using any convenient classification scheme or typology.</a:documentation>
               <choice>
                  <value>start</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                  <value>end</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_author">
      <element name="author">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(author) The author of the edited text, normally a structured <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;persName&gt;</code>. [3.12.2.2. Titles, Authors, and Editors 2.2.1. The Title Statement]</a:documentation>
         <oneOrMore>
            <choice>
               <text/>
               <ref name="tei_persName"/>
            </choice>
         </oneOrMore>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.datable.attributes"/>
         <ref name="tei_att.naming.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_respStmt">
      <element name="respStmt">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(statement of responsibility) supplies a statement of responsibility for the intellectual content of a text, edition, recording, or series, where the specialized elements for authors, editors, etc. do not suffice or do not apply. May also be used to encode information about individuals or organizations which have played a role in the production or distribution of a bibliographic work. [3.12.2.2. Titles, Authors, and Editors 2.2.1. The Title Statement 2.2.2. The Edition Statement 2.2.5. The Series Statement]</a:documentation>
         <group>
            <choice>
               <group>
                  <oneOrMore>
                     <ref name="tei_resp"/>
                  </oneOrMore>
                  <oneOrMore>
                     <ref name="tei_model.nameLike.agent"/>
                  </oneOrMore>
               </group>
               <group>
                  <oneOrMore>
                     <ref name="tei_model.nameLike.agent"/>
                  </oneOrMore>
                  <oneOrMore>
                     <ref name="tei_resp"/>
                  </oneOrMore>
               </group>
            </choice>
            <zeroOrMore>
               <ref name="tei_note"/>
            </zeroOrMore>
         </group>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.canonical.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_resp">
      <element name="resp">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(responsibility) contains a phrase describing the nature of a person's intellectual responsibility, or an organization's role in the production or distribution of a work. [3.12.2.2. Titles, Authors, and Editors 2.2.1. The Title Statement 2.2.2. The Edition Statement 2.2.5. The Series Statement]</a:documentation>
         <ref name="tei_macro.phraseSeq.limited"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.canonical.attributes"/>
         <ref name="tei_att.datable.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_title">
      <element name="title">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(title) A title of the edited text. [3.12.2.2. Titles, Authors, and Editors 2.2.1. The Title Statement 2.2.5. The Series Statement]</a:documentation>
         <ref name="tei_macro.phraseSeq"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.canonical.attributes"/>
         <ref name="tei_att.datable.attributes"/>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">classifies the title according to some convenient typology.
Suggested values include: 1] main; 2] sub</a:documentation>
               <choice>
                  <value>main</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">main title</a:documentation>
                  <value>sub</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">subtitle</a:documentation>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <optional>
            <attribute name="level">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">indicates the bibliographic level for a title, that is, whether it identifies an article, book, journal, series, or unpublished material.</a:documentation>
               <choice>
                  <value>a</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">analytic: an article or a part</a:documentation>
                  <value>j</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a journal</a:documentation>
                  <value>m</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a monograph: in the header, the printed volume</a:documentation>
                  <value>s</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a series</a:documentation>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_publisher">
      <element name="publisher">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(publisher) provides the name of the organization responsible for the publication or distribution of a bibliographic item. [3.12.2.4. Imprint, Size of a Document, and Reprint Information 2.2.4. Publication, Distribution, Licensing, etc.]</a:documentation>
         <zeroOrMore>
            <choice>
               <ref name="tei_macro.simlerInline"/>
               <ref name="tei_name"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.canonical.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_pubPlace">
      <element name="pubPlace">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(publication place) contains the name of the place where a bibliographic item was published. [3.12.2.4. Imprint, Size of a Document, and Reprint Information]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.naming.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_bibl">
      <element name="bibl">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(bibliographic citation) A loosely structured bibliographic reference holding the identifiers of the digitised source. [3.12.1. Methods of Encoding Bibliographic References and Lists of References 2.2.7. The Source Description 16.3.2. Declarable Elements]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_idno"/>
               <ref name="tei_title"/>
               <ref name="tei_author"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.canonical.attributes"/>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">characterizes the element in some sense, using any convenient classification scheme or typology.
Suggested values include: 1] M</a:documentation>
               <choice>
                  <value>M</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">monograph</a:documentation>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_l">
      <element name="l">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(verse line) A single verse line. <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@rendition</code> records the indentation of the printed line; line/word breaks of the setting are encoded with <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lb&gt;</code>. [3.13.1. Core Tags for Verse 3.13. Passages of Verse or Drama 7.2.6. Speech Contents]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_hi"/>
               <ref name="tei_rs"/>
               <ref name="tei_choice"/>
               <ref name="tei_unclear"/>
               <ref name="tei_supplied"/>
               <ref name="tei_num"/>
               <ref name="tei_abbr"/>
               <ref name="tei_label"/>
               <ref name="tei_note"/>
               <ref name="tei_anchor"/>
               <ref name="tei_space"/>
               <ref name="tei_fw"/>
               <ref name="tei_lb"/>
               <ref name="tei_pb"/>
            </choice>
         </zeroOrMore>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-l-line-inner-space-constraint-rule-26">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:text//tei:l | tei:text//tei:head | tei:text//tei:p">
               <sch:report role="warning"
                           test="node()[1][self::text()][matches(., '^[ &#x9;]+([^\s]|$)')] or node()[last()][self::text()][matches(., '[^\s][ &#x9;]+$')]">[S-WS]
                  A space directly after &lt;<sch:name/>&gt; or before &lt;/<sch:name/>&gt;:
                  leave it out.</sch:report>
            </sch:rule>
         </pattern>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-l-abstractModel-structure-l-in-l-constraint-rule-27">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:l">
               <sch:report test="ancestor::tei:l[not(.//tei:note//tei:l[. = current()])]">Abstract model violation: Metrical lines (&lt;l&gt; elements) may not contain &lt;l&gt; or &lt;lg&gt; elements.</sch:report>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attribute.xmlid"/>
         <ref name="tei_att.global.attribute.xmllang"/>
         <ref name="tei_att.global.facs.attribute.facs"/>
         <ref name="tei_att.global.linking.attribute.corresp"/>
         <ref name="tei_att.global.linking.attribute.sameAs"/>
         <ref name="tei_att.global.rendition.attribute.rendition"/>
         <ref name="tei_att.global.responsibility.attribute.cert"/>
         <ref name="tei_att.global.responsibility.attribute.resp"/>
         <optional>
            <attribute name="n">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(number) gives a number (or other label) for an element, which is not necessarily unique within the document.</a:documentation>
               <data type="string"/>
            </attribute>
         </optional>
         <optional>
            <attribute name="next">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(next) The next part of a verse line the print splits, e.g. by a heading or a page; <code xmlns="http://www.w3.org/1999/xhtml"
                        xmlns:rng="http://relaxng.org/ns/structure/1.0">@prev</code> points back. So also on <code xmlns="http://www.w3.org/1999/xhtml"
                        xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;div&gt;</code> and <code xmlns="http://www.w3.org/1999/xhtml"
                        xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;head&gt;</code>.</a:documentation>
               <data type="anyURI">
                  <param name="pattern">\S+</param>
               </data>
            </attribute>
         </optional>
         <optional>
            <attribute name="prev">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(previous) points to the previous element of a virtual aggregate of which the current element is part.</a:documentation>
               <data type="anyURI">
                  <param name="pattern">\S+</param>
               </data>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_lg">
      <element name="lg">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(line group) A group of verse lines. The <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lg&gt;</code> that holds a whole poem is <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@type</code>=poem, one per poem; an <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lg&gt;</code> inside an <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lg&gt;</code> (a stanza, which holds <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;l&gt;</code>, or a section, which holds <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lg&gt;</code>) has no <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@type</code>: the nesting says what it is. A voice part on a music page that carries the poem's text keeps poem; an underlay copy stays untyped. [3.13.1. Core Tags for Verse 3.13. Passages of Verse or Drama 7.2.6. Speech Contents]</a:documentation>
         <oneOrMore>
            <choice>
               <ref name="tei_l"/>
               <ref name="tei_lg"/>
               <ref name="tei_head"/>
               <ref name="tei_label"/>
               <ref name="tei_p"/>
               <ref name="tei_closer"/>
               <ref name="tei_note"/>
               <ref name="tei_fw"/>
               <ref name="tei_figure"/>
               <ref name="tei_anchor"/>
               <ref name="tei_cb"/>
               <ref name="tei_milestone"/>
               <ref name="tei_lb"/>
               <ref name="tei_pb"/>
            </choice>
         </oneOrMore>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-lg-lg-type-constraint-rule-28">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:lg[@type]">
               <sch:report role="warning" test="ancestor::tei:lg">[S-LGN] An lg inside an lg has
                  no @type (here "<sch:value-of select="@type"/>"): a stanza or a section is told by
                  its nesting.</sch:report>
               <sch:report role="warning" test="not(ancestor::tei:lg) and @type ne 'poem'">[S-LGV]
                  @type="<sch:value-of select="@type"/>": the lg that holds a whole poem is
                  type="poem". A stanza standing outside its poem's lg needs that lg round it.</sch:report>
            </sch:rule>
         </pattern>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-lg-atleast1oflggapl-constraint-rule-29">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:lg">
               <sch:assert test="count(descendant::tei:lg|descendant::tei:l|descendant::tei:gap) &gt; 0">An &lt;lg&gt; element must contain at least one child &lt;l&gt;, &lt;lg&gt;, or &lt;gap&gt; element.</sch:assert>
            </sch:rule>
         </pattern>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-lg-abstractModel-structure-lg-in-l-constraint-rule-30">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:lg">
               <sch:report test="ancestor::tei:l[not(.//tei:note//tei:lg[. = current()])]">Abstract model violation: Lines may not contain line groups.</sch:report>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attribute.xmlid"/>
         <ref name="tei_att.global.attribute.xmllang"/>
         <ref name="tei_att.global.facs.attribute.facs"/>
         <ref name="tei_att.global.linking.attribute.corresp"/>
         <ref name="tei_att.global.linking.attribute.sameAs"/>
         <ref name="tei_att.global.linking.attribute.next"/>
         <ref name="tei_att.global.linking.attribute.prev"/>
         <ref name="tei_att.global.rendition.attribute.rendition"/>
         <ref name="tei_att.global.responsibility.attribute.cert"/>
         <ref name="tei_att.global.responsibility.attribute.resp"/>
         <optional>
            <attribute name="n">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(number) gives a number (or other label) for an element, which is not necessarily unique within the document.</a:documentation>
               <data type="string"/>
            </attribute>
         </optional>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">characterizes the element in some sense, using any convenient classification scheme or typology.
Suggested values include: 1] poem; 2] stanza</a:documentation>
               <choice>
                  <value>poem</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">the lg that holds a whole poem</a:documentation>
                  <value>stanza</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">deprecated: a stanza in a stanza-div, outside its poem's lg (B, D); to be restructured into an untyped lg inside the poem's lg</a:documentation>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_teiHeader">
      <element name="teiHeader">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(TEI header) Document metadata: a <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;fileDesc&gt;</code>, an optional <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;encodingDesc&gt;</code> and an optional (possibly empty) <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;profileDesc&gt;</code>. [2.1.1. The TEI Header and Its Components 16.1. Varieties of Composite Text]</a:documentation>
         <group>
            <ref name="tei_fileDesc"/>
            <optional>
               <ref name="tei_encodingDesc"/>
            </optional>
            <optional>
               <ref name="tei_profileDesc"/>
            </optional>
         </group>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_fileDesc">
      <element name="fileDesc">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(file description) The bibliographic description of the file. [2.2. The File Description 2.1.1. The TEI Header and Its Components]</a:documentation>
         <group>
            <ref name="tei_titleStmt"/>
            <optional>
               <ref name="tei_editionStmt"/>
            </optional>
            <ref name="tei_publicationStmt"/>
            <ref name="tei_sourceDesc"/>
         </group>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_titleStmt">
      <element name="titleStmt">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(title statement) One or more <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;title&gt;</code>s, optional <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;author&gt;</code>s and statements of responsibility. [2.2.1. The Title Statement 2.2. The File Description]</a:documentation>
         <group>
            <oneOrMore>
               <ref name="tei_title"/>
            </oneOrMore>
            <zeroOrMore>
               <ref name="tei_author"/>
            </zeroOrMore>
            <zeroOrMore>
               <ref name="tei_respStmt"/>
            </zeroOrMore>
         </group>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_editionStmt">
      <element name="editionStmt">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(edition statement) groups information relating to one edition of a text. [2.2.2. The Edition Statement 2.2. The File Description]</a:documentation>
         <ref name="tei_edition"/>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_edition">
      <element name="edition">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(edition) describes the particularities of one edition of a text. [2.2.2. The Edition Statement]</a:documentation>
         <ref name="tei_macro.phraseSeq"/>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_extent">
      <element name="extent">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(extent) describes the approximate size of a text stored on some carrier medium or of some other object, digital or non-digital, specified in any convenient units. [2.2.3. Type and Extent of File 2.2. The File Description 3.12.2.4. Imprint, Size of a Document, and Reprint Information 11.7.1. Object Description]</a:documentation>
         <ref name="tei_macro.phraseSeq"/>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_publicationStmt">
      <element name="publicationStmt">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(publication statement) The publication statement: one or more paragraphs, or structured publisher/place/date. [2.2.4. Publication, Distribution, Licensing, etc. 2.2. The File Description]</a:documentation>
         <oneOrMore>
            <choice>
               <ref name="tei_p"/>
               <ref name="tei_publisher"/>
               <ref name="tei_pubPlace"/>
               <ref name="tei_date"/>
            </choice>
         </oneOrMore>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_idno">
      <element name="idno">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(identifier) An identifier or URI for the source. [14.3.1. Basic Principles 2.2.4. Publication, Distribution, Licensing, etc. 2.2.5. The Series Statement 3.12.2.4. Imprint, Size of a Document, and Reprint Information]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_idno"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.datable.attributes"/>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">categorizes the identifier, for example as an ISBN, Social Security number, etc.
Suggested values include: 1] URLIIIF; 2] URLImages; 3] URLCatalogue; 4] DOI; 5] Transkribus; 6] shelfmark</a:documentation>
               <choice>
                  <value>URLIIIF</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">URL of the IIIF presentation manifest; its root is also the root of the page images named by <code xmlns="http://www.w3.org/1999/xhtml"
                           xmlns:rng="http://relaxng.org/ns/structure/1.0">@facs</code>
                  </a:documentation>
                  <value>URLImages</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">URL of the page images</a:documentation>
                  <value>URLCatalogue</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">URL of the library catalogue record</a:documentation>
                  <value>DOI</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">DOI of the digitised copy</a:documentation>
                  <value>Transkribus</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">Transkribus document/collection identifier</a:documentation>
                  <value>shelfmark</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">library shelfmark of the printed copy</a:documentation>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_sourceDesc">
      <element name="sourceDesc">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(source description) Describes the digitised printed source: its bibliographic record (<code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;biblFull&gt;</code> from the DTA import, or a loose <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;bibl&gt;</code>) and the physical copy (<code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;msDesc&gt;</code>). [2.2.7. The Source Description]</a:documentation>
         <oneOrMore>
            <choice>
               <ref name="tei_bibl"/>
               <ref name="tei_biblFull"/>
               <ref name="tei_msDesc"/>
            </choice>
         </oneOrMore>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_biblFull">
      <element name="biblFull">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(fully-structured bibliographic citation) contains a fully-structured bibliographic citation, in which all components of the TEI file description are present. [3.12.1. Methods of Encoding Bibliographic References and Lists of References 2.2. The File Description 2.2.7. The Source Description 16.3.2. Declarable Elements]</a:documentation>
         <choice>
            <group>
               <group>
                  <ref name="tei_titleStmt"/>
                  <optional>
                     <ref name="tei_editionStmt"/>
                  </optional>
                  <optional>
                     <ref name="tei_extent"/>
                  </optional>
                  <ref name="tei_publicationStmt"/>
               </group>
               <zeroOrMore>
                  <ref name="tei_sourceDesc"/>
               </zeroOrMore>
            </group>
            <group>
               <ref name="tei_fileDesc"/>
               <ref name="tei_profileDesc"/>
            </group>
         </choice>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.canonical.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_encodingDesc">
      <element name="encodingDesc">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(encoding description) documents the relationship between an electronic text and the source or sources from which it was derived. [2.3. The Encoding Description 2.1.1. The TEI Header and Its Components]</a:documentation>
         <oneOrMore>
            <choice>
               <ref name="tei_model.encodingDescPart"/>
               <ref name="tei_model.pLike"/>
            </choice>
         </oneOrMore>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_editorialDecl">
      <element name="editorialDecl">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(editorial practice declaration) provides details of editorial principles and practices applied during the encoding of a text. [2.3.3. The Editorial Practices Declaration 2.3. The Encoding Description 16.3.2. Declarable Elements]</a:documentation>
         <oneOrMore>
            <choice>
               <ref name="tei_model.pLike"/>
               <ref name="tei_model.editorialDeclPart"/>
            </choice>
         </oneOrMore>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_profileDesc">
      <element name="profileDesc">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(text-profile description) Optional descriptive profile (language usage, classification). May be empty. [2.4. The Profile Description 2.1.1. The TEI Header and Its Components]</a:documentation>
         <zeroOrMore>
            <choice>
               <ref name="tei_langUsage"/>
               <ref name="tei_textClass"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_langUsage">
      <element name="langUsage">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(language usage) describes the languages, sublanguages, registers, dialects, etc. represented within a text. [2.4.2. Language Usage 2.4. The Profile Description 16.3.2. Declarable Elements]</a:documentation>
         <choice>
            <oneOrMore>
               <ref name="tei_model.pLike"/>
            </oneOrMore>
            <oneOrMore>
               <ref name="tei_language"/>
            </oneOrMore>
         </choice>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_language">
      <element name="language">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(language) characterizes a single language or sublanguage used within a text. [2.4.2. Language Usage]</a:documentation>
         <ref name="tei_macro.phraseSeq.limited"/>
         <ref name="tei_att.global.attributes"/>
         <attribute name="ident">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(identifier) Supplies a language code constructed as defined in <a xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  href="https://tools.ietf.org/html/bcp47">BCP 47</a> which is used to identify the language documented by this element, and which may be referenced by the global <code xmlns="http://www.w3.org/1999/xhtml"
                     xmlns:rng="http://relaxng.org/ns/structure/1.0">@xml:lang</code> attribute.</a:documentation>
            <choice>
               <data type="language"/>
               <choice>
                  <value/>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
               </choice>
            </choice>
         </attribute>
         <empty/>
      </element>
   </define>
   <define name="tei_textClass">
      <element name="textClass">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(text classification) groups information which describes the nature or topic of a text in terms of a standard classification scheme, thesaurus, etc. [2.4.3. The Text Classification]</a:documentation>
         <zeroOrMore>
            <choice>
               <ref name="tei_classCode"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_classCode">
      <element name="classCode">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(classification code) contains the classification code used for this text in some standard classification system. [2.4.3. The Text Classification]</a:documentation>
         <ref name="tei_macro.phraseSeq.limited"/>
         <ref name="tei_att.global.attributes"/>
         <attribute name="scheme">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">identifies the classification system in use, as defined by, e.g. a <code xmlns="http://www.w3.org/1999/xhtml"
                     xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;taxonomy&gt;</code> element, or some other resource.</a:documentation>
            <data type="anyURI">
               <param name="pattern">\S+</param>
            </data>
         </attribute>
         <empty/>
      </element>
   </define>
   <define name="tei_TEI">
      <element name="TEI">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(TEI document) The root element of a Simler edition document: one <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;teiHeader&gt;</code> followed by one <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;text&gt;</code>. <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@type</code> is required. [4. Default Text Structure 16.1. Varieties of Composite Text]</a:documentation>
         <group>
            <ref name="tei_teiHeader"/>
            <ref name="tei_text"/>
         </group>
         <ref name="tei_att.global.attributes"/>
         <attribute name="type">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">characterizes the element in some sense, using any convenient classification scheme or typology.</a:documentation>
            <choice>
               <value>simler-framework</value>
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">Simler edition document</a:documentation>
            </choice>
         </attribute>
         <empty/>
      </element>
   </define>
   <define name="tei_text">
      <element name="text">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(text) The transcribed text: an optional <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;front&gt;</code> and a <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;body&gt;</code>. A front-matter volume may carry <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;front&gt;</code> without a <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;body&gt;</code>. [4. Default Text Structure 16.1. Varieties of Composite Text]</a:documentation>
         <group>
            <optional>
               <ref name="tei_front"/>
            </optional>
            <optional>
               <ref name="tei_body"/>
            </optional>
         </group>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_body">
      <element name="body">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(text body) The body of the document, holding the page/line stream and the hierarchy of structural divisions. A document not yet transcribed holds a single empty <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;p&gt;</code>. [4. Default Text Structure]</a:documentation>
         <oneOrMore>
            <choice>
               <ref name="tei_div"/>
               <ref name="tei_lg"/>
               <ref name="tei_l"/>
               <ref name="tei_p"/>
               <ref name="tei_head"/>
               <ref name="tei_pb"/>
               <ref name="tei_lb"/>
               <ref name="tei_milestone"/>
               <ref name="tei_fw"/>
            </choice>
         </oneOrMore>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_div">
      <element name="div">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(text division) A structural division — a book, a group of poems, or an individual poem. <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@type</code> classifies the division where the DTA base format has a value for it (poem, music, dedication, …); a group of poems or a voice part has no type. <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@n</code> records its level/running number. [4.1. Divisions of the Body]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_div"/>
               <ref name="tei_head"/>
               <ref name="tei_lg"/>
               <ref name="tei_l"/>
               <ref name="tei_p"/>
               <ref name="tei_list"/>
               <ref name="tei_label"/>
               <ref name="tei_closer"/>
               <ref name="tei_epigraph"/>
               <ref name="tei_figure"/>
               <ref name="tei_titlePage"/>
               <ref name="tei_note"/>
               <ref name="tei_fw"/>
               <ref name="tei_cb"/>
               <ref name="tei_anchor"/>
               <ref name="tei_milestone"/>
               <ref name="tei_lb"/>
               <ref name="tei_pb"/>
               <ref name="tei_hi"/>
               <ref name="tei_rs"/>
               <ref name="tei_choice"/>
               <ref name="tei_unclear"/>
               <ref name="tei_supplied"/>
               <ref name="tei_num"/>
            </choice>
         </zeroOrMore>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-div-div-type-constraint-rule-31">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:div[@type = 'poem-div']">
               <sch:report role="warning" test="true()">[S-DIVT] div/@type="poem-div" is not used:
                  leave the type out (a group or a voice part needs none; a single poem is
                  type="poem").</sch:report>
            </sch:rule>
         </pattern>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-div-abstractModel-structure-div-in-l-constraint-rule-32">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:l//tei:div">
               <sch:assert test="ancestor::tei:floatingText">
          Abstract model violation: Metrical lines (&lt;l&gt; elements) may not contain higher-level structural elements such as &lt;div&gt;, unless &lt;div&gt; is a descendant of &lt;floatingText&gt;.
        </sch:assert>
            </sch:rule>
         </pattern>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-div-abstractModel-structure-div-in-ab-or-p-constraint-rule-33">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      context="tei:div">
               <sch:report test="(ancestor::tei:p or ancestor::tei:ab) and not(ancestor::tei:floatingText)">
          Abstract model violation: &lt;p&gt; and &lt;ab&gt; may not contain higher-level structural elements such as &lt;div&gt;, unless &lt;div&gt; is a descendant of &lt;floatingText&gt;.
        </sch:report>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.placement.attributes"/>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">characterizes the element in some sense, using any convenient classification scheme or typology.
Suggested values include: 1] poem; 2] stanza-div; 3] dedication; 4] frontispiece; 5] letter; 6] preface; 7] music</a:documentation>
               <choice>
                  <value>poem</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">an individual poem</a:documentation>
                  <value>stanza-div</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a stanza of a strophic poem</a:documentation>
                  <value>dedication</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a dedication</a:documentation>
                  <value>frontispiece</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a frontispiece</a:documentation>
                  <value>letter</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a letter</a:documentation>
                  <value>preface</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a preface</a:documentation>
                  <value>music</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">notated music (Noten)</a:documentation>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_dateline">
      <element name="dateline">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(dateline) contains a brief description of the place, date, time, etc. of production of a letter, newspaper story, or other work, prefixed or suffixed to it as a kind of heading or trailer. [4.2.2. Openers and Closers]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_epigraph">
      <element name="epigraph">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(epigraph) contains a quotation, anonymous or attributed, appearing at the start or end of a section or on a title page. [4.2.3. Arguments, Epigraphs, and Postscripts 4.2. Elements Common to All Divisions 4.6. Title Pages]</a:documentation>
         <zeroOrMore>
            <choice>
               <ref name="tei_model.common"/>
               <ref name="tei_model.global"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_closer">
      <element name="closer">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(closer) The closing matter of a division (e.g. a dedication) or of a poem, inside its <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;lg&gt;</code> as in the DTA base format: salutation, dateline and signature. [4.2.2. Openers and Closers 4.2. Elements Common to All Divisions]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_salute"/>
               <ref name="tei_dateline"/>
               <ref name="tei_signed"/>
               <ref name="tei_rs"/>
               <ref name="tei_hi"/>
               <ref name="tei_lb"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_salute">
      <element name="salute">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(salutation) contains a salutation or greeting prefixed to a foreword, dedicatory epistle, or other division of a text, or the salutation in the closing of a letter, preface, etc. [4.2.2. Openers and Closers]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_signed">
      <element name="signed">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(signature) contains the closing salutation, etc., appended to a foreword, dedicatory epistle, or other division of a text. [4.2.2. Openers and Closers]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_titlePage">
      <element name="titlePage">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(title page) A title page: in <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;front&gt;</code>, or in the <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;div&gt;</code> of a part of the book that has its own title page. [4.6. Title Pages]</a:documentation>
         <zeroOrMore>
            <choice>
               <ref name="tei_docTitle"/>
               <ref name="tei_titlePart"/>
               <ref name="tei_docAuthor"/>
               <ref name="tei_docImprint"/>
               <ref name="tei_docDate"/>
               <ref name="tei_docEdition"/>
               <ref name="tei_figure"/>
               <ref name="tei_label"/>
               <ref name="tei_milestone"/>
               <ref name="tei_lb"/>
               <ref name="tei_pb"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">classifies the title page according to any convenient typology.
Suggested values include: 1] main</a:documentation>
               <choice>
                  <value>main</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">the main title page</a:documentation>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_docTitle">
      <element name="docTitle">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(document title) contains the title of a document, including all its constituents, as given on a title page. [4.6. Title Pages]</a:documentation>
         <zeroOrMore>
            <choice>
               <ref name="tei_titlePart"/>
               <ref name="tei_lb"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.canonical.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_titlePart">
      <element name="titlePart">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(title part) contains a subsection or division of the title of a work, as indicated on a title page. [4.6. Title Pages]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_hi"/>
               <ref name="tei_lb"/>
               <ref name="tei_list"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <optional>
            <attribute xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
                       name="type"
                       a:defaultValue="main">
               <a:documentation>(type) specifies the role of this subdivision of the title.
Suggested values include: 1] main; 2] desc</a:documentation>
               <choice>
                  <value>main</value>
                  <a:documentation/>
                  <value>desc</value>
                  <a:documentation/>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_docAuthor">
      <element name="docAuthor">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(document author) contains the name of the author of the document, as given on the title page (often but not always contained in a byline). [4.6. Title Pages]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.canonical.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_docEdition">
      <element name="docEdition">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(document edition) contains an edition statement as presented on a title page of a document. [4.6. Title Pages]</a:documentation>
         <ref name="tei_macro.paraContent"/>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_docImprint">
      <element name="docImprint">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(document imprint) contains the imprint statement (place and date of publication, publisher name), as given (usually) at the foot of a title page. [4.6. Title Pages]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_hi"/>
               <ref name="tei_pubPlace"/>
               <ref name="tei_publisher"/>
               <ref name="tei_docDate"/>
               <ref name="tei_lb"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_docDate">
      <element name="docDate">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(document date) contains the date of a document, as given on a title page or in a dateline. [4.6. Title Pages]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.datable.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_front">
      <element name="front">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(front matter) Front matter: title page(s) and prefatory divisions (dedication, frontispiece). [4.6. Title Pages 4. Default Text Structure]</a:documentation>
         <zeroOrMore>
            <choice>
               <ref name="tei_titlePage"/>
               <ref name="tei_div"/>
               <ref name="tei_figure"/>
               <ref name="tei_milestone"/>
               <ref name="tei_lb"/>
               <ref name="tei_pb"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_model.persNamePart">
      <choice>
         <ref name="tei_surname"/>
         <ref name="tei_forename"/>
      </choice>
   </define>
   <define name="tei_model.persNamePart_alternation">
      <choice>
         <ref name="tei_surname"/>
         <ref name="tei_forename"/>
      </choice>
   </define>
   <define name="tei_model.persNamePart_sequence">
      <ref name="tei_surname"/>
      <ref name="tei_forename"/>
   </define>
   <define name="tei_model.persNamePart_sequenceOptional">
      <optional>
         <ref name="tei_surname"/>
      </optional>
      <optional>
         <ref name="tei_forename"/>
      </optional>
   </define>
   <define name="tei_model.persNamePart_sequenceOptionalRepeatable">
      <zeroOrMore>
         <ref name="tei_surname"/>
      </zeroOrMore>
      <zeroOrMore>
         <ref name="tei_forename"/>
      </zeroOrMore>
   </define>
   <define name="tei_model.persNamePart_sequenceRepeatable">
      <oneOrMore>
         <ref name="tei_surname"/>
      </oneOrMore>
      <oneOrMore>
         <ref name="tei_forename"/>
      </oneOrMore>
   </define>
   <define name="tei_persName">
      <element name="persName">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(personal name) A personal name; <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@ref</code> links to an external authority record (GND). [14.2.1. Personal Names]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_surname"/>
               <ref name="tei_forename"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.datable.attributes"/>
         <ref name="tei_att.editLike.attributes"/>
         <ref name="tei_att.personal.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_surname">
      <element name="surname">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(surname) contains a family (inherited) name, as opposed to a given, baptismal, or nick name. [14.2.1. Personal Names]</a:documentation>
         <ref name="tei_macro.phraseSeq"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.personal.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_forename">
      <element name="forename">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(forename) contains a forename, given or baptismal name. [14.2.1. Personal Names]</a:documentation>
         <ref name="tei_macro.phraseSeq"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.personal.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_msDesc">
      <element name="msDesc">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(manuscript description) contains a description of a single identifiable manuscript or other text-bearing object such as an early printed book. [11.1. Overview]</a:documentation>
         <group>
            <ref name="tei_msIdentifier"/>
            <zeroOrMore>
               <ref name="tei_model.headLike"/>
            </zeroOrMore>
            <choice>
               <oneOrMore>
                  <ref name="tei_model.pLike"/>
               </oneOrMore>
               <zeroOrMore>
                  <choice>
                     <ref name="tei_physDesc"/>
                  </choice>
               </zeroOrMore>
            </choice>
         </group>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-msDesc-one_ms_singleton_max-constraint-rule-34">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      xmlns:xi="http://www.w3.org/2001/XInclude"
                      context="tei:msContents|tei:physDesc|tei:history|tei:additional">
               <sch:let name="gi" value="name(.)"/>
               <sch:report test="preceding-sibling::*[ name(.) eq $gi ]                           and                           not( following-sibling::*[ name(.) eq $gi ] )">
          Only one &lt;<sch:name/>&gt; is allowed as a child of &lt;<sch:value-of select="name(..)"/>&gt;.
        </sch:report>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_msIdentifier">
      <element name="msIdentifier">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(manuscript identifier) contains the information required to identify the manuscript or similar object being described. [11.4. The Manuscript Identifier]</a:documentation>
         <group>
            <group>
               <optional>
                  <ref name="tei_repository"/>
               </optional>
               <zeroOrMore>
                  <ref name="tei_idno"/>
               </zeroOrMore>
            </group>
            <zeroOrMore>
               <empty/>
            </zeroOrMore>
         </group>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-msIdentifier-msId_minimal-constraint-rule-35">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      xmlns:xi="http://www.w3.org/2001/XInclude"
                      context="tei:msIdentifier">
               <sch:report test="not( parent::tei:msPart )                           and                           ( child::*[1]/self::idno  or  child::*[1]/self::altIdentifier  or  normalize-space(.) eq '')">An &lt;msIdentifier&gt; must contain either a &lt;repository&gt; or &lt;location&gt;.</sch:report>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_repository">
      <element name="repository">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(repository) contains the name of a repository within which manuscripts or other objects are stored, possibly forming part of an institution. [11.4. The Manuscript Identifier]</a:documentation>
         <ref name="tei_macro.phraseSeq.limited"/>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.naming.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_physDesc">
      <element name="physDesc">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(physical description) contains a full physical description of a manuscript, manuscript part, or other object optionally subdivided using more specialized elements from the model.physDescPart class. [11.7. Physical Description]</a:documentation>
         <group>
            <zeroOrMore>
               <ref name="tei_model.pLike"/>
            </zeroOrMore>
            <optional>
               <ref name="tei_typeDesc"/>
            </optional>
         </group>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_typeDesc">
      <element name="typeDesc">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(typeface description) contains a description of the typefaces or other aspects of the printing of an incunable or other printed source. [11.7.2.1. Writing]</a:documentation>
         <choice>
            <oneOrMore>
               <ref name="tei_model.pLike"/>
            </oneOrMore>
            <empty/>
         </choice>
         <ref name="tei_att.global.attributes"/>
         <empty/>
      </element>
   </define>
   <define name="tei_att.global.facs.attributes">
      <ref name="tei_att.global.facs.attribute.facs"/>
   </define>
   <define name="tei_att.global.facs.attribute.facs">
      <optional>
         <attribute name="facs">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(facsimile) points to one or more images, portions of an image, or surfaces which correspond to the current element.</a:documentation>
            <list>
               <oneOrMore>
                  <data type="anyURI">
                     <param name="pattern">\S+</param>
                  </data>
               </oneOrMore>
            </list>
         </attribute>
      </optional>
   </define>
   <define name="tei_fw">
      <element name="fw">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(forme work) Forme work — running material outside the text block (page numbers, signatures, catchwords, running headers). <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@type</code> classifies it, <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@place</code> locates it. [12.6. Headers, Footers, and Similar Matter]</a:documentation>
         <zeroOrMore>
            <choice>
               <text/>
               <ref name="tei_hi"/>
               <ref name="tei_num"/>
               <ref name="tei_choice"/>
               <ref name="tei_unclear"/>
               <ref name="tei_supplied"/>
               <ref name="tei_note"/>
               <ref name="tei_head"/>
               <ref name="tei_anchor"/>
               <ref name="tei_lb"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <optional>
            <attribute name="place">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">specifies where this item is placed.
Suggested values include: 1] top; 2] bottom</a:documentation>
               <list>
                  <oneOrMore>
                     <choice>
                        <value>top</value>
                        <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                        <value>bottom</value>
                        <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                        <data type="token">
                           <param name="pattern">[^\p{C}\p{Z}]+</param>
                        </data>
                     </choice>
                  </oneOrMore>
               </list>
            </attribute>
         </optional>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">classifies the material encoded according to some useful typology.
Suggested values include: 1] pageNum; 2] catch; 3] sig; 4] header</a:documentation>
               <choice>
                  <value>pageNum</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a printed page number</a:documentation>
                  <value>catch</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a catchword</a:documentation>
                  <value>sig</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a printer's signature</a:documentation>
                  <value>header</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">a running header</a:documentation>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_space">
      <element name="space">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(space) A significant blank space in the source. [12.4.1. Space]</a:documentation>
         <empty/>
         <ref name="tei_att.global.attribute.xmlid"/>
         <ref name="tei_att.global.attribute.n"/>
         <ref name="tei_att.global.attribute.xmllang"/>
         <ref name="tei_att.global.facs.attribute.facs"/>
         <ref name="tei_att.global.linking.attribute.corresp"/>
         <ref name="tei_att.global.linking.attribute.sameAs"/>
         <ref name="tei_att.global.linking.attribute.next"/>
         <ref name="tei_att.global.linking.attribute.prev"/>
         <ref name="tei_att.global.rendition.attribute.rendition"/>
         <ref name="tei_att.global.responsibility.attribute.cert"/>
         <ref name="tei_att.dimensions.attributes"/>
         <ref name="tei_att.typed.attributes"/>
         <optional>
            <attribute name="resp">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(responsible party) (responsible party) indicates the individual responsible for identifying and measuring the space.</a:documentation>
               <list>
                  <oneOrMore>
                     <data type="anyURI">
                        <param name="pattern">\S+</param>
                     </data>
                  </oneOrMore>
               </list>
            </attribute>
         </optional>
         <optional>
            <attribute name="dim">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(dimension) indicates whether the space is horizontal or vertical.</a:documentation>
               <choice>
                  <value>horizontal</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">the space is horizontal.</a:documentation>
                  <value>vertical</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">the space is vertical.</a:documentation>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_supplied">
      <element name="supplied">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(supplied) Text supplied by the editors where the source is missing or illegible. <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@cert</code> may record the confidence of the supplement. [12.3.3.1. Damage, Illegibility, and Supplied Text]</a:documentation>
         <ref name="tei_macro.simlerInline"/>
         <ref name="tei_att.global.attribute.xmlid"/>
         <ref name="tei_att.global.attribute.n"/>
         <ref name="tei_att.global.attribute.xmllang"/>
         <ref name="tei_att.global.facs.attribute.facs"/>
         <ref name="tei_att.global.linking.attribute.corresp"/>
         <ref name="tei_att.global.linking.attribute.sameAs"/>
         <ref name="tei_att.global.linking.attribute.next"/>
         <ref name="tei_att.global.linking.attribute.prev"/>
         <ref name="tei_att.global.rendition.attribute.rendition"/>
         <ref name="tei_att.global.responsibility.attribute.resp"/>
         <ref name="tei_att.dimensions.attributes"/>
         <ref name="tei_att.editLike.attributes"/>
         <optional>
            <attribute name="cert">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(certainty) signifies the degree of certainty associated with the intervention or interpretation.
Suggested values include: 1] high; 2] low</a:documentation>
               <choice>
                  <value>high</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                  <value>low</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                  <choice>
                     <data type="double">
                        <param name="minInclusive">0</param>
                        <param name="maxInclusive">1</param>
                     </data>
                     <choice>
                        <value>high</value>
                        <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                        <value>medium</value>
                        <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                        <value>low</value>
                        <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                        <value>unknown</value>
                        <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                     </choice>
                  </choice>
               </choice>
            </attribute>
         </optional>
         <optional>
            <attribute name="reason">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">one or more words indicating why the text has had to be supplied, e.g. overbinding, faded-ink, lost-folio, omitted-in-original.</a:documentation>
               <list>
                  <oneOrMore>
                     <data type="token">
                        <param name="pattern">[^\p{C}\p{Z}]+</param>
                     </data>
                  </oneOrMore>
               </list>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_figure">
      <element name="figure">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(figure) A figure (woodcut, frontispiece engraving, decorative element) or notated music, optionally with a heading and descriptive paragraph. [15.4. Specific Elements for Graphic Images]</a:documentation>
         <zeroOrMore>
            <choice>
               <ref name="tei_head"/>
               <ref name="tei_p"/>
               <ref name="tei_lb"/>
               <ref name="tei_pb"/>
            </choice>
         </zeroOrMore>
         <ref name="tei_att.global.attributes"/>
         <ref name="tei_att.placement.attributes"/>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">characterizes the element in some sense, using any convenient classification scheme or typology.
Suggested values include: 1] notatedMusic</a:documentation>
               <choice>
                  <value>notatedMusic</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">notated music; <code xmlns="http://www.w3.org/1999/xhtml"
                           xmlns:rng="http://relaxng.org/ns/structure/1.0">@corresp</code> points to its encoding (MEI)</a:documentation>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <define name="tei_att.global.linking.attributes">
      <ref name="tei_att.global.linking.attribute.corresp"/>
      <ref name="tei_att.global.linking.attribute.sameAs"/>
      <ref name="tei_att.global.linking.attribute.next"/>
      <ref name="tei_att.global.linking.attribute.prev"/>
   </define>
   <define name="tei_att.global.linking.attribute.corresp">
      <optional>
         <attribute name="corresp">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(corresponds) points to elements that correspond to the current element in some way.</a:documentation>
            <list>
               <oneOrMore>
                  <data type="anyURI">
                     <param name="pattern">\S+</param>
                  </data>
               </oneOrMore>
            </list>
         </attribute>
      </optional>
   </define>
   <define name="tei_att.global.linking.attribute.sameAs">
      <optional>
         <attribute name="sameAs">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">points to an element that is the same as the current element.</a:documentation>
            <data type="anyURI">
               <param name="pattern">\S+</param>
            </data>
         </attribute>
      </optional>
   </define>
   <define name="tei_att.global.linking.attribute.next">
      <optional>
         <attribute name="next">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(next) points to the next element of a virtual aggregate of which the current element is part.</a:documentation>
            <data type="anyURI">
               <param name="pattern">\S+</param>
            </data>
         </attribute>
      </optional>
   </define>
   <define name="tei_att.global.linking.attribute.prev">
      <optional>
         <attribute name="prev">
            <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(previous) points to the previous element of a virtual aggregate of which the current element is part.</a:documentation>
            <data type="anyURI">
               <param name="pattern">\S+</param>
            </data>
         </attribute>
      </optional>
   </define>
   <define name="tei_anchor">
      <element name="anchor">
         <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">(anchor point) An anchor point delimiting a commented range (paired with a <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">&lt;note&gt;</code> via <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@targetEnd</code>). The range is keyed either by <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@xml:id</code> or by <code xmlns="http://www.w3.org/1999/xhtml"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0">@n</code> on a start/end pair. [8.4.2. Synchronization and Overlap 17.5. Correspondence and Alignment]</a:documentation>
         <empty/>
         <pattern xmlns="http://purl.oclc.org/dsdl/schematron"
                  xmlns:rng="http://relaxng.org/ns/structure/1.0"
                  id="tei_simler-anchor-anchor-note-constraint-rule-36">
            <sch:rule xmlns="http://www.tei-c.org/ns/1.0"
                      xmlns:eg="http://www.tei-c.org/ns/Examples"
                      xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                      xmlns:xi="http://www.w3.org/2001/XInclude"
                      context="tei:anchor[@xml:id]">
               <sch:let name="id" value="@xml:id"/>
               <sch:assert role="warning"
                           test="following::tei:note[replace(@targetEnd, '^#', '') = $id]">[S-AN]
                  No note comments the range this anchor starts.</sch:assert>
            </sch:rule>
         </pattern>
         <ref name="tei_att.global.attributes"/>
         <optional>
            <attribute name="type">
               <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0">characterizes the element in some sense, using any convenient classification scheme or typology.
Suggested values include: 1] commentRangeStart; 2] commentRangeEnd</a:documentation>
               <choice>
                  <value>commentRangeStart</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                  <value>commentRangeEnd</value>
                  <a:documentation xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"/>
                  <data type="token">
                     <param name="pattern">[^\p{C}\p{Z}]+</param>
                  </data>
               </choice>
            </attribute>
         </optional>
         <empty/>
      </element>
   </define>
   <start>
      <choice>
         <ref name="tei_TEI"/>
      </choice>
   </start>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:eg="http://www.tei-c.org/ns/Examples"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           prefix="tei"
           uri="http://www.tei-c.org/ns/1.0"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:eg="http://www.tei-c.org/ns/Examples"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           prefix="xs"
           uri="http://www.w3.org/2001/XMLSchema"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:eg="http://www.tei-c.org/ns/Examples"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           prefix="rng"
           uri="http://relaxng.org/ns/structure/1.0"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:eg="http://www.tei-c.org/ns/Examples"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           prefix="rna"
           uri="http://relaxng.org/ns/compatibility/annotations/1.0"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:eg="http://www.tei-c.org/ns/Examples"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           prefix="sch"
           uri="http://purl.oclc.org/dsdl/schematron"/>
   <sch:ns xmlns="http://www.tei-c.org/ns/1.0"
           xmlns:eg="http://www.tei-c.org/ns/Examples"
           xmlns:rng="http://relaxng.org/ns/structure/1.0"
           xmlns:sch="http://purl.oclc.org/dsdl/schematron"
           prefix="sch1x"
           uri="http://www.ascc.net/xml/schematron"/>
</grammar>
