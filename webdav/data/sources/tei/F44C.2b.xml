   <text>
      <body>
         <div xml:id="F44C.2b" type="poem">
            <pb facs="3855451"/>
            
            <head rendition="#c">Hochzeitliches Fru&#x364;hlings-Geſang.</head>
            <lb/>
            <p rendition="#c">Jn folgenden Melodeyen.
            <lb/>
            Selig iſt der gepreiſet. Pſalm.128.
            <lb/>
            Zu&#x366; dir von hertzen grunde. Pſalm.130.
            <lb/>
            Hertzlich thu&#x366;t mich erfrewen/ ꝛc.
            <lb/>
            Wilhelm bin ich der Telle/ ꝛc.</p>
            <lb/>
            
            <lg type="poem">
            <lg n="1">
            <l><hi rendition="#in">D</hi>Er kalte Winter endet/</l>
            <lb/>
            <l>Der Schnee verlaßt den Sitz/</l>
            <lb/>
            <l>Jm Widder-Gſtirn ſich wendet</l>
            <lb/>
            <l>Zu&#x366; vns der Sonnen Hitz:</l>
            <lb/>
            <l>Es iſt/ Gott lob/ verhanden</l>
            <lb/>
            <l>Die angena&#x364;hmeſt Zeit/</l>
            <lb/>
            <l>Erfrewlich vnſern Landen</l>
            <lb/>
            <l>Mit jhrer Luſtbarkeit.</l>
            </lg>
            <lb/>
            
            <lg n="2">
            <l><num>2</num> Dann was durch Schnee vnd Eiſe</l>
            <lb/>
            <l>Der Winter hat erſteckt/</l>
            <lb/>
            <l>Daſſelb/ zu&#x366; Gottes preiſe/</l>
            <lb/>
            <l>Der Fru&#x364;hling vns erweckt:</l>
            <lb/>
            <l>Er machet daß wir ſehen</l>
            <lb/>
            <l>Vil ſtoltzer Tulipan</l>
            <lb/>
            <l>Jn den Luſtga&#x364;rten ſtehen/</l>
            <lb/>
            <l>Auch Ko&#x364;nigs-Cron voran.</l>
            </lg>
            <lb/>
            
            <lg n="3">
            <l><num>3</num> Vil Violen/ Narciſſen/</l>
            <lb/>
            <l>Vil Gilgen/ Meyen-reiß/</l>
            <lb/>
            <l>Mit Farben auffgeriſſen</l>
            <lb/>
            <l>Ohn Mahlers hand vnd fleiß:</l>
            <lb/>
            <l>Der Blu&#x366;men Ko&#x364;niginne</l>
            <lb/>
            <l>Mit Do&#x364;rnen wol verwahrt/</l>
            <lb/>
            <l>Anreitzet deſſen Sinne</l>
            <lb/>
            <l>Der jhren Gruch erfahrt.</l>
            </lg>
            <lb/>
            
            <lg n="4">
            <l><num>4</num> Die bſchnidtnen Ra&#x364;ben rinnen</l>
            <lb/>
            <l>Vnd weynen erſtlich zwar/</l>
            <lb/>
            <l>Bald aber ſie gewinnen</l>
            <lb/>
            <l>Getro&#x364;cknet Augen gar/</l>
            <lb/>
            <l>Thu&#x366;n ſie dieſelben lupffen/</l>
            <lb/>
            <l>Vnd ſchawen friſch herumb</l>
            <lb/>
            <l>Wohin doch mo&#x364;gen hupffen</l>
            <lb/>
            <l>Jhr Schoſſe grad vnd krumb.</l>
            </lg>
            <lb/>
            
            <lg n="5">
            <l><num>5</num> Die Ba&#x364;ume ſich außbreiten</l>
            <lb/>
            <l>Mit jhren Aeſten hart/</l>
            <lb/>
            <l>Bekleidet zu&#x366; den ſeiten</l>
            <lb/>
            <l>Mit Blu&#x366;ſt an Zweygen zart/</l>
            <lb/>
            <l>Worauß Ba&#x364;rbollen ſchieſſen</l>
            <lb/>
            <l>Zu&#x366; angena&#x364;hmer Frucht/</l>
            <lb/>
            <l>Derſelben zu&#x366; genieſſen</l>
            <lb/>
            <l>Der Reich vnd Arme ſu&#x366;cht.</l>
            </lg>
            <lb/>
            
            <lg n="6">
            <l><num>6</num> Die ſcho&#x364;n gemahlten Wiſen/</l>
            <lb/>
            <l>Die zahmen Bühelein/</l>
            <lb/>
            <l>Die Berge hoch gepriſen</l>
            <lb/>
            <l>Graßreiche Weiden ſeyn:</l>
            <lb/>
            <l>Die Felder vns anlachen</l>
            <lb/>
            <l>Von wegen jhrer Saht/</l>
            <lb/>
            <l>Vil frewden ſie vrꝛſachen</l>
            <lb/>
            <l>Wann jhre Frucht geraht.</l>
            </lg>
            <lb/>
            
            <lg n="7">
            <l><num>7</num> Das leichte Volck der Lüfften/</l>
            <lb/>
            <l>Das kriechend in dem Thal/</l>
            <lb/>
            <l>Das Wilde in den Klüfften/</l>
            <lb/>
            <l>Das zahme Vieh im Stal/</l>
            <lb/>
            <l>Das ſtreiffend Heer der Fiſchen/</l>
            <lb/>
            <l>Vnd was den Athem zeücht/</l>
            <lb/>
            <l>Sich ſehnen zu&#x366; erfriſchen</l>
            <lb/>
            <l>So bald der Winter fleücht.</l>
            </lg>
            <lb/>
            
            <lg n="8">
            <l><num>8</num> Der Schwalbe kompt geflogen/</l>
            <lb/>
            <l>Der gſchnabelt Schlangen-Feind</l>
            <lb/>
            <l>Kompt vber Meer gezogen/</l>
            <lb/>
            <l>Su&#x366;cht ſein alt Na&#x364;ſt geſchwind:</l>
            <lb/>
            <l>Die Amſel pfeiffet ſcho&#x364;ne/</l>
            <lb/>
            <l>Die Lerche lobet Gott/</l>
            <lb/>
            <l>Ein lieblich/ ſu&#x364;ß Getho&#x364;ne</l>
            <lb/>
            <l>Macht Nachtigalliſch Rott.</l>
            </lg>
            <lb/>
            
            <fw place="bottom" type="catch"><num>9</num> Wir</fw>
            <lb/>
            <pb facs="3855452"/>
            
            <lg n="9">
            <l><num>9</num> Wir ſehen bey der Herde</l>
            <lb/>
            <l>Den Stiere mu&#x366;htig ſeyn/</l>
            <lb/>
            <l>Das fra&#x364;ch vnd ſtoltze Pferde</l>
            <lb/>
            <l>Springt wichelend hereyn/</l>
            <lb/>
            <l>Das Waſſer-thier vmbreiſet</l>
            <lb/>
            <l>Mit ſchwümmen manches Land/</l>
            <lb/>
            <l>Das Kriechend ſich erweiſet</l>
            <lb/>
            <l>Gantz fro&#x364;lich in dem Sand.</l>
            </lg>
            <lb/>
            
            <lg n="10">
            <l><num>10</num> Nach jhrer art ſich paren</l>
            <lb/>
            <l>Die Thiere in gemein/</l>
            <lb/>
            <l>Jm anfang aller Jahren</l>
            <lb/>
            <l>Do ſie erſchaffen ſeyn:</l>
            <lb/>
            <l>Wie ſolches etlich dichten</l>
            <lb/>
            <l>Von liebſter Fru&#x364;hlings-zeit/</l>
            <lb/>
            <l>Nach dem zu&#x366;vor auß nichten</l>
            <lb/>
            <l>Die Welt war zu&#x366;bereit.</l>
            </lg>
            <lb/>
            
            <lg n="11">
            <l><num>11</num> Do auch nach ſeinem Bilde</l>
            <lb/>
            <l>Gott ſchu&#x366;ff den erſten Man&#x303;/</l>
            <lb/>
            <l>Das Feld/ vnd alles Wilde</l>
            <lb/>
            <l>Jhm machte vnderthan/</l>
            <lb/>
            <l>Vnd diſer noch alleine</l>
            <lb/>
            <l>Seins gleichen fande nicht/</l>
            <lb/>
            <l>Von ſeinem Fleiſch vnd Beine</l>
            <lb/>
            <l>Der Herꝛ ein Weib zu&#x366;richt.</l>
            </lg>
            <lb/>
            
            <lg n="12">
            <l><num>12</num> Daſſelb er jhm zu&#x366;fu&#x364;hret/</l>
            <lb/>
            <l>Vnd beyde ſo vereint/</l>
            <lb/>
            <l>Daß Adam bald verſpüret</l>
            <lb/>
            <l>Worzu&#x366; es ſey gemeint:</l>
            <lb/>
            <l>Dahar er ſie erkennet</l>
            <lb/>
            <l>Sein Fleiſch vnd Bein zu&#x366; ſeyn/</l>
            <lb/>
            <l>Ein Ma&#x364;nnin er ſie nennet:</l>
            <lb/>
            <l>Gott ſatzt den Ehſtand eyn.</l>
            </lg>
            <lb/>
            
            <lg n="13">
            <l><num>13</num> Drumb meynen vil/ im Meyen/</l>
            <lb/>
            <l>Vnd allerna&#x364;chſt zu&#x366;vor</l>
            <lb/>
            <l>Am beſten ſey zu&#x366; freyen</l>
            <lb/>
            <l>Von der Erſchaffung har:</l>
            <lb/>
            <l>Jch aber halt/ den Frommen</l>
            <lb/>
            <l>Sey gu&#x366;t ein jede zeit</l>
            <lb/>
            <l>Den Segen zu&#x366; bekommen/</l>
            <lb/>
            <l>Durch Gottes gu&#x364;tigkeit.</l>
            </lg>
            <lb/>
            
            <lg n="14">
            <l><num>14</num> Dan&#x303;: Selig iſt gepreiſet Pſ.128.</l>
            <lb/>
            <l>Der Gott vor augen helt/</l>
            <lb/>
            <l>Sich ſeiner wa&#x364;g befleiſſet/</l>
            <lb/>
            <l>Davon auch nicht abfellt:</l>
            <lb/>
            <l>Dann du wirſt dich wol nehren</l>
            <lb/>
            <l>Mit arbeit deiner Hand/</l>
            <lb/>
            <l>Gott wird dir glück beſchehren</l>
            <lb/>
            <l>Vnd ſegnen deinen Stand.</l>
            </lg>
            <lb/>
            
            <lg n="15">
            <l><num>15</num> Dein Weib gleich einer Ra&#x364;ben</l>
            <lb/>
            <l>Jn deinem Hauß wird ſeyn/</l>
            <lb/>
            <l>Die jhre Frucht thu&#x366;t geben</l>
            <lb/>
            <l>Zu&#x366; ſeiner zeit vom Wein:</l>
            <lb/>
            <l>Dein Kinder wirſtu ſehen</l>
            <lb/>
            <l>Zu&#x366; rings vmb deinen Tiſch/</l>
            <lb/>
            <l>Nach einer reyen ſtehen</l>
            <lb/>
            <l>Gleich wie die Oelzweyg friſch.</l>
            </lg>
            <lb/>
            
            <lg n="16">
            <l><num>16</num> Das ſind die ſcho&#x364;nen Gaben</l>
            <lb/>
            <l>Die Gott den Menſchen gibt/</l>
            <lb/>
            <l>Die jhn in ehren haben/</l>
            <lb/>
            <l>Von den er wird geliebt:</l>
            <lb/>
            <l>Er wird dich benedeyen</l>
            <lb/>
            <l>Auß Sion/ vnd der Statt</l>
            <lb/>
            <l>Jeruſalem verleyen</l>
            <lb/>
            <l>Bey deinem leben gnad.</l>
            </lg>
            <lb/>
            
            <lg n="17">
            <l><num>17</num> Du wirſt auch endtlich ſehen</l>
            <lb/>
            <l>Kinds-kinder/ vnd dazu&#x366;</l>
            <lb/>
            <l>Jſraels ſachen ſtehen</l>
            <lb/>
            <l>Jn gu&#x366;tem frid vnd ru&#x366;h.</l>
            <lb/>
            <l>Diß wünſchen nun wir alle</l>
            <lb/>
            <l>Dem new-verlobten Par:</l>
            <lb/>
            <l>Dem Herꝛen wol gefalle</l>
            <lb/>
            <l>Den Wunſch zu&#x366; machen wahr!</l>
            </lg>
            </lg>
            <lb/>
            
            <fw place="bottom" type="catch">Pin-</fw>
            <lb break="no"/>
         </div>
      </body>
   </text>
