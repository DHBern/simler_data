   <text>
      <body>
         <div>
            <pb facs="3508815"/>
            <head><hi rendition="#aq"><num>II.</num></hi></head>
            <lb/>
            
            <head><num>1.</num>
            <lb/>
            Alexandriniſcher Vorwunſch/
            <lb/>
            über
            <lb/>
            wolangeſtellten und kunſtlich-
            <lb break="no"/>
            vollfu&#x364;hrten
            <lb/>
            Mejeriſchen Todtendantz.</head>
            <lb/>
            
            <l><hi rendition="#in">D</hi>Jß dreyfachgu&#x366;te Werk ſelbſelb den Meiſter ru&#x364;hmet/</l>
            <lb/>
            <l>nicht no&#x364;htig daß es werd mit fro&#x364;mdem ru&#x366;hm verblu&#x364;hmet:</l>
            <lb/>
            <l>die klu&#x366;ge Künſtlerhand; der flammend Dichtergeiſt/</l>
            <lb/>
            <l>und hohe Sa&#x364;ngerkunſt uns hier verſtummen heißt.</l>
            <lb/>
            <l>Wir wünſchen nur allein auß diſem zu erlehrnen</l>
            <lb/>
            <l>des Lebens Flüchtigkeit/ damit wir uns entfehrnen</l>
            <lb/>
            <l>von eitelm augenluſt; verwehnter ſicherheit;</l>
            <lb/>
            <l>vom gelt- und ehrengeitz; von ungerechtigkeit:</l>
            <lb/>
            <l>hingegen aber uns/ zu diſen wunderzeiten/</l>
            <lb/>
            <l>zur Wallfahrt auß der welt/ im glauben/ vorbereiten/</l>
            <lb/>
            <l>damit die Todtenpfort uns mo&#x364;g ein Eyngang ſeyn</l>
            <lb/>
            <l>ins rechtgelobte Land/ wo weder Tod noch pein!</l>
            <lb/>
            
         </div>
