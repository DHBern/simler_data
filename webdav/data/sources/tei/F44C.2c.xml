   <text>
      <body>
         <div xml:id="F44C.2c">
            <pb facs="3855453"/>
            
            Pindariſche Ode.
            <lb/>
            Auß dem 31. Cap. der Sprüchwo&#x364;rter Salomons.
            <lb/>
            
            Strophe.
            <lb/>
            <l>Selig iſt der Mann geſchetzet</l>
            <lb/>
            <l>Dem der Himmel hat beſchehrt</l>
            <lb/>
            <l>Eine Fraw die Gott verehrt/</l>
            <lb/>
            <l>Vnd hierneben jhn ergetzet.</l>
            <lb/>
            <l>Solche alles Edelgſtein</l>
            <lb/>
            <l>Vbertriffet in gemein.</l>
            <lb/>
            <l>Jhren kan jhr Mann vertrawen:</l>
            <lb/>
            <l>Dann ſie thu&#x366;t das Hauß erbawen;</l>
            <lb/>
            <l>Nahrung jhme mangelt nicht/</l>
            <lb/>
            <l>Freundtlich ſie ſich jhm erweiſet</l>
            <lb/>
            <l>Darumb man ſie billich preiſet</l>
            <lb/>
            <l>Mit Geſang vnd Lobgedicht.</l>
            <lb/>
            
            Antiſtrophe.
            <lb/>
            <l>Sie verſorget jhr Geſinde/</l>
            <lb/>
            <l>Vnd vergißt der Armen nicht/</l>
            <lb/>
            <l>Jhre Kleider ſie zu&#x366;richt</l>
            <lb/>
            <l>Wider Regen/ Schnee vnd Winde.</l>
            <lb/>
            <l>Sie iſt jhres Mannes Cron/</l>
            <lb/>
            <l>Leüchtet kla&#x364;rer alß der Mon:</l>
            <lb/>
            <l>Jhre Kinder ſie verehren</l>
            <lb/>
            <l>Vnd Er thu&#x366;t jhr Lob vermehren.</l>
            <lb/>
            <l>Falſch iſt viler freündtlichkeit/</l>
            <lb/>
            <l>Leibes-ſcho&#x364;ne thu&#x366;t vergehen/</l>
            <lb/>
            <l>Billich aber ſol beſtehen</l>
            <lb/>
            <l>Frommer Weiber Lob allzeit.</l>
            <lb/>
            
            Epodus.
            <lb/>
            <l>Wann dann/ Herꝛ Bra&#x364;utigam/ der Himmel eüch gegeben</l>
            <lb/>
            <l>Eine ſolche Braut/</l>
            <lb/>
            <l>Die auff Tugend ſchawt:</l>
            <lb/>
            <l>So werden/ billich/ jhr nicht <hi rendition="#b">hart</hi> mit jhro leben.</l>
            <lb/>
            <l>O daß jhr leben wol! O daß jhr leben lang</l>
            <lb/>
            <l>Hier auff Erden/</l>
            <lb/>
            <l>Ohn beſchwerden!</l>
            <lb/>
            <l>O daß es hier vnd dort eüch beyden wol ergang!</l>
            <lb/>
            
            J.W.S.
            <lb/>
            
         </div>
