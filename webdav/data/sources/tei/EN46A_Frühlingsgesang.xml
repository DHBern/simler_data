      <body>
         <div>
            <pb facs="17729189"/>
            j.
            <lb/>
            <hi rendition="#aq">Con: Meÿer fecit et excu:
            <lb/>
            1646</hi>
            <lb/>
            
            <head rendition="#aq">Diſcantus.</head>
            <lb/>
            <l>Luſtig werden beku&#x364;mmerte hertzen/</l>
            <lb/>
            <l>Wan&#x303; die guldine Sonnen im Mertzen</l>
            <lb/>
            <l>Mit dem Widdergeſtirne thu&#x366;t ſchertzen:</l>
            <lb/>
            <l>Da der leidige Winter vergehet/</l>
            <lb/>
            <l>Vnd der liebliche Fru&#x364;hling entſtehet/</l>
            <lb/>
            <l>Den der Zefyr mit Blu&#x366;men beſa&#x364;yet.</l>
            <lb/>
            
            <head rendition="#aq">Altus.</head>
            <lb/>
            <l>Luſtig werden beku&#x364;mmerte hertzen/</l>
            <lb/>
            <l>Wan&#x303; die guldine Sonnen im Mertzen</l>
            <lb/>
            <l>Mit dem Widdergeſtirne thu&#x366;t ſchertzen:</l>
            <lb/>
            <l>Da der leidige Winter vergehet/</l>
            <lb/>
            <l>Vnd der liebliche Fru&#x364;hling entſtehet/</l>
            <lb/>
            <l>Den der Zefyr mit Blu&#x366;men beſa&#x364;yet.</l>
            <lb/>
            
            <head rendition="#aq">Tenor.</head>
            <lb/>
            <l>Luſtig werden beku&#x364;mmerte hertzen/</l>
            <lb/>
            <l>Wan&#x303; die guldine Sonnen im Mertzen</l>
            <lb/>
            <l>Mit dem Widdergeſtirne thu&#x366;t ſchertzen:</l>
            <lb/>
            <l>Da der leidige Winter vergehet/</l>
            <lb/>
            <l>Vnd der liebliche Fru&#x364;hling entſtehet/</l>
            <lb/>
            <l>Den der Zefyr mit Blu&#x366;men beſa&#x364;yet.</l>
            <lb/>
            
            <head rendition="#aq">Baſis.</head>
            <lb/>
            <l>Luſtig werden beku&#x364;mmerte hertzen/</l>
            <lb/>
            <l>Wan&#x303; die guldine Sonnen im Mertzen/</l>
            <lb/>
            <l>Mit dem Widdergeſtirne thu&#x366;t ſchertzen:</l>
            <lb/>
            <l>Da der leidige Winter vergehet/</l>
            <lb/>
            <l>Vnd der liebliche Fru&#x364;hling entſtehet/</l>
            <lb/>
            <l>Den der Zefyr mit Blu&#x366;men beſa&#x364;yet.</l>
            <lb/>
            
            <head><num>2.</num></head>
            <lb/>
            <l>Jn den Ga&#x364;rten wir ſehen entſprieſſen</l>
            <lb/>
            <l>Tulipanen/ Violen/ Narciſſen/</l>
            <lb/>
            <l>Ohne Mahlers Hand/ ku&#x364;nſtlich/ geriſſen:</l>
            <lb/>
            <l>Wir betaſten die Ko&#x364;niges Cronen/</l>
            <lb/>
            <l>Gilgen/ Tu&#x364;rckiſche Bu&#x364;ndt/ Anemonen/</l>
            <lb/>
            <l>Keiner do&#x364;rnichten Roſen wir ſchonen.</l>
            <lb/>
            
            <head><num>3.</num></head>
            <lb/>
            <l>Wir bereiten vns Stra&#x364;uſſer vnd Meyen/</l>
            <lb/>
            <l>Vmb die Kra&#x364;ntze wir ſingen am Reyen/</l>
            <lb/>
            <l>Es erto&#x364;nen die Pfeiffen/ Schalmeyen:</l>
            <lb/>
            <l>Alles/ Alles in frewden thu&#x366;t leben/</l>
            <lb/>
            <l>Auſſert newlich geſchnittenen Reben/</l>
            <lb/>
            <l>Die den Fru&#x364;hling mit weynen anheben.</l>
            <lb/>
            
            <head><num>4.</num></head>
            <lb/>
            <l>Junge Saaten vns ſchiereſt anlachen/</l>
            <lb/>
            <l>Gute hoffnung/ auß vilen vrſachen/</l>
            <lb/>
            <l>Zu der ko&#x364;nfftigen Ernde ſie machen:</l>
            <lb/>
            <l>Alle Ba&#x364;ume den Roſen ſich gleichen/</l>
            <lb/>
            <l>Deren Scho&#x364;ne mag nichtes erꝛeichen/</l>
            <lb/>
            <l>Alles anders derſelben muß weichen.</l>
            <lb/>
            
            <head><num>5.</num></head>
            <lb/>
            <l>Alle Matten vnd Wieſen Graßreiche/</l>
            <lb/>
            <l>Alle Bu&#x364;hel vnd Berge zugleiche/</l>
            <lb/>
            <l>Werden Weiden dem nutzlichen Veiche:</l>
            <lb/>
            <l>Auff den gru&#x364;nen betaweten Awen/</l>
            <lb/>
            <l>Frewdig ſpringende Herden wir ſchawen/</l>
            <lb/>
            <l>Die zu&#x366;voren in Sta&#x364;llen geſchrawen.</l>
            <lb/>
            
            <head><num>6.</num></head>
            <lb/>
            <l>Das gefidderte Vo&#x364;lcklein der Lu&#x364;ffte/</l>
            <lb/>
            <l>Machet wider erklingen die klu&#x364;ffte/</l>
            <lb/>
            <l>Alß ob Echo denſelbigen ru&#x364;ffte:</l>
            <lb/>
            <l>An die Wolcken die Lerche ſich ſchwinget/</l>
            <lb/>
            <l>Jhrem Scho&#x364;pffer zu ehren ſie ſinget/</l>
            <lb/>
            <l>Zwitzer gſchwa&#x364;tze die Schwalbe fu&#x364;rbringet.</l>
            <lb/>
            
            <head><num>7.</num></head>
            <lb/>
            <l>Minder lieblich beduncket vns zwaren/</l>
            <lb/>
            <l>Wann der Guckguck/ gefraget von jahren/</l>
            <lb/>
            <l>Seine Tertzen hieru&#x364;ber laßt fahren:</l>
            <lb/>
            <l>Wann die Bienen ſo heiſer thu&#x366;n brummen/</l>
            <lb/>
            <l>Wann ſie vber die Blumen hinſummen:</l>
            <lb/>
            <l>Doch erfrewet vns jhres ankommen.</l>
            <lb/>
            
            <head><num>8.</num></head>
            <lb/>
            <l>Die geſchnabelten feinde der Schlangen/</l>
            <lb/>
            <l>Jn dem Fru&#x364;hling/ ohnfehlbar anlangen/</l>
            <lb/>
            <l>Die coaxenden Fro&#x364;ſchen ſie fangen:</l>
            <lb/>
            <l>Mit denſelben die jungen ſie ſpeiſen/</l>
            <lb/>
            <l>Jhre jungen ſich danckbar erweiſen/</l>
            <lb/>
            <l>Deren beyſpil den Kindern wir preiſen.</l>
            <lb/>
            
            <head><num>9.</num></head>
            <lb/>
            <l>Jn den Weyern der Enten geſchwader/</l>
            <lb/>
            <l>Sich ergetzet mit vilem geplader/</l>
            <lb/>
            <l>Vnd erꝛeget ein luſtig geſchnader:</l>
            <lb/>
            <l>Jn den Seen es wimmelt von Fiſchen/</l>
            <lb/>
            <l>Die ſich aber geparet vermiſchen/</l>
            <lb/>
            <l>Vnd mit ſchwu&#x364;mmen vnd ſpringen erfriſchen.</l>
            <lb/>
            
            <head><num>10.</num></head>
            <lb/>
            <l>Nun bedeutet der Fru&#x364;hling hieneben</l>
            <lb/>
            <l>Jungen Leuhten jhr blu&#x364;hendes Leben/</l>
            <lb/>
            <l>Das der Tugend ſie ſollen ergeben/</l>
            <lb/>
            <l>Doch ſo wollen wir jhnen nicht wehren</l>
            <lb/>
            <l>Die gebu&#x364;rlichen frewden/ in ehren/</l>
            <lb/>
            <l>So die zeiten erlauben vnd lehren.</l>
            <lb/>
            
         </div>
      </body>
