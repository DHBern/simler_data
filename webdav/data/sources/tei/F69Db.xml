   <text>
      <body>
         <div xml:id="F69Db" type="poem">
            <pb facs="3219026" n="14"/>
            <fw place="top" type="pageNum">14</fw>
            <lb/>
            
            <head rendition="#c"><hi rendition="#aq"><num>II.</num></hi>
            <lb/>
            Leid- und Freudbezeugendes Ehren-
            <lb break="no"/>
            geſang; in bekanter Weiſe:
            <lb/>
            Mit David wir die Einigkeit erheben/ ꝛc.</head>
            <lb/>
            
            <lg type="poem">
            <lg n="1">
            <l><hi rendition="#in">O</hi> Eitelkeit! Wie iſt des Menſchen Leben</l>
            <lb/>
            <l>Dem Todeszwang ſo ga&#x364;nzlich untergeben</l>
            <lb/>
            <l rendition="#et">Daß wider Jhn kein mieten/</l>
            <lb/>
            <l rendition="#et2">Kein Gelt- noch Gabenſchatz/</l>
            <lb/>
            <l rendition="#et">Kein bitten/ noch gebieten/</l>
            <lb/>
            <l rendition="#et2">Noch Weißheit findet platz.</l>
            </lg>
            <lb/>
            
            <fw place="bottom" type="catch">Herꝛ</fw>
            <lb/>
            <pb facs="3219027" n="15"/>
            <fw place="top" type="pageNum">15</fw>
            <lb/>
            
            <lg n="2">
            <l>Herꝛ Waſer uns iſt deſſen ein Exempel/</l>
            <lb/>
            <l>Alß welcher war ein ſcho&#x364;ner Weißheit-Tempel/</l>
            <lb/>
            <l rendition="#et">Und dennoch umgeſchliſſen</l>
            <lb/>
            <l rendition="#et2">Durch diſes Wu&#x364;rgers macht/</l>
            <lb/>
            <l rendition="#et">Dem nie kein Menſch entriſſen</l>
            <lb/>
            <l rendition="#et2">Wie hoch ers je gebracht.</l>
            </lg>
            <lb/>
            <lg n="3">
            <l>Erwehnter Herꝛ/ zwar alt und wolbetaget</l>
            <lb/>
            <l>Wird billich doch von Statt und Land beklaget:</l>
            <lb/>
            <l rendition="#et">Jhn klagen die Gelehrten:</l>
            <lb/>
            <l rendition="#et2">Der Raht- und Richterſtul;</l>
            <lb/>
            <l rendition="#et">Alß groſſen Schutzgefehrten;</l>
            <lb/>
            <l rendition="#et2">Jhn klagen Kirch und Schul.</l>
            </lg>
            <lb/>
            <lg n="4">
            <l>Was Groſſes wir an diſem Herꝛn verloren</l>
            <lb/>
            <l>Wird nicht geglaubt/ bis daß wir es zuvoren</l>
            <lb/>
            <l rendition="#et">Mit ſchaden ſelbſt erfahren/</l>
            <lb/>
            <l rendition="#et2">Zu diſer Wunderzeit:</l>
            <lb/>
            <l rendition="#et">Der Ho&#x364;chſt uns wo&#x364;ll bewahren</l>
            <lb/>
            <l rendition="#et2">Vor Land- und Glaubensſtreit!</l>
            </lg>
            <lb/>
            <lg n="5">
            <l>Frau Wittib; Sohn; Herꝛ'n Bru&#x364;der; Nechſtverwandte:</l>
            <lb/>
            <l>Jhr To&#x364;chter auch: Jhr Schwiegerſo&#x364;hn; Bekante:</l>
            <lb/>
            <l rendition="#et">Klagt billich Euers Herꝛen;</l>
            <lb/>
            <l rendition="#et2">Freunds; Bruders; Vatters End:</l>
            <lb/>
            <l rendition="#et">Wer wil Euch diſes ſperꝛen/</l>
            <lb/>
            <l rendition="#et2">Ohn Gott? Jn Freud Ers wend!</l>
            </lg>
            <lb/>
            <lg n="6">
            <l>Jm Herꝛen jez uns wider wir erfreuen/</l>
            <lb/>
            <l>Dieweil Er uns ſo meint mit allen Treuen/</l>
            <lb/>
            <l rendition="#et">Daß auf ſo groſſes Leide/</l>
            <lb/>
            <l rendition="#et2">Jn Herꝛen Waſers Fall/</l>
            <lb/>
            <l rendition="#et">Er uns ergezt mit Freude</l>
            <lb/>
            <l rendition="#et2">Durch Herꝛen Hirtzels Wahl.</l>
            </lg>
            <lb/>
            <lg n="7">
            <l>Nicht minder iſts/ mit Waſern iſt verblichen</l>
            <lb/>
            <l>Vil Wu&#x364;ſſenſchaft: mit Jhm iſt auch gewichen</l>
            <lb/>
            
            <fw place="bottom" type="catch">Jn</fw>
            <lb/>
            <pb facs="3219028" n="16"/>
            <fw place="top" type="pageNum">16</fw>
            <lb/>
            
            <l rendition="#et">Jn aller ſchwerſten Sachen</l>
            <lb/>
            <l rendition="#et2">Bericht und guter Raht:</l>
            <lb/>
            <l rendition="#et">Die/ billich/ Sorgen machen</l>
            <lb/>
            <l rendition="#et2">Fu&#x364;r den Gemeinen Staat.</l>
            </lg>
            <lb/>
            <lg n="8">
            <l>Doch wird uns auch im Hirtzel wol erſetzet</l>
            <lb/>
            <l>Was traurigeſt im Waſer abgeletzet:</l>
            <lb/>
            <l rendition="#et">Deß mag ſich wider freuen</l>
            <lb/>
            <l rendition="#et2">Das gantze Vatterland:</l>
            <lb/>
            <l rendition="#et">Es kan die Freud verneuen</l>
            <lb/>
            <l rendition="#et2">Jm ſelben jeder Stand!</l>
            </lg>
            <lb/>
            <lg n="9">
            <l>Der Ho&#x364;chſt Regent wo&#x364;ll diſem Herꝛen geben</l>
            <lb/>
            <l>Geſunde Tag'/ und Hirſchenlanges Leben;</l>
            <lb/>
            <l rendition="#et">Deßgleichen dem Mitt-Herꝛen</l>
            <lb/>
            <l rendition="#et2">Auf gleichem Ehrenthron!</l>
            <lb/>
            <l rendition="#et">GOTT wo&#x364;ll des Wunſchs gewerꝛen</l>
            <lb/>
            <l rendition="#et2">Herꝛn Hirtzeln: Herꝛen Rahn!</l>
            </lg>
            </lg>
            <lb/>
            
            <closer rendition="#right">
            Auß herzens innigkeit alſo wu&#x364;n-
            <lb break="no"/>
            ſchende wil ſeine Pflichtgebu&#x364;r hie-
            <lb break="no"/>
            mit abgelegt haben
            <lb/>
            Jhr Ehrſam Weißheit
            <lb/>
            Untertha&#x364;nigſter D.
            <lb/>
            <signed>Johann Wilhelm Simler/
            <lb/>
            Zuchtmeiſter des Alten/ und <hi rendition="#aq">In-
            <lb break="no"/>
            tendens</hi> des Neuen <hi rendition="#aq">Collegi</hi>ums.</signed>
            </closer>
            <lb/>
            
            <fw place="bottom" type="catch">Vor-</fw>
            <lb break="no"/>
         </div>
      </body>
