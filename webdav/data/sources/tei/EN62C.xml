   <text>
      <body>
         <div xml:id="EN62C" type="poem">
            <pb facs="17729264"/>
            <head rendition="#c">Neujahres-Gab/ für alle Sta&#x364;nde.</head>
            <lb/>
            
            <figure>
            <p><hi rendition="#aq">Welcher Baum
            <lb/>
            nicht gute frucht
            <lb/>
            bringet, der
            <lb/>
            wird abgeha
            <lb/>
            wen und etc.
            <lb/>
               
            C. M. fecit.</hi></p>
            </figure>
            <lb/>
            
            <!-- TODO HiWi: Spruchband ("Welcher Baum ...") und Signatur stehen im rechten Bild. -->
            <lg>
            <head rendition="#aq #c">Cantus.</head>
            <lb/>
            <l>Nun danket Gott/ durch Jeſum Chriſt/</l>
            <lb/>
            <l>fu&#x364;r wol verfloßne Jahresfriſt:</l>
            <lb/>
            <l>mit neuem vorſatz vnd gebett/</l>
            <lb/>
            <l>ins Neue Jahr ein ieder trett.</l>
            <lb/>
            <l>Hallelujah.</l>
            </lg>
            <lb/>
            
            <lg>
            <head rendition="#aq #c">Altus.</head>
            <lb/>
            <l>Nun danket Gott durch Jeſum Chriſt/</l>
            <lb/>
            <l>fu&#x364;r wol verfloßne Jahresfriſt:</l>
            <lb/>
            <l>mit neuem vorſatz vnd gebett/</l>
            <lb/>
            <l>ins Neue Jahr ein ieder trett.</l>
            <lb/>
            <l>Hallelujah.</l>
            </lg>
            <lb/>
            
            <lg>
            <head rendition="#aq #c">Tenor.</head>
            <lb/>
            <l>Nun danket Gott/ durch Jeſum Chriſt/</l>
            <lb/>
            <l>fu&#x364;r wol verfloßne Jahresfriſt:</l>
            <lb/>
            <l>mit neuem vorſatz vnd gebett</l>
            <lb/>
            <l>ins Neue Jahr ein ieder trett.</l>
            <lb/>
            <l>Hallelujah.</l>
            </lg>
            <lb/>
            
            <lg>
            <head rendition="#aq #c">Baſis.</head>
            <lb/>
            <l>Nun danket Gott/ durch Jeſum Chriſt/</l>
            <lb/>
            <l>fu&#x364;r wol verfloßne Jahresfriſt:</l>
            <lb/>
            <l>mit neuem vorſatz vnd geba&#x364;tt/</l>
            <lb/>
            <l>ins Neue Jahr ein ieder trett.</l>
            <lb/>
            <l>Hallelujah.</l>
            </lg>
            <lb/>
            
            <lg type="poem">
            <lg n="1">
            <l><hi rendition="#in">N</hi>Vn dancket Gott/ durch Jeſum Chriſt/</l>
            <lb/>
            <l>fu&#x364;r wolverfloßne Jahresfriſt/</l>
            <lb/>
            <l>mit neuem vorſatz und gebett/</l>
            <lb/>
            <l>ins Neue Jahr ein ieder trett. Hallelujah.</l>
            </lg>
            <lb/>
            
            <lg n="2">
            <head rendition="#c"><num>2.</num></head>
            <lb/>
            <l>Die Obrigkeit geleiches Recht</l>
            <lb/>
            <l>ertheil dem Herꝛen und dem Knecht:</l>
            <lb/>
            <l>ſey ſelb dem gſatz auch underthan/</l>
            <lb/>
            <l>mit gutem beyſpiel geh voran.</l>
            </lg>
            <lb/>
            
            <lg n="3">
            <head rendition="#c"><num>3.</num></head>
            <lb/>
            <l>Der underthan zu aller zeit/</l>
            <lb/>
            <l>ſich underwerf der Oberkeit/</l>
            <lb/>
            <l>nach landes brauch und in gebühr/</l>
            <lb/>
            <l>und ſetze leib und gut zu ihr.</l>
            </lg>
            <lb/>
            
            <lg n="4">
            <head rendition="#c"><num>4.</num></head>
            <lb/>
            <l>Befelchsleuth und gemeine knecht</l>
            <lb/>
            <l>ſich dapfer halten im gefecht/</l>
            <lb/>
            <l>vergnu&#x364;get an beſtim&#x303;tem ſold/</l>
            <lb/>
            <l>dem ungerechten gwalt abhold.</l>
            </lg>
            <lb/>
            
            <lg n="5">
            <head rendition="#c"><num>5.</num></head>
            <lb/>
            <l>Der Prediger leb Lehrgema&#x364;ß/</l>
            <lb/>
            <l>und ſey/ wie ſaltz/ im ſtraafam&#x303;t ra&#x364;ß/</l>
            <lb/>
            <l>ma&#x364;ng aber ernſt mit freundtlichkeit/</l>
            <lb/>
            <l>nach ieder ſach beſchaffenheit.</l>
            </lg>
            <lb/>
            
            <lg n="6">
            <head rendition="#c"><num>6.</num></head>
            <lb/>
            <l>Zuho&#x364;rer horchen auf die Lehr/</l>
            <lb/>
            <l>und folgen ihr jemehr und mehr/</l>
            <lb/>
            <l>alß Gottes wort/ zu ihrem heil/</l>
            <lb/>
            <l>an Chriſtus Erb zuhaben theil.</l>
            </lg>
            <lb/>
            
            <lg n="7">
            <head rendition="#c"><num>7.</num></head>
            <lb/>
            <l>Schulmeiſter/ Eltern/ und wer ſonſt</l>
            <lb/>
            <l>die jugend in der zucht und kunſt</l>
            <lb/>
            <l>erziehen ſol/ ſich auf das neu</l>
            <lb/>
            <l>befleiſſen unverdroßner treu.</l>
            </lg>
            <lb/>
            
            <lg n="8">
            <head rendition="#c"><num>8.</num></head>
            <lb/>
            <l>Jhr Kinder laßt euch ziehen wol</l>
            <lb/>
            <l>von Eltern/ oder wer es ſol:</l>
            <lb/>
            <l>dan welcher nicht annim&#x303;t die zucht/</l>
            <lb/>
            <l>der wachſet auf zu bo&#x364;ſer frucht.</l>
            </lg>
            <lb/>
            
            <lg n="9">
            <head rendition="#c"><num>9.</num></head>
            <lb/>
            <l>Der Herꝛ/ der Meiſter und die Frau/</l>
            <lb/>
            <l>den Dienſten ſeyen nicht zu rau/</l>
            <lb/>
            <l>gedencken/ Gott im Himmelreich</l>
            <lb/>
            <l>ſey allerſamen Herꝛ zugleich.</l>
            </lg>
            <lb/>
            
            <lg n="10">
            <head rendition="#c"><num>10.</num></head>
            <lb/>
            <l>Die Dienſt/ und wer um lohn gedingt/</l>
            <lb/>
            <l>verꝛichten was ihr Bru&#x366;f mitbringt/</l>
            <lb/>
            <l>ohn allen falſch/ zu aller ſtund/</l>
            <lb/>
            <l>alß dientens Gott/ auß hertzens-grund.</l>
            </lg>
            <lb/>
            
            <lg n="11">
            <head rendition="#c"><num>11.</num></head>
            <lb/>
            <l>Ehleuhten liebe ſich verneu/</l>
            <lb/>
            <l>und biß in tod beſtendig ſey/</l>
            <lb/>
            <l>wie Chriſtus Lieb' und ſeiner Gmeind/</l>
            <lb/>
            <l>dann in der Eh zwey ein fleiſch ſeind.</l>
            </lg>
            <lb/>
            
            <lg n="12">
            <head rendition="#c"><num>12.</num></head>
            <lb/>
            <l>Die Jüngling und Jungfra&#x364;uelein</l>
            <lb/>
            <l>ſich halten ehrbar/ künſch und rein:</l>
            <lb/>
            <l>mit Gott/ und ihrer Eltern raht/</l>
            <lb/>
            <l>in Ehſtand kommens nie zuſpaht.</l>
            </lg>
            <lb/>
            
            <lg n="13">
            <head rendition="#c"><num>13.</num></head>
            <lb/>
            <l>Der Reich mit neuer Gab erquick</l>
            <lb/>
            <l>den armen/ und der arm ſich ſchick</l>
            <lb/>
            <l>gedultig in die armuhtey/</l>
            <lb/>
            <l>verhoff das ewig Gut darbey.</l>
            </lg>
            <lb/>
            
            <lg n="14">
            <head rendition="#c"><num>14.</num></head>
            <lb/>
            <l>Der Handelsmann nicht wu&#x366;cher treib</l>
            <lb/>
            <l>mit ungebühr/ in ſchrancken bleib</l>
            <lb/>
            <l>ſeins Chriſtenthums/ geb aber hin</l>
            <lb/>
            <l>auf billichen und o&#x364;ftern gwin.</l>
            </lg>
            <lb/>
            
            <lg n="15">
            <head rendition="#c"><num>15.</num></head>
            <lb/>
            <l>Der Handtwercksmann zur Arbeit greiff</l>
            <lb/>
            <l>mit friſchem muht/ und harꝛe ſteiff</l>
            <lb/>
            <l>Des Segens/ den der Herꝛ beſchehrt/</l>
            <lb/>
            <l>alß der in fluch nicht wird verkehrt.</l>
            </lg>
            <lb/>
            
            <lg n="16">
            <head rendition="#c"><num>16.</num></head>
            <lb/>
            <l>Der Baur das Feld- und Rebwerck bau/</l>
            <lb/>
            <l>und im gebett dem Scho&#x364;pfer trau/</l>
            <lb/>
            <l>daß er ſein Arbeit ſegnen werd</l>
            <lb/>
            <l>mit wu&#x366;cher auß der ku&#x364;hlen erd.</l>
            </lg>
            <lb/>
            
            <lg n="17">
            <head rendition="#c"><num>17.</num></head>
            <lb/>
            <l>Jhr krancken und pra&#x364;ſthaffte leuht/</l>
            <lb/>
            <l>ihr/ die im elend lebt zerſtreut/</l>
            <lb/>
            <l>am leib und an der ſeel geplagt/</l>
            <lb/>
            <l>erlo&#x364;ſung hoft/ und nicht verzagt.</l>
            </lg>
            <lb/>
            
            <lg n="18">
            <head rendition="#c"><num>18.</num></head>
            <lb/>
            <l>Jhr ſünder/ ab dem Laſterweg/</l>
            <lb/>
            <l>begebt euch auf den Tugendſteg/</l>
            <lb/>
            <l>und ſucht in Chriſto Gottes huld/</l>
            <lb/>
            <l>ſo ſeyt ihr quitt der ſtraaf und ſchuld.</l>
            </lg>
            <lb/>
            
            <lg n="19">
            <head rendition="#c"><num>19.</num></head>
            <lb/>
            <l>Diß nun zurichten in das werck/</l>
            <lb/>
            <l>verleih vns neue kraft und ſterck</l>
            <lb/>
            <l>hochheilige Dreyeinigkeit/</l>
            <lb/>
            <l>gelobet in- und nach der zeit.</l>
            </lg>
            <lb/>
            </lg>
            
            <p>Einer Eheliebenden jungen Burgerſchafft zu Zu&#x364;rich/ ab der Burger-<lb
            break="no"/>Bibliothek/ fu&#x364;r das 1662. Jahr verehrt.</p>
            <lb/>
            
         </div>
      </body>
