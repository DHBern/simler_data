   <text>
      <body>
         <div>
            <pb facs="1"/>
            <hi rendition="#aq">ODE TROCHAICA,</hi>
            <lb/>
            Vber
            <lb/>
            Das guldene Bu&#x364;chlein
            <lb/>
            Von der ſeligen
            <lb/>
            Ru&#x366;h- oder Fridens-
            <lb break="no"/>
            u&#x364;bung.
            <lb/>
            
            <l><hi rendition="#in">W</hi>Ann ich mich zu&#x366; denen wende/</l>
            <lb/>
            <l>Die diß Bu&#x364;chlein eigentlich</l>
            <lb/>
            <l>Durchgela&#x364;ſen bis zum ende/</l>
            <lb/>
            <l>Werden ſie erkla&#x364;ren ſich/</l>
            <lb/>
            <l>Daß es/ zu&#x366; bequa&#x364;mer zeit/</l>
            <lb/>
            <l>Jn die Welt werd' außgebreit.</l>
            <lb/>
            
            <head><num>2.</num></head>
            <lb/>
            <l>Wünſchen werden ſie darneben/</l>
            <lb/>
            <l>Daß ſein angebottner Schatz/</l>
            <lb/>
            <l>Wo auch jmmer Menſchen leben/</l>
            <lb/>
            <l>Wider mo&#x364;ge finden platz:</l>
            <lb/>
            <l>Sonderlich im Teutſchen Land/</l>
            <lb/>
            <l>Bey dem ho&#x364;chſt- vnd minſten Stand!</l>
            <lb/>
            
            <fw place="bottom" type="catch"><num>3.</num> Endt-</fw>
            <lb break="no"/>
            <pb facs="2"/>
            
            <head><num>3.</num></head>
            <lb/>
            <l>Endtlich werdens mit mir preiſen</l>
            <lb/>
            <l>Den Vrha&#x364;ber/ vnd zu&#x366;gleich</l>
            <lb/>
            <l>Den Tolmetſchen: Die vns weiſen</l>
            <lb/>
            <l>Zu&#x366; dem Friden Sa&#x364;gen-reich/</l>
            <lb/>
            <l>Ja zur Himmels-Frewd vnd Ru&#x366;h:</l>
            <lb/>
            <l><hi rendition="#g">HERR/</hi> den Fortgang gib darzu&#x366;!</l>
            <lb/>
            
            <head><num>4.</num></head>
            <lb/>
            <l>Halleluja: Lobt den <hi rendition="#g">HERREN</hi></l>
            <lb/>
            <l>Jhr/ die in dem Friden lebt:</l>
            <lb/>
            <l>Vnfrid weiche von euch ferꝛen/</l>
            <lb/>
            <l>Die jhr nach dem Friden ſtrebt:</l>
            <lb/>
            <l>Wider Satans liſt vnd gwalt/</l>
            <lb/>
            <l><hi rendition="#g">HERR/</hi> im Friden vns erhalt!</l>
            <lb/>
            
            J. W. S.
            <lb/>
            
