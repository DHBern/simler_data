    <xt:extension id="simler">
        <xt:location href="simler.zip"/>
        <xt:version>0.1.5</xt:version>
        <xt:oxy_version>21.0+</xt:oxy_version>
        <xt:type>framework</xt:type>
        <xt:author>cforney</xt:author>
        <xt:name>simler</xt:name>
        <xt:description xmlns="http://www.w3.org/1999/xhtml">
            <h1>Simler Framework</h1>
            <div class="body">
                <h2>Changelog</h2>
                <h3>Version 0.1.5</h3>
                <p>Release date: 01/04/2026</p>
                <p>Fix:</p>
                <ul>
                    <li>Seite in IIIF-Viewer öffnen funktioniert nicht auf macOS</li>
                </ul>
                <h3>Version 0.1.4</h3>
                <p>Release date: 24/03/2026</p>
                <p>Neu:</p>
                <ul>
                    <li>Seite in IIIF-Viewer öffnen</li>
                    <li>Darstellung Renditions (#aq, #k, #in, #smaller, #larger, #c und #right)</li>
                    <li>Darstellung note (right)</li>
                </ul>
                <p>Update:</p>
                <ul>
                    <li>Darstellung von pb, milestone sowie lg/l</li>
                </ul>
                <h3>Version 0.1.3</h3>
                <p>Release date: 05/06/2025</p>
                <p>Update:</p>
                <ul>
                    <li>Schema auf modifiziertes Basisformat umgestellt</li>
                </ul>
                <p>Fix:</p>
                <ul>
                    <li>Darstellung Umbrüche vor head und pb</li>
                </ul>
                <h3>Version 0.1.2</h3>
                <p>Release date: 13/05/2025</p>
                <p>Fix:</p>
                <ul>
                    <li>Darstellung Umbrüche vor label und head</li>
                </ul>
                <h3>Version 0.1.1</h3>
                <p>Release date: 30/04/2025</p>
                <p>Fix:</p>
                <ul>
                    <li>Verbesserter XPath für Tooltips von Referenzen</li>
                    <li>Generierung von @xml:id bei anchor</li>
                </ul>
                <h3>Version 0.1.0</h3>
                <p>Release date: 24/04/2025</p>
                <p>Neu:</p>
                <ul>
                    <li>Zuklappbare Kommentare.</li>
                    <li>Referenzierung Helvetismen.</li>
                </ul>
                <h3>Version 0.0.0</h3>
                <p>Release date: 15/04/2025</p>
                <ul>
                    <li>Erster Prototyp des Frameworks.</li>
                </ul>
            </div>
