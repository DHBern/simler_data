            <ab facs="#facs_5_tr_1" type="">
               <lb facs="#facs_5_tr_1_tl_14" n="N001"/><Antiqua><Numbering>VI.</Numbering></Antiqua>
               <lb facs="#facs_5_tr_1_tl_15" n="N002"/>Johannes Wirtz:
               <lb facs="#facs_5_tr_1_tl_16" n="N003"/>verwaͤchſelt:
               <lb facs="#facs_5_tr_1_tl_17" n="N004"/>So warn ihn ietz.
               <lb facs="#facs_5_tr_1_tl_18" n="N005"/><Initial_letter>Z</Initial_letter>u ſo verkehrter Zeit; bey ſo verderbter Jugend/
               <lb facs="#facs_5_tr_1_tl_19" n="N006"/>Da vil verlohrne Soͤhn' umwandlen in untugend/
               <lb facs="#facs_5_tr_1_tl_20" n="N007"/>Der Dichter diſes Buͦchs dir gibet diſen Raht:
               <lb facs="#facs_5_tr_1_tl_21" n="N008"/><Bold>So warn ihn<comment comment="Die Virgel wird als Teil der Sinnenhaft mitgetaggt.">/</comment></Bold> deinen Sohn/ <Bold>ietz<comment comment="Die Virgel wird als Teil der Sinneinheit mitgetaggt.">/</comment></Bold> eh es wird zu ſpaht.
               <lb facs="#facs_5_tr_1_tl_22" n="N009"/>Zu ſchuldigen ehren ſchreibt ſolches
               <lb facs="#facs_5_tr_1_tl_23" n="N010"/>Johann Wilhelm Simler/
               <lb facs="#facs_5_tr_1_tl_24" n="N011"/>Zuchtmeiſter zum Fr. M.
            </ab>
            <pb facs="#facs_6" n="6" xml:id="img_0006"/>
            <pb facs="#facs_7" n="7" xml:id="img_0007"/>
            <pb facs="#facs_8" n="8" xml:id="img_0008"/>
