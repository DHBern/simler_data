            <pb facs="#facs_1" n="1" xml:id="img_0001"/>
            <pb facs="#facs_2" n="2" xml:id="img_0002"/>
            <ab facs="#facs_2_r" type="">
               <lb facs="#facs_2_l" n="N001"/><Antiqua>Jnventor.
               <lb facs="#facs_2_l_7" n="N002"/>Con: Meÿer
               <lb facs="#facs_2_l_11" n="N003"/>fecit. et ex.</Antiqua>
            </ab>
            <ab facs="#facs_2_r_7" type="">
               <lb facs="#facs_2_l_25" n="N001"/><Antiqua>CHRiSTEN KAMPF.</Antiqua>
               <lb facs="#facs_2_l_9" n="N002"/>Der Menſch<unclear reason="Wahrscheinlich\u0020Doppelpunkt,\u0020aber\u0020Semikolon\u0020nicht\u0020auszuschliessen" alternative="\u003b">:</unclear> wie Job bezeügt: im Streit muͦß jmmer Leben:
               <lb facs="#facs_2_l_13" n="N003"/>Die hölliſch Wuͤtereÿ thuͦt jhme wider ſtreben<unclear reason="Es scheint ein Komma bzw. eine Virgel zu stehen, ist aber nicht gut erkennbar.">/</unclear>
               <lb facs="#facs_2_l_17" n="N004"/>Vnd nach vil ander Feind: worunder ſeind gezellt
               <lb facs="#facs_2_l_21" n="N005"/>Sein eigen Fleiſch: der Tod: die <unclear alternative="laſter haffte" reason="Abstand nach klein r oft etwas grösser, siehe z.B. &#34;Auſserwehlten&#34;, &#34;vorauſs&#34;">laſterhaffte</unclear> Wellt:
               <lb facs="#facs_2_l_26" n="N006"/>Anfechtung vilerleÿ: Verfolgung/ vnd Beſchwerden/
               <lb facs="#facs_2_l_30" n="N007"/>Vnd was der Sathan mehr erwecket hier auff Erden/
               <lb facs="#facs_2_l_34" n="N008"/>Alſs der von zorn entbrandt/ geleich dem Donner Keÿl/
               <lb facs="#facs_2_l_38" n="N009"/>Vns zu vertilgen gar abſchieſſet fewrig pfeil.
               <lb facs="#facs_2_l_10" n="N010"/>Wie aber ſolche Feind wir moͤgen <unclear alternative="v̈ber-winden" reason="Der Bindestrich wurde wohl später von Hand eingezeichnet">v̈ber winden</unclear>/
               <lb facs="#facs_2_l_14" n="N011"/>Der Krieges Fürſt vns Lehrt: wie beÿ Matth<Antiqua>æ</Antiqua>o zfinden:
               <lb facs="#facs_2_l_18" n="N012"/>Da/ wider Sathans Liſt/ vnd wider Sathans Macht/
               <lb facs="#facs_2_l_22" n="N013"/>Die Waaffen ſeines Worts Er in das Feld gebracht.
               <lb facs="#facs_2_l_27" n="N014"/>Dieſelben Waaffen auch der Heiden Lehrer preiſet/
               <lb facs="#facs_2_l_31" n="N015"/>Vnd ſie von Stuck zu Stuck den Auſserwehlten weiſet.
               <lb facs="#facs_2_l_35" n="N016"/>Er ſpricht: Die Laͤnden Eüch vmbgürtet mit Waarheit:
               <lb facs="#facs_2_l_39" n="N017"/>Es b'ſchirme Ewer Bruſt der Krebſs der Grechtigkeit:
               <lb facs="#facs_2_l_4" n="N018"/>An Fuͤſſen ſeit geſchuͤcht in jehne Wellt zugehen:
               <lb facs="#facs_2_l_8" n="N019"/>(Die Lehr von Chriſto wir durch diſe Schuch verſtehen)
               <lb facs="#facs_2_l_12" n="N020"/>Jedoch/ zuͦloͤſchen gar des boͤſen fewrig Pfeil/
               <lb facs="#facs_2_l_16" n="N021"/>Den Glaubens Schilt vorauſs ergreiffet in der eil:
               <lb facs="#facs_2_l_20" n="N022"/>Setzt auff den Helm des Heÿls/ vnd faſſet mit der Rechten
               <lb facs="#facs_2_l_24" n="N023"/>Das ſcharpfe Schwert des Geiſts: So werdt jhr Sighafft fechten/
               <lb facs="#facs_2_l_28" n="N024"/>Vnd/ nach vollbrachtem Streit/ in hoͤchſter Herꝛlikeit/
               <lb facs="#facs_2_l_32" n="N025"/>Die ewig-wehrend Cron empfahen allbereit.
               <lb facs="#facs_2_l_6" n="N026"/>Der Menſch; wie ob gemaͤldt; im Streit muͦſſ jm̃er Leben:
               <lb facs="#facs_2_l_15" n="N027"/>Der Sieg/ vnd Siegers Lohn vom Herꝛen wird gegeben.
               <lb facs="#facs_2_l_19" n="N028"/>Des ruͤffen wir zu jhm/ wir/ die wir wehrloſ ſeind:
               <lb facs="#facs_2_l_23" n="N029"/>O Herꝛ/ bewaaffne vns/ ſo weichet vnſer Feind.
               <lb facs="#facs_2_l_29" n="N030"/>J. W. S.
            </ab>
         </div>
