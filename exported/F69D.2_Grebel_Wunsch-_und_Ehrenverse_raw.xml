            <ab facs="#facs_26_tr_1" type="">
               <lb facs="#facs_26_tr_1_tl_1" n="N001"/><page_number>25</page_number>
               <lb facs="#facs_26_tr_1_tl_3" n="N002"/><Antiqua><Numbering>XII.</Numbering></Antiqua>
               <lb facs="#facs_26_tr_1_tl_4" n="N003"/>Wunſch- und Ehrenverſe:
               <lb facs="#facs_26_tr_1_tl_5" n="N004"/>An Herꝛen Johann Conrad Grebel/
               <lb facs="#facs_26_tr_1_tl_6" n="N005"/>Vattern des Vatterlandes:
               <lb facs="#facs_26_tr_1_tl_7" n="N006"/>Uber wolverdienlich; nach eiferigſt/ in allen vier Pfarꝛkirchen/
               <lb facs="#facs_26_tr_1_tl_8" n="N007"/>vollendetem Gottesdienſte; erlangtes Burgermeiſterthum/
               <lb facs="#facs_26_tr_1_tl_9" n="N008"/>Donſtags/ den 23. Herbſtm. <Antiqua>M DC LXIX.</Antiqua>
               <lb facs="#facs_26_tr_1_tl_10" n="N009"/><Initial_letter>S</Initial_letter>O ſeyt/ Herꝛ Grebel/ Jhr/ Herꝛn Hirzeln zugeſellet
               <lb facs="#facs_26_tr_1_tl_11" n="N010"/>Jm Burgermeiſterthum: der Fuͤnfzigſt wol Erwehlet
               <lb facs="#facs_26_tr_1_tl_12" n="N011"/>Mit Gott/ durch ſchoͤnes Mehr. O mehr alß wolgethan!
               <lb facs="#facs_26_tr_1_tl_13" n="N012"/>Hets nur gekoſtet nicht den theuren <Bold>Herꝛen Rahn/</Bold>
               <lb facs="#facs_26_tr_1_tl_14" n="N013"/>Den ſo Sanftmuͤhtigen/ den ſo Liebreichen Vatter/
               <lb facs="#facs_26_tr_1_tl_16" n="N014"/>Zwar Alt/ und Lebensſatt. Nun aber Jhr Erſtatter
               <lb facs="#facs_26_tr_1_tl_17" n="N015"/>Seyt ſeiner Tugenden/ ſo gebt Jhr Hoffnungs-Troſt
               <lb facs="#facs_26_tr_1_tl_18" n="N016"/>Zunieſſen unter Euch Milch/ Honig/ Oel/ und Moſt/
               <lb facs="#facs_26_tr_1_tl_19" n="N017"/>Und andre Fridensfruͤcht'; auch ſpaͤht- und fruͤhen Regen/
               <lb facs="#facs_26_tr_1_tl_20" n="N018"/>Die jez und immerhin verleyh des Hoͤchſten Segen!
               <lb facs="#facs_26_tr_1_tl_21" n="N019"/>Gott ſegne diſe Wahl von nun an/ fuͤr und fuͤr/
               <lb facs="#facs_26_tr_1_tl_22" n="N020"/>Wie deſſen ein Gemerk unlaͤngſt verſpuͤret wir:
               <lb facs="#facs_26_tr_1_tl_23" n="N021"/>Und zwar/ wie ſolten wir nicht urchen gutes hoffen
               <lb facs="#facs_26_tr_1_tl_24" n="N022"/>Von deme/ den die Wahl ſo wuͤrdig hat getroffen/
               <lb facs="#facs_26_tr_1_tl_25" n="N023"/>Daß Statt und Land ſie preißt/ und deren ſich befreut/
               <lb facs="#facs_26_tr_1_tl_26" n="N024"/>Weil ſeiner Alten Treu in Jhme ſich verneut.
               <lb facs="#facs_26_tr_1_tl_27" n="N025"/>Vom Edlen Stamme ruͤhrt was guts im Apfel ſtecket:
               <lb facs="#facs_26_tr_1_tl_28" n="N026"/>Vom Adler keine Daub ward jemals außgehecket:
               <lb facs="#facs_26_tr_1_tl_29" n="N027"/>Thierkoͤnigs dapfre Zucht von Haſens art iſt fehr:
               <lb facs="#facs_26_tr_1_tl_30" n="N028"/>Alſo bſizt unſer Herꝛ der Edlen Ahnen Ehr.
               <lb facs="#facs_26_tr_1_tl_31" n="N029"/>Er ſelb/ o Vatterland/ vor vilen iſt gezieret
               <lb facs="#facs_26_tr_1_tl_32" n="N030"/>Mit ſchoͤner Wuͤſſenſchaft: Und/ was Er ſchon vollfuͤhret/
               <lb facs="#facs_26_tr_1_tl_33" n="N031"/>Weißt Teutſch- und Welſches Land. Er iſt der Ehre wert:
               <lb facs="#facs_26_tr_1_tl_34" n="N032"/>Es <choice><corr/><sic>L</sic></choice>eben Hundert Jahr Er und ſein Mitgefehrt!
               <lb facs="#facs_26_tr_1_tl_35" n="N033"/>Von E. E. Weißheit
               <lb facs="#facs_26_tr_1_tl_36" n="N034"/>Unterthaͤnigſtem Diener
               <lb facs="#facs_26_tr_1_tl_37" n="N035"/>Joh. Wilhelm Simler/ dem Eltern.
