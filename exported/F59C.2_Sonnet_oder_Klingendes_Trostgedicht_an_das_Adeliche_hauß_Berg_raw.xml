               <lb facs="#facs_50_tr_1_tl_6" n="N005"/>Klingendes Troſtge-
               <lb facs="#facs_50_tr_1_tl_7" n="N006"/>dicht/
               <lb facs="#facs_50_tr_1_tl_8" n="N007"/>an das Adeliche hauß
               <lb facs="#facs_50_tr_1_tl_9" n="N008"/>Berg.
               <lb facs="#facs_50_tr_1_tl_10" n="N009"/><Initial_letter>B</Initial_letter>Erg verberge ſeinen kummer/ über den ſo lie-
               <lb facs="#facs_50_tr_1_tl_11" n="N010"/>ben <Bold>Sohn</Bold>/
               <lb facs="#facs_50_tr_1_tl_12" n="N011"/>den des ſtrengen<Bold> Rheines Runs</Bold>/ hingeriſ-
               <lb facs="#facs_50_tr_1_tl_13" n="N012"/>ſen und verzuket
               <lb facs="#facs_50_tr_1_tl_14" n="N013"/>auß des Bruͦders hand und aug/ unter <Bold>Baſel</Bold> abge-
               <lb facs="#facs_50_tr_1_tl_15" n="N014"/>rucket:
               <lb facs="#facs_50_tr_1_tl_16" n="N015"/>Dann der <Bold>Leichnam</Bold> iſt gefunden/ wo er war verſchar-
               <lb facs="#facs_50_tr_1_tl_17" n="N016"/>ret ſchon/
               <lb facs="#facs_50_tr_1_tl_18" n="N017"/>und anietz zum troſt euch Eltern; aber auch dem Neid
               <lb facs="#facs_50_tr_1_tl_19" n="N018"/>zu hohn;
               <lb facs="#facs_50_tr_1_tl_20" n="N019"/>in die <Bold>Bergerkirch</Bold> verſetzt; adelmaͤſſig außgeſchmu-
               <lb facs="#facs_50_tr_1_tl_21" n="N020"/>cket;
               <lb facs="#facs_50_tr_1_tl_22" n="N021"/>durch gelehrte <Bold>Schrifft</Bold> zugleich wird der Nachwelt
               <lb facs="#facs_50_tr_1_tl_23" n="N022"/>vorgetruket
               <lb facs="#facs_50_l_3" n="N023"/>zu der nachfolg ſeine Tugend; Jhme zu verdientem 
               <lb facs="#facs_50_tr_1_tl_26" n="N024"/>lohn.
               <lb facs="#facs_50_tr_1_tl_27" n="N025"/>Alſo lebt er nach dem Tod: drum verberget eüern
               <lb facs="#facs_50_tr_1_tl_28" n="N026"/>ſchmertzen/
               <lb facs="#facs_50_l_2" n="N027"/>D  <Catch_word>wüſchet</Catch_word>
            </ab>
            <pb facs="#facs_51" n="51" xml:id="img_0051"/>
            <ab facs="#facs_51_tr_1" type="">
               <lb facs="#facs_51_tr_1_tl_1" n="N001"/><Page_number>50</Page_number>
               <lb facs="#facs_51_tr_1_tl_2" n="N002"/>wüſchet weg den Threnenbach; faſſet nicht ſo tieff zu
               <lb facs="#facs_51_tr_1_tl_3" n="N003"/>hertzen/
               <lb facs="#facs_51_tr_1_tl_4" n="N004"/>daß ein Eſcher/ auß der Eſchen/ in die Eſchen wi-
               <lb facs="#facs_51_tr_1_tl_5" n="N005"/>derkehrt:
               <lb facs="#facs_51_tr_1_tl_6" n="N006"/>Hat euch gleich des Hoͤchſten hand; zwar empfindt-
               <lb facs="#facs_51_tr_1_tl_7" n="N007"/>lich gnuͦg; getroffen/
               <lb facs="#facs_51_tr_1_tl_8" n="N008"/>ſo ligt eure Staͤrcke doch in der Still und in
               <lb facs="#facs_51_tr_1_tl_9" n="N009"/>dem Hoffen:
               <lb facs="#facs_51_tr_1_tl_10" n="N010"/>Freuet euch/ daß euer Sohn/ ſeligſt/ ſeinen Schoͤpfer
               <lb facs="#facs_51_tr_1_tl_11" n="N011"/>ehrt.
               <lb facs="#facs_51_tr_1_tl_12" n="N012"/>Auß Chriſtlichem mitleiden/ und zu wolwürdi-
               <lb facs="#facs_51_tr_1_tl_13" n="N013"/>gen Ehren ſetzt obiges freywilligſt
               <lb facs="#facs_51_tr_1_tl_14" n="N014"/>Johann Wilhelm Simler.
            </ab>
