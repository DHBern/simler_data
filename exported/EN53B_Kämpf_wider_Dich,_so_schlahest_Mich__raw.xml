            <ab facs="#facs_2_tr_2" type="">
               <lb facs="#facs_2_tr_2_tl_1" n="N001"/>4. Sinnenbild.
               <lb facs="#facs_2_tr_2_tl_2" n="N002"/>Kaͤmpf wider Dich/ So ſchlaheſt Mich.
               <lb facs="#facs_2_tr_2_tl_3" n="N003"/><Antiqua>Conrad Meÿer, Pictor, fecit.</Antiqua>
            </ab>
            <ab facs="#facs_2_r_34" type="">
               <lb facs="#facs_2_tr_2_tl_4" n="N001"/>Diſes Ungeheür* zuͦ daͤmpfen/
               <lb facs="#facs_2_tr_2_tl_6" n="N002"/>jeder wider ſich muͦß kaͤmpfen/
               <lb facs="#facs_2_tr_2_tl_7" n="N003"/>mit der Rüſtung angethan/
               <lb facs="#facs_2_tr_2_tl_8" n="N004"/>die Sant Paul ihm zeigen kan.
               <lb facs="#facs_2_tr_2_tl_9" n="N005"/>Er muͦß ſeinen Leib bezaͤmmen;
               <lb facs="#facs_2_tr_2_tl_10" n="N006"/>Glider toͤden; Lüſte haͤmmen;
               <lb facs="#facs_2_tr_2_tl_11" n="N007"/>ſonſten wider ihn erthoͤnt:
               <lb facs="#facs_2_tr_2_tl_12" n="N008"/>Wer nicht kaͤmpft wird nicht gekroͤnt.
            </ab>
            <ab facs="#facs_2_tr_1" type="">
               <lb facs="#facs_2_tr_1_tl_1" n="N001"/><Antiqua>Eph.6.v.11.
               <lb facs="#facs_2_tr_1_tl_2" n="N002"/>Coloſs.3.v.5
               <lb facs="#facs_2_tr_1_tl_3" n="N003"/>2.Tim.2.v.5</Antiqua>
            </ab>
            <ab facs="#facs_2_r" type="">
               <lb facs="#facs_2_tr_2_tl_5" n="N001"/><Antiqua>*Laſterthier</Antiqua>
            </ab>
            <ab facs="#facs_2_r_59" type="">
               <lb facs="#facs_2_tr_2_tl_13" n="N001"/>Einer Tugendliebenden Jugend in Zürich
               <lb facs="#facs_2_tr_2_tl_14" n="N002"/>ab der Burgerbibliothec/ für das
               <lb facs="#facs_2_tr_2_tl_15" n="N003"/>1653. oder erſte nach dem ſchroͤklichen
               <lb facs="#facs_2_tr_2_tl_16" n="N004"/>Donner-jahr/ verehrt.
            </ab>
         </div>
