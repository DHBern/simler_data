            <pb facs="#facs_15" n="15" xml:id="img_0015"/>
            <ab facs="#facs_15_tr_1" type="">
               <lb facs="#facs_15_tr_1_tl_1" n="N001"/><page_number>14</page_number>
               <lb facs="#facs_15_tr_1_tl_2" n="N002"/><Antiqua><Numbering>VIII.</Numbering></Antiqua>
               <lb facs="#facs_15_tr_1_tl_3" n="N003"/><Antiqua><Numbering>I.</Numbering></Antiqua>
               <lb facs="#facs_15_tr_1_tl_4" n="N004"/>Vorgeticht an Jhr Ehrſ. W.
               <lb facs="#facs_15_tr_1_tl_5" n="N005"/><Initial_letter>H</Initial_letter>Ochwolbegabter Herꝛ; von Eltern beſter Sitten/
               <lb facs="#facs_15_tr_1_tl_6" n="N006"/>Die auch der Weißheit Ban/ zu Hoͤchſter Ehr/ geſchritten;
               <lb facs="#facs_15_tr_1_tl_7" n="N007"/>Des groſſen <Bold>Hirtzels Sohn</Bold>/ von ſchoͤneſtem Gebluͤt/
               <lb facs="#facs_15_tr_1_tl_8" n="N008"/>Dem Vatter aͤhnlich ganz von Leib und von Gemuͤht.
               <lb facs="#facs_15_tr_1_tl_9" n="N009"/>Herꝛ/ unſer Landes Preis/ vom Vorfahrn unterwiſen/
               <lb facs="#facs_15_tr_1_tl_10" n="N010"/>Den unvergleichlich Jhr/ unlengſten/ ſelbſt gepriſen/
               <lb facs="#facs_15_tr_1_tl_11" n="N011"/>Und der/ nach ſanftem Tod/ zwar Sternenhoͤher ſchwebt;
               <lb facs="#facs_15_tr_1_tl_12" n="N012"/>Jedoch/ der Schriften halb/ bey uns auf Erden lebt;
               <lb facs="#facs_15_tr_1_tl_13" n="N013"/>Neuwolerwehlter Herꝛ/ Hochweiſer Burgermeiſter/
               <lb facs="#facs_15_tr_1_tl_14" n="N014"/>Solt nicht Jhr ſeyn begruͤßt/ durch die Poetengeiſter?
               <lb facs="#facs_15_tr_1_tl_15" n="N015"/>Ja freylich: Jch der minſt anjez anſtimmen wil
               <lb facs="#facs_15_tr_1_tl_16" n="N016"/>Ein Ehrenwunſchgeſang. Der Hoͤchſt verhelff zum Zil!
               <lb facs="#facs_15_tr_1_tl_17" n="N017"/>Jhr aber/ werther Herꝛ/ laßt alles Euch gefallen
               <lb facs="#facs_15_tr_1_tl_18" n="N018"/>Was/ beſter meinung/ hier zu Ehren wird erſchallen
               <lb facs="#facs_15_tr_1_tl_19" n="N019"/>Von dem/ der Eurer Wahl/ nicht wenig ſich erfreut/
               <lb facs="#facs_15_tr_1_tl_20" n="N020"/>Weil die gemiltert hat vorgehnde Traurigkeit.
               <lb facs="#facs_15_tr_1_tl_21" n="N021"/><Antiqua><Numbering>II.</Numbering></Antiqua>
               <lb facs="#facs_15_tr_1_tl_22" n="N022"/>Leid- und Freudbezeugendes Ehren-
               <lb facs="#facs_15_tr_1_tl_23" n="N023"/>geſang; in bekanter Weiſe:
               <lb facs="#facs_15_tr_1_tl_24" n="N024"/>Mit David wir die Einigkeit erheben/ ꝛc.
               <lb facs="#facs_15_tr_1_tl_25" n="N025"/><Initial_letter>O</Initial_letter> Eitelkeit! Wie iſt des Menſchen Leben
               <lb facs="#facs_15_tr_1_tl_26" n="N026"/>Dem Todeszwang ſo gaͤnzlich untergeben
               <lb facs="#facs_15_tr_1_tl_28" n="N027"/>Daß wider Jhn kein mieten/
               <lb facs="#facs_15_tr_1_tl_29" n="N028"/>Kein Gelt- noch Gabenſchatz/
               <lb facs="#facs_15_tr_1_tl_30" n="N029"/>Kein bitten/ noch gebieten/
               <lb facs="#facs_15_tr_1_tl_31" n="N030"/>Noch Weißheit findet platz.
               <lb facs="#facs_15_tr_2_tl_1" n="N031"/><Catch_word>Herꝛ</Catch_word>
            </ab>
            <pb facs="#facs_16" n="16" xml:id="img_0016"/>
            <ab facs="#facs_16_tr_1" type="">
               <lb facs="#facs_16_tr_1_tl_1" n="N001"/><page_number>15</page_number>
               <lb facs="#facs_16_tr_1_tl_2" n="N002"/>Herꝛ Waſer uns iſt deſſen ein Exempel/
               <lb facs="#facs_16_tr_1_tl_3" n="N003"/>Alß welcher war ein ſchoͤner Weißheit-Tempel/
               <lb facs="#facs_16_tr_1_tl_4" n="N004"/>Und dennoch umgeſchliſſen
               <lb facs="#facs_16_tr_1_tl_5" n="N005"/>Durch diſes Wuͤrgers macht/
               <lb facs="#facs_16_tr_1_tl_6" n="N006"/>Dem nie kein Menſch entriſſen
               <lb facs="#facs_16_tr_1_tl_7" n="N007"/>Wie hoch ers je gebracht.
               <lb facs="#facs_16_tr_1_tl_8" n="N008"/>Erwehnter Herꝛ/ zwar alt und wolbetaget
               <lb facs="#facs_16_tr_1_tl_9" n="N009"/>Wird billich doch von Statt und Land beklaget:
               <lb facs="#facs_16_tr_1_tl_10" n="N010"/>Jhn klagen die Gelehrten:
               <lb facs="#facs_16_tr_1_tl_11" n="N011"/>Der Raht- und Richterſtul;
               <lb facs="#facs_16_tr_1_tl_12" n="N012"/>Alß groſſen Schutzgefehrten;
               <lb facs="#facs_16_tr_1_tl_13" n="N013"/>Jhn klagen Kirch und Schul.
               <lb facs="#facs_16_tr_1_tl_14" n="N014"/>Was Groſſes wir an diſem Herꝛn verloren
               <lb facs="#facs_16_tr_1_tl_15" n="N015"/>Wird nicht geglaubt/ bis daß wir es zuvoren
               <lb facs="#facs_16_tr_1_tl_16" n="N016"/>Mit ſchaden ſelbſt erfahren/
               <lb facs="#facs_16_tr_1_tl_17" n="N017"/>Zu diſer Wunderzeit:
               <lb facs="#facs_16_tr_1_tl_18" n="N018"/>Der Hoͤchſt uns woͤll bewahren
               <lb facs="#facs_16_tr_1_tl_19" n="N019"/>Vor Land- und Glaubensſtreit!
               <lb facs="#facs_16_tr_1_tl_20" n="N020"/>Frau Wittib; Sohn; Herꝛ'n Bruͤder; Nechſtverwandte:
               <lb facs="#facs_16_tr_1_tl_21" n="N021"/>Jhr Toͤchter auch: Jhr Schwiegerſoͤhn; Bekante:
               <lb facs="#facs_16_tr_1_tl_22" n="N022"/>Klagt billich Euers Herꝛen;
               <lb facs="#facs_16_tr_1_tl_23" n="N023"/>Freunds; Bruders; Vatters End:
               <lb facs="#facs_16_tr_1_tl_24" n="N024"/>Wer wil Euch diſes ſperꝛen/
               <lb facs="#facs_16_tr_1_tl_25" n="N025"/>Ohn Gott? Jn Freud Ers wend!
               <lb facs="#facs_16_tr_1_tl_26" n="N026"/>Jm Herꝛen jez uns wider wir erfreuen/
               <lb facs="#facs_16_tr_1_tl_27" n="N027"/>Dieweil Er uns ſo meint mit allen Treuen/
               <lb facs="#facs_16_tr_1_tl_28" n="N028"/>Daß auf ſo groſſes Leide/
               <lb facs="#facs_16_tr_1_tl_29" n="N029"/>Jn Herꝛen Waſers Fall/
               <lb facs="#facs_16_tr_1_tl_30" n="N030"/>Er uns ergezt mit Freude
               <lb facs="#facs_16_tr_1_tl_31" n="N031"/>Durch Herꝛen Hirtzels Wahl.
               <lb facs="#facs_16_tr_1_tl_32" n="N032"/>Nicht minder iſts/ mit Waſern iſt verblichen
               <lb facs="#facs_16_tr_1_tl_33" n="N033"/>Vil Wuͤſſenſchaft: mit Jhm iſt auch gewichen
               <lb facs="#facs_16_tr_2_tl_1" n="N034"/><Catch_word>Jn</Catch_word>
            </ab>
            <pb facs="#facs_17" n="17" xml:id="img_0017"/>
            <ab facs="#facs_17_tr_1" type="">
               <lb facs="#facs_17_tr_1_tl_1" n="N001"/><page_number>16</page_number>
               <lb facs="#facs_17_tr_1_tl_2" n="N002"/>Jn aller ſchwerſten Sachen
               <lb facs="#facs_17_tr_1_tl_3" n="N003"/>Bericht und guter Raht:
               <lb facs="#facs_17_tr_1_tl_4" n="N004"/>Die/ billich/ Sorgen machen
               <lb facs="#facs_17_tr_1_tl_5" n="N005"/>Fuͤr den Gemeinen Staat.
               <lb facs="#facs_17_tr_1_tl_6" n="N006"/>Doch wird uns auch im Hirtzel wol erſetzet
               <lb facs="#facs_17_tr_1_tl_7" n="N007"/>Was traurigeſt im Waſer abgeletzet:
               <lb facs="#facs_17_tr_1_tl_8" n="N008"/>Deß mag ſich wider freuen
               <lb facs="#facs_17_tr_1_tl_9" n="N009"/>Das gantze Vatterland:
               <lb facs="#facs_17_tr_1_tl_10" n="N010"/>Es kan die Freud verneuen
               <lb facs="#facs_17_tr_1_tl_11" n="N011"/>Jm ſelben jeder Stand!
               <lb facs="#facs_17_tr_1_tl_12" n="N012"/>Der Hoͤchſt Regent woͤll diſem Herꝛen geben
               <lb facs="#facs_17_tr_1_tl_13" n="N013"/>Geſunde Tag'/ und Hirſchenlanges Leben;
               <lb facs="#facs_17_tr_1_tl_14" n="N014"/>Deßgleichen dem Mitt-Herꝛen
               <lb facs="#facs_17_tr_1_tl_15" n="N015"/>Auf gleichem Ehrenthron!
               <lb facs="#facs_17_tr_1_tl_16" n="N016"/>GOTT woͤll des Wunſchs gewerꝛen
               <lb facs="#facs_17_tr_1_tl_17" n="N017"/>Herꝛn Hirtzeln: Herꝛen Rahn!
               <lb facs="#facs_17_tr_1_tl_18" n="N018"/>Auß herzens innigkeit alſo wuͤn-
               <lb facs="#facs_17_tr_1_tl_19" n="N019"/>ſchende wil ſeine Pflichtgebuͤr hie-
               <lb facs="#facs_17_tr_1_tl_20" n="N020"/>mit abgelegt haben
               <lb facs="#facs_17_tr_1_tl_21" n="N021"/>Jhr Ehrſam Weißheit
               <lb facs="#facs_17_tr_1_tl_22" n="N022"/>Unterthaͤnigſter D.
               <lb facs="#facs_17_tr_1_tl_23" n="N023"/>Johann Wilhelm Simler/
               <lb facs="#facs_17_tr_1_tl_24" n="N024"/>Zuchtmeiſter des Alten/ und <Antiqua>In-
               <lb facs="#facs_17_tr_1_tl_25" n="N025"/>tendens</Antiqua> des Neuen <Antiqua>Collegi</Antiqua>ums.
               <lb facs="#facs_17_tr_1_tl_26" n="N026"/><Catch_word>Vor-</Catch_word>
            </ab>
