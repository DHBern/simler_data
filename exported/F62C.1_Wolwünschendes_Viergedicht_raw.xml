         <div>
            <pb facs="#facs_1" n="1" xml:id="img_0001"/>
            <pb facs="#facs_2" n="2" xml:id="img_0002"/>
            <ab facs="#facs_2_r_1" type="">
               <lb facs="#facs_2_l_6" n="N001"/><Antiqua>ARA ET ARRHA VOTIVA,
               <lb facs="#facs_2_l_7" n="N002"/><italic>Viro Reverendo &amp; Clarißimo,</italic>
               <lb facs="#facs_2_l_8" n="N003"/>DN. GEORGIO MULLERO,
               <lb facs="#facs_2_l_9" n="N004"/>Eccleſiæ Talvillanæ Paſtori fideliſſimo, Capituli ad lacum
               <lb facs="#facs_2_l_10" n="N005"/>Tigurinum Decano meritiſſimo;
               <lb facs="#facs_2_l_11" n="N006"/>SPONSO:
               <lb facs="#facs_2_l_12" n="N007"/><italic>Et Lectißimæ Virgini,</italic>
               <lb facs="#facs_2_l_13" n="N008"/>ELISABETHÆ</Antiqua> Kolerin/
               <lb facs="#facs_2_l_14" n="N009"/><Antiqua><italic>Viri Reverendi &amp; Clarißimi,</italic>
               <lb facs="#facs_2_l_15" n="N010"/>DN. JOHANNIS FELICIS COLERI,
               <lb facs="#facs_2_l_16" n="N011"/>p.m. Eccleſiæ Muranæ ad lacum Gryphæum
               <lb facs="#facs_2_l_17" n="N012"/>Miniſtri vigilantiſſimi, filiæ;
               <lb facs="#facs_2_l_18" n="N013"/>SPONSÆ:
               <lb facs="#facs_2_l_19" n="N014"/><italic>Ab Amicis, Affinibus, &amp;c. Die Nuptiali, quæ est</italic> 9. <italic>Decembris,</italic> 1662. <italic>conſecrata.</italic></Antiqua>
            </ab>
            <ab facs="#facs_2_r" type="">
               <lb facs="#facs_2_l" n="N001"/>Segenwuͤnſchendes Viergeticht.
               <lb facs="#facs_2_l_1" n="N002"/><Initial_letter>D</Initial_letter>Je Kolen ſind begehrt: Herꝛ Muͤller wußt es wol/
               <lb facs="#facs_2_l_2" n="N003"/>drum hat er ſich bey zeit/ verſehn mit eignem Kol:
               <lb facs="#facs_2_l_3" n="N004"/>Wir wuͤnſchen gluͤk darzu! Wir wuͤnſchen Moͤllerlein/
               <lb facs="#facs_2_l_4" n="N005"/>und; weilen die zu weiß; auch halbe Koͤllerlein!
               <lb facs="#facs_2_l_5" n="N006"/>Auß ſchuldiger wolmeinung von Johann Wilhelm Simler.
            </ab>
            <pb facs="#facs_3" n="3" xml:id="img_0003"/>
         </div>
      </body>
   </text>
