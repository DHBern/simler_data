            <pb facs="#facs_6" n="6" xml:id="img_0006"/>
            <ab facs="#facs_6_tr_1" type="">
               <lb facs="#facs_6_tr_1_tl_9" n="N001"/><Antiqua><Numbering>VI.</Numbering></Antiqua>
               <lb facs="#facs_6_tr_1_tl_10" n="N002"/>Klinggedichte.
               <lb facs="#facs_6_tr_1_tl_11" n="N003"/><Initial_letter>E</Initial_letter><Bold>S ſchallet viler Nam͂ noch heut in aller Welt;</Bold>
               <lb facs="#facs_6_tr_1_tl_12" n="N004"/>mit nicht geringem Ruͦhm; die doch dem Menſchen-orden
               <lb facs="#facs_6_tr_1_tl_13" n="N005"/>laͤngſt gute nacht geſagt; zu ſtaub und gar nichts worden:
               <lb facs="#facs_6_tr_1_tl_14" n="N006"/>worunder ſonderlich <Bold>Herꝛ Gwalther</Bold> wird gezellt/
               <lb facs="#facs_6_tr_1_tl_15" n="N007"/>deß <Bold>Feſtenbuͦch</Bold> dem freund und feinde wol gefellt/
               <lb facs="#facs_6_tr_1_tl_16" n="N008"/>vom Oſten biß zum Weſt; vom Suden bis zum Norden;
               <lb facs="#facs_6_tr_1_tl_17" n="N009"/>weils weyßt den <Bold>Lebenswaͤg</Bold>; entdeckt die Seelen-morden:
               <lb facs="#facs_6_tr_1_tl_18" n="N010"/>drumb des Erfinders lob noch heute widergellt.
               <lb facs="#facs_6_tr_1_tl_19" n="N011"/><Bold>Herꝛn Weyſſen</Bold> edler Geiſt geleiche ſtaffel ſteiget/
               <lb facs="#facs_6_tr_1_tl_20" n="N012"/>in dem er Chriſtus Lehr und Leben nicht verſchweiget/
               <lb facs="#facs_6_tr_1_tl_21" n="N013"/>hiemit den <Bold>Waͤg zum heil</Bold> uns andern klaͤrlich weyßt.
               <lb facs="#facs_6_tr_1_tl_22" n="N014"/>Fahrt fort auf diſer Bahn/ die ihr euch habt erkoren/
               <lb facs="#facs_6_tr_1_tl_23" n="N015"/>ſo wird/ auß <Bold>Felix</Bold>/ einſt ein <Bold>Fenix</Bold> neugeboren;
               <lb facs="#facs_6_tr_1_tl_24" n="N016"/>das iſt; wie jennes Nam; wird euer ſeyn gepreyßt.
               <lb facs="#facs_6_tr_1_tl_25" n="N017"/>Zu wol verdienten Ehren ſeinem groſſen Goͤnner
               <lb facs="#facs_6_tr_1_tl_26" n="N018"/>ſetzte diſes hertz-wolmeinlich
               <lb facs="#facs_6_tr_1_tl_27" n="N019"/>Johañ-Wilhelm Simler.
            </ab>
