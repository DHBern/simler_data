            <ab facs="#facs_15_tr_1" type="">
               <lb facs="#facs_15_tr_1_tl_1" n="N001"/>Lob-gedicht
               <lb facs="#facs_15_tr_1_tl_2" n="N002"/><unclear reason="Der\u0020Umlaut\u0020ist\u0020nicht\u0020zu\u0020erkennen,\u0020aber\u0020wahrscheinlich\u0020\u0022e\u0022" alternative="uͦ">uͤ</unclear>ber Herꝛen Conrad Meyers
               <lb facs="#facs_15_tr_1_tl_3" n="N003"/>Chriſten-ſpiegel.
               <lb facs="#facs_15_tr_1_tl_4" n="N004"/><Initial_letter>N</Initial_letter><Antiqua>U</Antiqua>n gibet abermal des <Bold>Herꝛen Meyers</Bold> fleiß
               <lb facs="#facs_15_tr_1_tl_5" n="N005"/>ein Werklein an das liecht/ dem billich hoͤrt der preiß
               <lb facs="#facs_15_tr_1_tl_6" n="N006"/>daß es zu rechter zeit/ kunſtmaͤſſig ſey gegeben:
               <lb facs="#facs_15_tr_1_tl_7" n="N007"/><Bold>Herꝛ'n Müllers</Bold> Po<unclear alternative="ë" reason="Die Pünktchen über dem e sind wahrscheinlich Flecken. In der Ausgabe C sind sie nicht vorhanden.">e</unclear>ſie mittheilet ihm das leben
               <lb facs="#facs_15_tr_1_tl_8" n="N008"/>und einen ſolchen glantz/ der auch im hertzen zeigt
               <lb facs="#facs_15_tr_1_tl_9" n="N009"/>die ſünden-maaſen/ und zur Chriſten-pflicht uns neigt.
               <lb facs="#facs_15_tr_1_tl_10" n="N010"/>Fahrt fort/ fahrt beide fort mit etzen und mit dichten/
               <lb facs="#facs_15_tr_1_tl_11" n="N011"/>und ſchlaget in den wind Neidhammels ſplitter-richten/
               <lb facs="#facs_15_tr_1_tl_12" n="N012"/>ſo machet ihr ihn ſtumm/ und krieget noch zu lohn
               <lb facs="#facs_15_tr_1_tl_13" n="N013"/>der Hochgelehrten gunſt; er aber ſpott und hohn:
               <lb facs="#facs_15_tr_1_tl_14" n="N014"/>es wird auch ieder drauf ein Lorberzweig erwerben/
               <lb facs="#facs_15_tr_1_tl_15" n="N015"/>und euer beider Namm der ſterbligkeit abſterben.
               <lb facs="#facs_15_tr_1_tl_16" n="N016"/>Zum Merkmahl beharꝛlicher Freundſchafft
               <lb facs="#facs_15_tr_1_tl_17" n="N017"/>aufgeſetzt
               <lb facs="#facs_15_tr_1_tl_18" n="N018"/>von
               <lb facs="#facs_15_tr_1_tl_19" n="N019"/>Joh. Wilhelm Simler.
            </ab>
