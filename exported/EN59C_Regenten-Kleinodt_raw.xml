               <lb facs="#facs_2_tr_2_tl_52" n="N010"/>gib dem Koͤnig/ Koͤnigs-ſohn/
               <lb facs="#facs_2_tr_2_tl_59" n="N011"/>dein gericht und rechte:
               <lb facs="#facs_2_l_50" n="N012"/>daß er/ nach der billichkeit/
               <lb facs="#facs_2_tr_2_tl_79" n="N013"/>dein volk mit beſcheidenheit/
               <lb facs="#facs_2_tr_2_tl_87" n="N014"/>richt/ regier/ verfechte.
               <lb facs="#facs_2_tr_2_tl_32" n="N015"/><Antiqua><Small_capitals><Spaced_letters>ALTUS.<Small_capitals/></Spaced_letters><Small_capitals/></Small_capitals><Small_capitals/><Spaced_letters/></Antiqua><Spaced_letters/>
