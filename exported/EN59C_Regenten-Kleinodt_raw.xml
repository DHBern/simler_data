               <lb facs="#facs_2_l_30" n="N022"/><Antiqua><Small_capitals><Spaced_letters>BASIS.<Small_capitals/></Spaced_letters><Small_capitals/></Small_capitals><Small_capitals/><Spaced_letters/></Antiqua><Spaced_letters/>
               <lb facs="#facs_2_tr_2_tl_44" n="N023"/>Herꝛſcher auf dem hoͤchſten thron/
               <lb facs="#facs_2_tr_2_tl_51" n="N024"/>gib dem Koͤnig/ Koͤnigs-ſohn/
               <lb facs="#facs_2_tr_2_tl_58" n="N025"/>dein gericht und rechte:
               <lb facs="#facs_2_l_88" n="N026"/>daß er/ nach der billichkeit/
               <lb facs="#facs_2_tr_2_tl_76" n="N027"/>dein volk mit beſcheidenheit/
               <lb facs="#facs_2_tr_2_tl_88" n="N028"/>richt/ regier/ verfechte.
            </ab>
            <ab facs="#facs_2_r_13" type="">
               <lb facs="#facs_2_tr_2_tl_90" n="N001"/>Diſer Pſalm mag auch geſungen werden in der Geſangweiſe:
               <lb facs="#facs_2_tr_2_tl_91" n="N002"/>Jeſus/ waarer Gottes Sohn/ ꝛc.
            </ab>
            <ab facs="#facs_2_r_7" type="">
               <lb facs="#facs_2_l_16" n="N001"/>David bittet
               <lb facs="#facs_2_l_20" n="N002"/>fuͤr Salom<comment comment="Teilweise fehlende Tinte.">o</comment>n:
               <lb facs="#facs_2_l_24" n="N003"/>daß Gott ihn
               <lb facs="#facs_2_l_28" n="N004"/>begaabe 1. mit
               <lb facs="#facs_2_l_32" n="N005"/>Gerechtigkeit.
               <lb facs="#facs_2_l_36" n="N006"/>2. Jhm oͤffne
               <lb facs="#facs_2_l_40" n="N007"/>ſeine Gerichte:
               <lb facs="#facs_2_l_44" n="N008"/>und lehrt hie-
               <lb facs="#facs_2_l_48" n="N009"/>mit alle Re-
               <lb facs="#facs_2_l_52" n="N010"/>genten/ wie ſie
               <lb facs="#facs_2_l_56" n="N011"/>regieren ſollen.
               <lb facs="#facs_2_l_64" n="N012"/>Fruͤcht eines
               <lb facs="#facs_2_l_68" n="N013"/>rechten Regi-
               <lb facs="#facs_2_l_72" n="N014"/>ments.
               <lb facs="#facs_2_l_76" n="N015"/>1. Frid und Ge-
               <lb facs="#facs_2_l_80" n="N016"/>rechtigkeit.
               <lb facs="#facs_2_l_84" n="N017"/>2. Schutz der
               <lb facs="#facs_2_l_89" n="N018"/>armen.
               <lb facs="#facs_2_l_8" n="N019"/>3. Waarer
               <lb facs="#facs_2_l_12" n="N020"/>glaub und Got-
               <lb facs="#facs_2_l_17" n="N021"/>tesforcht.
               <lb facs="#facs_2_l_22" n="N022"/>4. Gemeiner
               <lb facs="#facs_2_l_26" n="N023"/>wolſtand und
               <lb facs="#facs_2_l_31" n="N024"/>verbeſſerung
               <lb facs="#facs_2_l_35" n="N025"/>aller maͤng-
               <lb facs="#facs_2_l_39" n="N026"/>len.
            </ab>
            <ab facs="#facs_2_r_8" type="">
               <lb facs="#facs_2_tr_2_tl_93" n="N001"/><Initial_letter>H</Initial_letter>Erꝛſcher auf dem hoͤchſten thron/
               <lb facs="#facs_2_tr_2_tl_95" n="N002"/>gib dem Koͤnig/ Koͤnigs-ſohn
               <lb facs="#facs_2_tr_2_tl_98" n="N003"/>dein gericht und rechte:
               <lb facs="#facs_2_tr_2_tl_101" n="N004"/>daß er/ nach der billichkeit/
               <lb facs="#facs_2_tr_2_tl_104" n="N005"/>dein volk mit beſcheidenheit/
               <lb facs="#facs_2_tr_2_tl_107" n="N006"/>richt/ regier/ verfechte.
               <lb facs="#facs_2_tr_2_tl_110" n="N007"/>Daß er/ nach gewiſſen/ richt/
               <lb facs="#facs_2_tr_2_tl_113" n="N008"/>reich- und armer haͤndel ſchlicht/
               <lb facs="#facs_2_tr_2_tl_116" n="N009"/>ohn perſon anſehen:
               <lb facs="#facs_2_tr_2_tl_119" n="N010"/>alßdann werden uͤberal/
               <lb facs="#facs_2_tr_2_tl_122" n="N011"/>ſo zu berge/ ſo zu thal/
               <lb facs="#facs_2_tr_2_tl_125" n="N012"/>Frid und Recht aufgehen.
               <lb facs="#facs_2_tr_2_tl_128" n="N013"/>Diſer Koͤnig/ from͂ und frey/
               <lb facs="#facs_2_tr_2_tl_131" n="N014"/>wird den armen ſtehen bey
               <lb facs="#facs_2_tr_2_tl_134" n="N015"/>wider gwalt auf erden:
               <lb facs="#facs_2_tr_2_tl_137" n="N016"/>laͤſterer und boͤſewicht
               <lb facs="#facs_2_tr_2_tl_140" n="N017"/>werden/ durch ſein ſtreng gericht/
               <lb facs="#facs_2_tr_2_tl_143" n="N018"/>gantz vertilget werden.
               <lb facs="#facs_2_tr_2_tl_146" n="N019"/>Jederman mit forchten ihn
               <lb facs="#facs_2_tr_2_tl_149" n="N020"/>wird verehren foͤrterhin
               <lb facs="#facs_2_tr_2_tl_152" n="N021"/>von geſchlecht zu gſchlechte:
               <lb facs="#facs_2_tr_2_tl_155" n="N022"/>ihme wird man ghorſam ſeyn/
               <lb facs="#facs_2_tr_2_tl_159" n="N023"/>weil der Mond- und Sonnenſchein
               <lb facs="#facs_2_tr_2_tl_162" n="N024"/>halten ihre Rechte.
               <lb facs="#facs_2_tr_2_tl_165" n="N025"/>Einem Regen er geleicht/
               <lb facs="#facs_2_tr_2_tl_168" n="N026"/>der von oben ab befeucht
               <lb facs="#facs_2_tr_2_tl_171" n="N027"/>abgemaͤyte wiſen:
               <lb facs="#facs_2_tr_2_tl_174" n="N028"/>und den tropfen/ die das graß
               <lb facs="#facs_2_tr_2_tl_177" n="N029"/>machen friſch und lieblich naß/
               <lb facs="#facs_2_tr_2_tl_180" n="N030"/>wird er gleich gepriſen.
            </ab>
            <ab facs="#facs_2_r_19" type="">
               <lb facs="#facs_2_l_9" n="N001"/>5. Mehrung
               <lb facs="#facs_2_l_13" n="N002"/>des Reychs.
               <lb facs="#facs_2_l_23" n="N003"/>Wideraͤferung
               <lb facs="#facs_2_l_27" n="N004"/>der eigenſchaf-
               <lb facs="#facs_2_l_33" n="N005"/>ten eines guten
               <lb facs="#facs_2_l_37" n="N006"/>Regenten/ da-
               <lb facs="#facs_2_l_41" n="N007"/>rauß vorge-
               <lb facs="#facs_2_l_45" n="N008"/>meldte Fruͤcht
               <lb facs="#facs_2_l_49" n="N009"/>entſpringen.
               <lb facs="#facs_2_l_10" n="N010"/>Belohnung ei-
               <lb facs="#facs_2_l_14" n="N011"/>nes trewen Re-
               <lb facs="#facs_2_l_18" n="N012"/>genten.
               <lb facs="#facs_2_l_25" n="N013"/>1. Langes Le-
               <lb facs="#facs_2_l_29" n="N014"/>ben.
               <lb facs="#facs_2_l_34" n="N015"/>2. Reichtage.
               <lb facs="#facs_2_l_38" n="N016"/>3. Gunſt und
               <lb facs="#facs_2_l_42" n="N017"/>ehre.
            </ab>
            <ab facs="#facs_2_r_52" type="">
               <lb facs="#facs_2_tr_2_tl_92" n="N001"/>Nun/ zu diſes Koͤnigs zeit/
               <lb facs="#facs_2_tr_2_tl_97" n="N002"/>wird der grechte/ ſonder ſtreit/
               <lb facs="#facs_2_tr_2_tl_99" n="N003"/>in dem wolſtand gruͤnen:
               <lb facs="#facs_2_tr_2_tl_102" n="N004"/>eitel Frid ſo lang wird ſeyn
               <lb facs="#facs_2_tr_2_tl_105" n="N005"/>alß verbleibt des Mondes ſchein
               <lb facs="#facs_2_tr_2_tl_108" n="N006"/>an der Himmels-buͤhnen.
               <lb facs="#facs_2_tr_2_tl_111" n="N007"/>Er wird herꝛſchen nah und fehr/
               <lb facs="#facs_2_tr_2_tl_114" n="N008"/>ja/ von eim zum andern Meer/
               <lb facs="#facs_2_tr_2_tl_117" n="N009"/>bis ans end der Erden:
               <lb facs="#facs_2_tr_2_tl_120" n="N010"/>fremde voͤlker/ freund und feind/
               <lb facs="#facs_2_tr_2_tl_123" n="N011"/>undertaͤhnig ihm geſchwind
               <lb facs="#facs_2_tr_2_tl_126" n="N012"/>zfuͤſſen fallen werden.
               <lb facs="#facs_2_tr_2_tl_129" n="N013"/>Meer- und Jnslen-koͤnig ſich
               <lb facs="#facs_2_tr_2_tl_132" n="N014"/>mit geſchaͤnke williglich
               <lb facs="#facs_2_tr_2_tl_135" n="N015"/>freygaͤb ihm erzeigen:
               <lb facs="#facs_2_tr_2_tl_138" n="N016"/>alle koͤnig in gemein/
               <lb facs="#facs_2_tr_2_tl_141" n="N017"/>ſamt den Heiden/ ihn allein
               <lb facs="#facs_2_tr_2_tl_144" n="N018"/>baͤtten an mit neigen.
               <lb facs="#facs_2_tr_2_tl_148" n="N019"/>Dann den arm-verlaßnen mann
               <lb facs="#facs_2_tr_2_tl_150" n="N020"/>wird er retten/ und fortan
               <lb facs="#facs_2_tr_2_tl_153" n="N021"/>ſchonen des geringen:
               <lb facs="#facs_2_tr_2_tl_156" n="N022"/>vor gewalt und liſt in hut
               <lb facs="#facs_2_tr_2_tl_160" n="N023"/>arme nemmen/ und ihr blut
               <lb facs="#facs_2_tr_2_tl_163" n="N024"/>vorziehn allen dingen.
               <lb facs="#facs_2_tr_2_tl_166" n="N025"/>Er wird leben/ und zugleich
               <lb facs="#facs_2_tr_2_tl_169" n="N026"/>wird ihm das Arabiſch Reych
               <lb facs="#facs_2_tr_2_tl_173" n="N027"/>gold-geſchaͤnke bringen:
               <lb facs="#facs_2_tr_2_tl_175" n="N028"/>ieder auch/ fuͤr ſeinen theil/
               <lb facs="#facs_2_tr_2_tl_178" n="N029"/>Gottes ſaͤgen/ gluͤk und heil
               <lb facs="#facs_2_tr_2_tl_181" n="N030"/>wuͤnſchen mit lobſingen<comment comment="Tintenabdruck über dem Punkt.">.</comment>
            </ab>
            <ab facs="#facs_2_r_5" type="">
               <lb facs="#facs_2_l_4" n="N001"/>4. Fruchtbar-
               <lb facs="#facs_2_l_11" n="N002"/>keit des Lands.
               <lb facs="#facs_2_l_15" n="N003"/>5. Mehrung
               <lb facs="#facs_2_l_19" n="N004"/>des Volks.
               <lb facs="#facs_2_l_43" n="N005"/>6. Ehrlicher
               <lb facs="#facs_2_l_47" n="N006"/>Nam̃/ und lob-
               <lb facs="#facs_2_l_51" n="N007"/>liches gedaͤcht-
               <lb facs="#facs_2_l_55" n="N008"/>nuß under allen
               <lb facs="#facs_2_l_59" n="N009"/>voͤlkern.
               <lb facs="#facs_2_l_63" n="N010"/>Untertahnen
               <lb facs="#facs_2_l_67" n="N011"/>ſollen Gott lo-
               <lb facs="#facs_2_l_71" n="N012"/>ben/ und ihm
               <lb facs="#facs_2_l_75" n="N013"/>danken wann
               <lb facs="#facs_2_l_79" n="N014"/>er gute Regen-
               <lb facs="#facs_2_l_83" n="N015"/>ten und Oberen
               <lb facs="#facs_2_l_87" n="N016"/>gibt.
            </ab>
            <ab facs="#facs_2_r_17" type="">
               <lb facs="#facs_2_tr_2_tl_94" n="N001"/>Wirfft man auß/ auf duͤrꝛer heid/
               <lb facs="#facs_2_tr_2_tl_96" n="N002"/>eine handfol vom getreid/
               <lb facs="#facs_2_tr_2_tl_100" n="N003"/>wirds vil fruͤchte geben:
               <lb facs="#facs_2_tr_2_tl_103" n="N004"/>die/ wie baͤum auf Libanon/
               <lb facs="#facs_2_tr_2_tl_106" n="N005"/>von dem wind beweget ſchon/
               <lb facs="#facs_2_tr_2_tl_109" n="N006"/>ein geraͤuſch erheben.
               <lb facs="#facs_2_tr_2_tl_112" n="N007"/>Wolbewohnte Staͤtte man/
               <lb facs="#facs_2_tr_2_tl_115" n="N008"/>gruͤnend wie das graß voran/
               <lb facs="#facs_2_tr_2_tl_118" n="N009"/>foͤrterhin wird ſehen:
               <lb facs="#facs_2_tr_2_tl_121" n="N010"/>Diſes Koͤnigs Nam͂ ſo lang/
               <lb facs="#facs_2_tr_2_tl_124" n="N011"/>alß die Sonn behalt den gang/
               <lb facs="#facs_2_tr_2_tl_127" n="N012"/>bleibet ohn vergehen.
               <lb facs="#facs_2_tr_2_tl_130" n="N013"/>Alle voͤlker werden ſich
               <lb facs="#facs_2_tr_2_tl_133" n="N014"/>in ihm ſaͤgnen ewiglich/
               <lb facs="#facs_2_tr_2_tl_136" n="N015"/>und ihn ſelig preiſen:
               <lb facs="#facs_2_tr_2_tl_139" n="N016"/>Jſraels Gott in der Gmein/
               <lb facs="#facs_2_tr_2_tl_142" n="N017"/>weil er wunder wuͤrkt allein/
               <lb facs="#facs_2_tr_2_tl_145" n="N018"/>ſol man ehr beweiſen.
               <lb facs="#facs_2_tr_2_tl_147" n="N019"/>Hochgelobet immer werd
               <lb facs="#facs_2_tr_2_tl_151" n="N020"/>ſein ſo werther Nam͂ auf Erd
               <lb facs="#facs_2_tr_2_tl_154" n="N021"/>von uns allenſamen:
               <lb facs="#facs_2_tr_2_tl_158" n="N022"/>Alles land von ſeiner Ehr
               <lb facs="#facs_2_tr_2_tl_161" n="N023"/>werd erfuͤllet mehr/ und mehr/
               <lb facs="#facs_2_tr_2_tl_164" n="N024"/>ietz und ewig/ Amen!
            </ab>
            <ab facs="#facs_2_r_2" type="">
               <lb facs="#facs_2_tr_2_tl_167" n="N001"/>Getrukt in dem Fridenwuͤnſchenden
               <lb facs="#facs_2_tr_2_tl_172" n="N002"/>Heiljahr:
               <lb facs="#facs_2_tr_2_tl_176" n="N003"/>Herꝛ Rahn <Antiqua>V</Antiqua>ns <Antiqua>L</Antiqua>ange ze<Antiqua>I</Antiqua>t <Antiqua>IM</Antiqua> Fr<Antiqua>ID</Antiqua>en
               <lb facs="#facs_2_tr_2_tl_179" n="N004"/>re<Antiqua>C</Antiqua>ht reg<Antiqua>I</Antiqua>er.
            </ab>
         </div>
      </body>
   </text>
