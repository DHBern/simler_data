               <lb facs="#facs_2_tr_2_tl_40" n="N002"/>Herꝛſcher auf dem hoͤchſten thron/
               <lb facs="#facs_2_tr_2_tl_49" n="N003"/>gib dem Koͤnig/ Koͤnigs-ſohn/
               <lb facs="#facs_2_tr_2_tl_57" n="N004"/>dein gericht und rechte:
               <lb facs="#facs_2_tr_2_tl_68" n="N005"/>daß er/ nach der billichkeit/
               <lb facs="#facs_2_tr_2_tl_75" n="N006"/>dein volk mit beſcheidenheit/
               <lb facs="#facs_2_tr_2_tl_85" n="N007"/>richt/ regier/ verfechte.
               <lb facs="#facs_2_l_21" n="N008"/><Antiqua><Small_capitals><Spaced_letters>TENOR.<Small_capitals/></Spaced_letters><Small_capitals/></Small_capitals><Small_capitals/><Spaced_letters/></Antiqua><Spaced_letters/>
