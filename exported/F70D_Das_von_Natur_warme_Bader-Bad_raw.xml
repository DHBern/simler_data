   <text>
      <body>
         <div>
            <pb facs="#facs_1" n="1" xml:id="img_0001"/>
            <pb facs="#facs_2" n="2" xml:id="img_0002"/>
            <ab facs="#facs_2_tr_1" type="">
               <lb facs="#facs_2_tr_1_tl_1" n="N001"/>Ehren- und
               <lb facs="#facs_2_tr_1_tl_3" n="N002"/>Wunſch-geſang/
               <lb facs="#facs_2_tr_1_tl_4" n="N003"/>Als von Jhr Ehrſam Weißheit/
               <lb facs="#facs_2_tr_1_tl_5" n="N004"/>Herꝛn Burgermeiſter
               <lb facs="#facs_2_tr_1_tl_6" n="N005"/>Johann Conrad Grebel/
               <lb facs="#facs_2_tr_1_tl_7" n="N006"/>Auch anderen anſehenlichen Herꝛen/
               <lb facs="#facs_2_tr_1_tl_8" n="N007"/>Geiſt- und Weltlichen Standes/
               <lb facs="#facs_2_tr_1_tl_9" n="N008"/>Loblicher Stadt Zuͤrich/
               <lb facs="#facs_2_tr_1_tl_10" n="N009"/>Das von Natur warme Bader-bad/
               <lb facs="#facs_2_tr_1_tl_11" n="N010"/>im 1670. Heil-jahr gebraucht
               <lb facs="#facs_2_tr_1_tl_12" n="N011"/><supplied reason="">ward</supplied>.
               <lb facs="#facs_2_tr_1_tl_13" n="N012"/>Jn bekannter Geſang-weiſe:
               <lb facs="#facs_2_tr_1_tl_14" n="N013"/>So wuͤnſch ich jhr ein gute Nacht/ ꝛc.
               <lb facs="#facs_2_tr_1_tl_15" n="N014"/>Gedruckt im Jahr 1670.
            </ab>
            <pb facs="#facs_3" n="3" xml:id="img_0003"/>
            <pb facs="#facs_4" n="4" xml:id="img_0004"/>
            <ab facs="#facs_4_tr_1" type="">
               <lb facs="#facs_4_l" n="N001"/><Numbering>1.</Numbering>
               <lb facs="#facs_4_tr_1_tl_3" n="N002"/><Initial_letter>H</Initial_letter>Eilwaſſer in dem Baderloch/
               <lb facs="#facs_4_tr_1_tl_4" n="N003"/>Vom Legerberg gefloſſen:
               <lb facs="#facs_4_tr_1_tl_7" n="N004"/>Befreyt/ und doch/ mit ſanfftem Joch/
               <lb facs="#facs_4_tr_1_tl_8" n="N005"/>Regiert von Eidgenoſſen:
               <lb facs="#facs_4_tr_1_tl_9" n="N006"/>Ein Schwefel-quall/
               <lb facs="#facs_4_tr_1_tl_10" n="N007"/>Jn tieffem Thal/
               <lb facs="#facs_4_tr_1_tl_11" n="N008"/>Und Bergen/ wie verſchloſſen.
               <lb facs="#facs_4_l_1" n="N009"/><Numbering>2.</Numbering>
               <lb facs="#facs_4_tr_1_tl_12" n="N010"/>Durch die von Gott ertheilte Krafft
               <lb facs="#facs_4_tr_1_tl_13" n="N011"/>Viel Leuth in dir geneſen:
               <lb facs="#facs_4_tr_1_tl_14" n="N012"/>Zuſeyn auch jetzt untadelhafft;
               <lb facs="#facs_4_tr_1_tl_15" n="N013"/>Wie mehrmal du geweſen;
               <lb facs="#facs_4_tr_1_tl_16" n="N014"/>Auffnimm die Pfand
               <lb facs="#facs_4_tr_1_tl_17" n="N015"/>Vom Vatterland/
               <lb facs="#facs_4_tr_1_tl_18" n="N016"/>Auß vielen wol erleſen.
               <lb facs="#facs_4_l_2" n="N017"/><Numbering>3.</Numbering>
               <lb facs="#facs_4_tr_1_tl_19" n="N018"/>Es ſuchen nun auch dieſes mal;
               <lb facs="#facs_4_tr_1_tl_20" n="N019"/>Jn dir geſund zu werden;
               <lb facs="#facs_4_tr_1_tl_21" n="N020"/>Die Erſten auß der Vaͤttern Zahl/
               <lb facs="#facs_4_tr_1_tl_22" n="N021"/>Die Hoffnung unſrer Erden/
               <lb facs="#facs_4_tr_1_tl_23" n="N022"/>Durch Freundlichkeit/
               <lb facs="#facs_4_tr_1_tl_24" n="N023"/>Beſcheidenheit/
               <lb facs="#facs_4_tr_1_tl_25" n="N024"/>Zu wenden Bads Beſchwerden.
               <lb facs="#facs_4_l_3" n="N025"/><Pagination>)( ij</Pagination>
               <lb facs="#facs_4_tr_1_tl_26" n="N026"/><Catch_word><Numbering>4.</Numbering> Du</Catch_word>
            </ab>
            <pb facs="#facs_5" n="5" xml:id="img_0005"/>
            <ab facs="#facs_5_tr_1" type="">
               <lb facs="#facs_5_tr_1_tl_1" n="N001"/><Header>Bader-geſang.</Header>
               <lb facs="#facs_5_l" n="N002"/><Numbering>4.</Numbering>
               <lb facs="#facs_5_tr_1_tl_2" n="N003"/>Du wirſt erlangen Ehr und Danck/
               <lb facs="#facs_5_tr_1_tl_3" n="N004"/>Mit fleiſſigem verpflegen
               <lb facs="#facs_5_tr_1_tl_4" n="N005"/>An denen uns; geſund und kranck;
               <lb facs="#facs_5_tr_1_tl_5" n="N006"/>Nicht wenig iſt gelegen:
               <lb facs="#facs_5_tr_1_tl_6" n="N007"/>Der Hoͤchſte dich
               <lb facs="#facs_5_tr_1_tl_7" n="N008"/>Gantz kraͤfftiglich
               <lb facs="#facs_5_tr_1_tl_8" n="N009"/>Erfuͤll mit ſeinem Segen!
               <lb facs="#facs_5_l_1" n="N010"/><Numbering>5.</Numbering>
               <lb facs="#facs_5_tr_1_tl_9" n="N011"/>Schicks wider heim geſund uñ friſch/
               <lb facs="#facs_5_tr_1_tl_10" n="N012"/>Daß ſich die Wuͤnſch' erwahren:
               <lb facs="#facs_5_tr_1_tl_11" n="N013"/>Geſegnet bleib jhr Hauß und Tiſch/
               <lb facs="#facs_5_tr_1_tl_12" n="N014"/>Befreyet von Gefahren!
               <lb facs="#facs_5_tr_1_tl_13" n="N015"/>Gott Sie erfrew
               <lb facs="#facs_5_tr_1_tl_14" n="N016"/>Mit Gnad und Trew/
               <lb facs="#facs_5_tr_1_tl_15" n="N017"/>Mit Frieden in den Thoren!
               <lb facs="#facs_5_tr_1_tl_18" n="N018"/><Spaced_letters>ENDE.</Spaced_letters>
            </ab>
         </div>
      </body>
   </text>
