            <ab facs="#facs_2_r_1" type="">
               <lb facs="#facs_2_tr_1_tl_15" n="N001"/>OECONOMIA,
               <lb facs="#facs_2_tr_1_tl_16" n="N002"/>Oder Poetiſch Geſang/ von Chriſtlichem Haußweſen:
               <lb facs="#facs_2_tr_1_tl_17" n="N003"/>Nebend freundtlicher Gluͤckwünſchung/
               <lb facs="#facs_2_tr_1_tl_18" n="N004"/>Zu Ehren geſtellt
               <lb facs="#facs_2_tr_1_tl_19" n="N005"/>Dem Frommen/ Ehrenveſten vnd Weyſen/
               <lb facs="#facs_2_tr_1_tl_20" n="N006"/>Herꝛen Hans Heinrich Rahnen
               <lb facs="#facs_2_tr_1_tl_21" n="N007"/>des Loblichen Regiments der Statt Zürich:
               <lb facs="#facs_2_tr_1_tl_22" n="N008"/>Des Hochgeachten/ Frommen/ Veſten/ Fürſichtigen vnd Weyſen Herꝛen/
               <lb facs="#facs_2_tr_1_tl_23" n="N009"/>Hr. Hans Heinrich Rahnen/ des Rahts/ vnd Obmans gemeiner der Statt Zürich
               <lb facs="#facs_2_tr_1_tl_24" n="N010"/>Cloͤſteren/ vielgeliebten Sohn/ alß Herꝛen Hochzeiter:
               <lb facs="#facs_2_tr_1_tl_25" n="N011"/>So dann auch
               <lb facs="#facs_2_tr_1_tl_26" n="N012"/>Der Edlen/ Ehren- vnd Tugendreichen Jungfrauwen/
               <lb facs="#facs_2_tr_1_tl_27" n="N013"/>Jungfr. Eliſabetha Holtzhalbin:
               <lb facs="#facs_2_tr_1_tl_28" n="N014"/>Weyland des Edlen/ Frommen/ Veſten/ Fürſichtigen vnd Weyſen Herꝛen/
               <lb facs="#facs_2_tr_1_tl_29" n="N015"/>Hr. David Holtzhalben Sel.angedenckens/ ehelich hinderlaßner Tochter/
               <lb facs="#facs_2_tr_1_tl_30" n="N016"/>alß Jungfrauw Hochzeiterin.
               <lb facs="#facs_2_tr_1_tl_31" n="N017"/>Auff dero Hochzeitlich Ehren- vnd Frewdenfeſt/ gehalten auff Felicitas den VII. Merzens/
               <lb facs="#facs_2_l" n="N018"/>M CD XLII.
            </ab>
