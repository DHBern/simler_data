   <text>
      <body>
         <div>
            <pb facs="#facs_1" n="1" xml:id="img_0001"/>
            <pb facs="#facs_2" n="2" xml:id="img_0002"/>
            <ab facs="#facs_2_r_21" type="">
               <lb facs="#facs_2_l_848" n="N001"/>j.
               <lb facs="#facs_2_tr_1_tl_12" n="N002"/><Antiqua>Con: Meÿer fecit et excu:
               <lb facs="#facs_2_tr_1_tl_13" n="N003"/>1646</Antiqua>
            </ab>
            <ab facs="#facs_2_tr_1" type="">
               <lb facs="#facs_2_tr_1_tl_15" n="N001"/><Antiqua>Diſcantus.</Antiqua>
               <lb facs="#facs_2_tr_1_tl_23" n="N002"/>Luſtig werden bekuͤmmerte hertzen/
               <lb facs="#facs_2_l_647" n="N003"/>Wañ die guldine Sonnen im Mertzen
               <lb facs="#facs_2_l_651" n="N004"/>Mit dem Widdergeſtirne thuͦt ſchertzen:
               <lb facs="#facs_2_l_655" n="N005"/>Da der leidige Winter vergehet/
               <lb facs="#facs_2_tr_1_tl_59" n="N006"/>Vnd der liebliche Fruͤhling entſtehet/
               <lb facs="#facs_2_l_744" n="N007"/>Den der Zefyr mit Bluͦmen beſaͤyet.
               <lb facs="#facs_2_l" n="N008"/><Antiqua>Altus.</Antiqua>
               <lb facs="#facs_2_tr_1_tl_22" n="N009"/>Luſtig werden bekuͤmmerte hertzen/
               <lb facs="#facs_2_tr_1_tl_30" n="N010"/>Wañ die guldine Sonnen im Mertzen
               <lb facs="#facs_2_tr_1_tl_35" n="N011"/>Mit dem Widdergeſtirne thuͦt ſchertzen:
               <lb facs="#facs_2_tr_1_tl_45" n="N012"/>Da der leidige Winter vergehet/
               <lb facs="#facs_2_tr_1_tl_58" n="N013"/>Vnd der liebliche Fruͤhling entſtehet/
               <lb facs="#facs_2_l_999" n="N014"/>Den der Zefyr mit Bluͦmen beſaͤyet.
               <lb facs="#facs_2_l_787" n="N015"/><Antiqua>Tenor.</Antiqua>
               <lb facs="#facs_2_tr_1_tl_20" n="N016"/>Luſtig werden bekuͤmmerte hertzen/
               <lb facs="#facs_2_tr_1_tl_28" n="N017"/>Wañ die guldine Sonnen im Mertzen
               <lb facs="#facs_2_l_1152" n="N018"/>Mit dem Widdergeſtirne thuͦt ſchertzen:
               <lb facs="#facs_2_l_1160" n="N019"/>Da der leidige Winter vergehet/
               <lb facs="#facs_2_l_1164" n="N020"/>Vnd der liebliche Fruͤhling entſtehet/
               <lb facs="#facs_2_l_1168" n="N021"/>Den der Zefyr mit Bluͦmen beſaͤyet.
               <lb facs="#facs_2_tr_1_tl_14" n="N022"/><Antiqua>Baſis.</Antiqua>
               <lb facs="#facs_2_tr_1_tl_21" n="N023"/>Luſtig werden bekuͤmmerte hertzen/
               <lb facs="#facs_2_l_1329" n="N024"/>Wañ die guldine Sonnen im Mertzen/
               <lb facs="#facs_2_l_1333" n="N025"/>Mit dem Widdergeſtirne thuͦt ſchertzen:
               <lb facs="#facs_2_l_1374" n="N026"/>Da der leidige Winter vergehet/
               <lb facs="#facs_2_tr_1_tl_57" n="N027"/>Vnd der liebliche Fruͤhling entſtehet/
               <lb facs="#facs_2_l_1378" n="N028"/>Den der Zefyr mit Bluͦmen beſaͤyet.
            </ab>
            <ab facs="#facs_2_r" type="">
               <lb facs="#facs_2_l_1916" n="N001"/><Numbering>2.</Numbering>
               <lb facs="#facs_2_tr_1_tl_68" n="N002"/>Jn den Gaͤrten wir ſehen entſprieſſen
               <lb facs="#facs_2_tr_1_tl_71" n="N003"/>Tulipanen/ Violen/ Narciſſen/
               <lb facs="#facs_2_tr_1_tl_74" n="N004"/>Ohne Mahlers Hand/ kuͤnſtlich/ geriſſen:
               <lb facs="#facs_2_tr_1_tl_77" n="N005"/>Wir betaſten die Koͤniges Cronen/
               <lb facs="#facs_2_tr_1_tl_80" n="N006"/>Gilgen/ Tuͤrckiſche Buͤndt/ Anemonen/
               <lb facs="#facs_2_tr_1_tl_83" n="N007"/>Keiner doͤrnichten Roſen wir ſchonen.
               <lb facs="#facs_2_l_2126" n="N008"/><Numbering>3.</Numbering>
               <lb facs="#facs_2_tr_1_tl_86" n="N009"/>Wir bereiten vns Straͤuſſer vnd Meyen/
               <lb facs="#facs_2_tr_1_tl_89" n="N010"/>Vmb die Kraͤntze wir ſingen am Reyen/
               <lb facs="#facs_2_tr_1_tl_92" n="N011"/>Es ertoͤnen die Pfeiffen/ Schalmeyen:
               <lb facs="#facs_2_tr_1_tl_95" n="N012"/>Alles/ Alles in frewden thuͦt leben/
               <lb facs="#facs_2_tr_1_tl_98" n="N013"/>Auſſert newlich geſchnittenen Reben/
               <lb facs="#facs_2_tr_1_tl_101" n="N014"/>Die den Fruͤhling mit weynen anheben.
               <lb facs="#facs_2_l_2148" n="N015"/><Numbering>4.</Numbering>
               <lb facs="#facs_2_tr_1_tl_104" n="N016"/>Junge Saaten vns ſchiereſt anlachen/
               <lb facs="#facs_2_tr_1_tl_107" n="N017"/>Gute hoffnung/ auß vilen vrſachen/
               <lb facs="#facs_2_tr_1_tl_110" n="N018"/>Zu der koͤnfftigen Ernde ſie machen:
               <lb facs="#facs_2_tr_1_tl_113" n="N019"/>Alle Baͤume den Roſen ſich gleichen/
               <lb facs="#facs_2_tr_1_tl_116" n="N020"/>Deren Schoͤne mag nichtes erꝛeichen/
               <lb facs="#facs_2_tr_1_tl_119" n="N021"/>Alles anders derſelben muß weichen.
               <lb facs="#facs_2_l_23" n="N022"/><Numbering>5.</Numbering>
               <lb facs="#facs_2_tr_1_tl_66" n="N023"/>Alle Matten vnd Wieſen Graßreiche/
               <lb facs="#facs_2_tr_1_tl_69" n="N024"/>Alle Buͤhel vnd Berge zugleiche/
               <lb facs="#facs_2_tr_1_tl_72" n="N025"/>Werden Weiden dem nutzlichen Veiche:
               <lb facs="#facs_2_tr_1_tl_75" n="N026"/>Auff den gruͤnen betaweten Awen/
               <lb facs="#facs_2_tr_1_tl_78" n="N027"/>Frewdig ſpringende Herden wir ſchawen/
               <lb facs="#facs_2_tr_1_tl_81" n="N028"/>Die zuͦvoren in Staͤllen geſchrawen.
               <lb facs="#facs_2_l_27" n="N029"/><Numbering>6.</Numbering>
               <lb facs="#facs_2_tr_1_tl_84" n="N030"/>Das gefidderte Voͤlcklein der Luͤffte/
               <lb facs="#facs_2_tr_1_tl_87" n="N031"/>Machet wider erklingen die kluͤffte/
               <lb facs="#facs_2_tr_1_tl_90" n="N032"/>Alß ob Echo denſelbigen ruͤffte:
               <lb facs="#facs_2_tr_1_tl_93" n="N033"/>An die Wolcken die Lerche ſich ſchwinget/
               <lb facs="#facs_2_tr_1_tl_97" n="N034"/>Jhrem Schoͤpffer zu ehren ſie ſinget/
               <lb facs="#facs_2_tr_1_tl_99" n="N035"/>Zwitzer gſchwaͤtze die Schwalbe fuͤrbringet.
               <lb facs="#facs_2_l_31" n="N036"/><Numbering>7.</Numbering>
               <lb facs="#facs_2_tr_1_tl_103" n="N037"/>Minder lieblich beduncket vns zwaren/
               <lb facs="#facs_2_tr_1_tl_106" n="N038"/>Wann der Guckguck/ gefraget von jahren/
               <lb facs="#facs_2_tr_1_tl_109" n="N039"/>Seine Tertzen hieruͤber laßt fahren:
               <lb facs="#facs_2_tr_1_tl_112" n="N040"/>Wann die Bienen ſo heiſer thuͦn brummen/
               <lb facs="#facs_2_tr_1_tl_115" n="N041"/>Wann ſie vber die Blumen hinſummen:
               <lb facs="#facs_2_tr_1_tl_118" n="N042"/>Doch erfrewet vns jhres ankommen.
               <lb facs="#facs_2_l_36" n="N043"/><Numbering>8.</Numbering>
               <lb facs="#facs_2_tr_1_tl_67" n="N044"/>Die geſchnabelten feinde der Schlangen/
               <lb facs="#facs_2_tr_1_tl_70" n="N045"/>Jn dem Fruͤhling/ ohnfehlbar anlangen/
               <lb facs="#facs_2_tr_1_tl_73" n="N046"/>Die coaxenden Froͤſchen ſie fangen:
               <lb facs="#facs_2_tr_1_tl_76" n="N047"/>Mit denſelben die jungen ſie ſpeiſen/
               <lb facs="#facs_2_tr_1_tl_79" n="N048"/>Jhre jungen ſich danckbar erweiſen/
               <lb facs="#facs_2_tr_1_tl_82" n="N049"/>Deren beyſpil den Kindern wir preiſen.
               <lb facs="#facs_2_l_40" n="N050"/><Numbering>9.</Numbering>
               <lb facs="#facs_2_tr_1_tl_85" n="N051"/>Jn den Weyern der Enten geſchwader/
               <lb facs="#facs_2_tr_1_tl_88" n="N052"/>Sich ergetzet mit vilem geplader/
               <lb facs="#facs_2_tr_1_tl_91" n="N053"/>Vnd erꝛeget ein luſtig geſchnader:
               <lb facs="#facs_2_tr_1_tl_94" n="N054"/>Jn den Seen es wimmelt von Fiſchen/
               <lb facs="#facs_2_tr_1_tl_96" n="N055"/>Die ſich aber geparet vermiſchen/
               <lb facs="#facs_2_tr_1_tl_100" n="N056"/>Vnd mit ſchwuͤmmen vnd ſpringen erfriſchen.
               <lb facs="#facs_2_l_45" n="N057"/><Numbering>10.</Numbering>
               <lb facs="#facs_2_tr_1_tl_102" n="N058"/>Nun bedeutet der Fruͤhling hieneben
               <lb facs="#facs_2_tr_1_tl_105" n="N059"/>Jungen Leuhten jhr bluͤhendes Leben/
               <lb facs="#facs_2_tr_1_tl_108" n="N060"/>Das der Tugend ſie ſollen ergeben/
               <lb facs="#facs_2_tr_1_tl_111" n="N061"/>Doch ſo wollen wir jhnen nicht wehren
               <lb facs="#facs_2_tr_1_tl_114" n="N062"/>Die gebuͤrlichen frewden/ in ehren/
               <lb facs="#facs_2_tr_1_tl_117" n="N063"/>So die zeiten erlauben vnd lehren.
            </ab>
         </div>
      </body>
   </text>
</TEI>