   <text>
      <body>
         <div>
            <pb facs="#facs_1" n="1" xml:id="img_0001"/>
            <pb facs="#facs_2" n="2" xml:id="img_0002"/>
            <pb facs="#facs_3" n="3" xml:id="img_0003"/>
            <pb facs="#facs_4" n="4" xml:id="img_0004"/>
            <ab facs="#facs_4_tr_1" type="">
               <lb facs="#facs_4_l" n="N001"/><Antiqua><Numbering>I.</Numbering></Antiqua>
               <lb facs="#facs_4_tr_1_tl_2" n="N002"/>
               <lb facs="#facs_4_tr_1_tl_3" n="N003"/><Antiqua><Initial_letter>D</Initial_letter>Ifficile eſt Tempus, carè Bacch<unclear reason="Unklar ob Zirkumflex oder Gravis">ù</unclear>sque Cerésque</Antiqua>
               <lb facs="#facs_4_tr_1_tl_4" n="N004"/><Antiqua>Venditur, &amp; paſſim Mars fremit atque furit.</Antiqua>
               <lb facs="#facs_4_tr_1_tl_5" n="N005"/><Antiqua>Exeat è thalamo <Small_capitals>SPONSUS</Small_capitals>, feſtinet ad aras,</Antiqua>
               <lb facs="#facs_4_tr_1_tl_6" n="N006"/><Antiqua>Et gratas ſanctè tollat ad aſtra manus!</Antiqua>
               <lb facs="#facs_4_tr_1_tl_7" n="N007"/><Antiqua>Quòd Deus omnipotens felici ſidere gratum</Antiqua>
               <lb facs="#facs_4_tr_1_tl_8" n="N008"/><Antiqua>Dat comitem adverſi, dat comit<unclear reason="Unklar ob Zirkumflex oder Gravis">é</unclear>mq; boni.</Antiqua>
               <lb facs="#facs_4_tr_1_tl_9" n="N009"/>Hochzeit-Geſang.
               <lb facs="#facs_4_tr_1_tl_10" n="N010"/>Jn der Melodey des 134. Pſalmens.
               <lb facs="#facs_4_tr_1_tl_12" n="N011"/><Initial_letter>G</Initial_letter>Leich wie es ſtehet trefflich wol/
               <lb facs="#facs_4_tr_1_tl_14" n="N012"/>Wann ein Haußvatter/ wie er ſol/
               <lb facs="#facs_4_tr_1_tl_16" n="N013"/>Den ſeinen gehet vor mit fleiß/
               <lb facs="#facs_4_tr_1_tl_18" n="N014"/>Vnd ſelb erſtattet ſein geheiß.
               <lb facs="#facs_4_tr_1_tl_20" n="N015"/>Wann er das boͤß in allweg ſcheucht/
               <lb facs="#facs_4_tr_1_tl_22" n="N016"/>Vnd wie ein Gifft die Laſter fleucht:
               <lb facs="#facs_4_tr_1_tl_24" n="N017"/>So/ daß an jhm das Haußgeſind/
               <lb facs="#facs_4_tr_1_tl_26" n="N018"/>Des guͦten ein Exempel find.
               <lb facs="#facs_4_tr_1_tl_28" n="N019"/>Alſo wird auch/ vnd weit vorauß/
               <lb facs="#facs_4_tr_1_tl_30" n="N020"/>Wol ſtehen/ wann das geiſtlich Hauß/
               <lb facs="#facs_4_tr_1_tl_32" n="N021"/>Verſehen iſt mit einem Mann/
               <lb facs="#facs_4_tr_1_tl_34" n="N022"/>Der ſein Lehr practicieren kan.
               <lb facs="#facs_4_tr_1_tl_36" n="N023"/>Dann/ wie S. Paulus lehret fein/
               <lb facs="#facs_4_tr_1_tl_38" n="N024"/>Ein Biſchoff ſol vnſtraͤfflich ſeyn:
               <lb facs="#facs_4_tr_1_tl_40" n="N025"/>Nur eines Weibes Mañ/ gaſtfrey/
               <lb facs="#facs_4_tr_1_tl_42" n="N026"/>Der wachtbar/ maͤſſig/ ehrbar ſey.
               <lb facs="#facs_4_tr_1_tl_44" n="N027"/>Geſchickt zum lehren/ Weinig nicht/
               <lb facs="#facs_4_tr_1_tl_46" n="N028"/>Kein Schlaͤgler/ vnd wie offt beſchicht/
               <lb facs="#facs_4_tr_1_tl_48" n="N029"/>Dem Geitz ergeben nicht zu vil:
               <lb facs="#facs_4_tr_1_tl_50" n="N030"/>Beſcheiden er jhn haben wil.
               <lb facs="#facs_4_tr_1_tl_52" n="N031"/>Auch daß er ſeinem eignen Hauß
               <lb facs="#facs_4_tr_1_tl_54" n="N032"/>Vorſtande wol/ vnd der vorauß
               <lb facs="#facs_4_tr_1_tl_56" n="N033"/>Die Kinder zur gehorſamkeit
               <lb facs="#facs_4_tr_1_tl_58" n="N034"/>Erzeuch/ mit aller ehrbarkeit.
               <lb facs="#facs_4_tr_1_tl_60" n="N035"/>Dann es gewüßlich nicht kan ſeyn/
               <lb facs="#facs_4_tr_1_tl_62" n="N036"/>Daß der verſorge die Gemein
               <lb facs="#facs_4_tr_1_tl_64" n="N037"/>Des Herꝛen/ wie es ſich gebürt/
               <lb facs="#facs_4_tr_1_tl_66" n="N038"/>An dem kein Haußzucht wirt geſpürt.
               <lb facs="#facs_4_tr_1_tl_11" n="N039"/>Herꝛ Braͤutigam/ Hans Heinrich Ott/
               <lb facs="#facs_4_tr_1_tl_13" n="N040"/>Nam diß in obacht ohne ſpott:
               <lb facs="#facs_4_tr_1_tl_15" n="N041"/>Sein Lehr er ſelber practiciert/
               <lb facs="#facs_4_tr_1_tl_17" n="N042"/>Das Leben darnach reguliert.
               <lb facs="#facs_4_tr_1_tl_19" n="N043"/>Vnd weil der Eheſtand Gott gefellt/
               <lb facs="#facs_4_tr_1_tl_21" n="N044"/>Hat er in ſelben auch geſtellt:
               <lb facs="#facs_4_tr_1_tl_23" n="N045"/>Seins gleichen eine Jungfraw Braut
               <lb facs="#facs_4_tr_1_tl_25" n="N046"/>Auff heut er Ehelich jhm vertrawt.
               <lb facs="#facs_4_tr_1_tl_27" n="N047"/>Sy iſt/ wie ſchreibet Salomon/
               <lb facs="#facs_4_tr_1_tl_29" n="N048"/>Des Ehemañs ein gezierte Cron:
               <lb facs="#facs_4_tr_1_tl_31" n="N049"/>Jhr Tugend/ Zucht vnd Künſchheit rein
               <lb facs="#facs_4_tr_1_tl_33" n="N050"/>Weit vbertrifft das Edelgſtein.
               <lb facs="#facs_4_tr_1_tl_35" n="N051"/>Dann ſy/ wie Petrus auch nicht wil/
               <lb facs="#facs_4_tr_1_tl_37" n="N052"/>Vmbhaͤnget nit des Goldes vil/
               <lb facs="#facs_4_tr_1_tl_39" n="N053"/>Beſonder zieret jhr Gemuͤht:
               <lb facs="#facs_4_tr_1_tl_41" n="N054"/>Jſt ehrbar: ſich vor boͤſem huͤt.
               <lb facs="#facs_4_tr_1_tl_43" n="N055"/>Zweymal glückſelig iſt Herꝛ Ott/
               <lb facs="#facs_4_tr_1_tl_45" n="N056"/>Dem ſoͤlches Weib beſcheeret Gott:
               <lb facs="#facs_4_tr_1_tl_47" n="N057"/>Hinfür wird er noch mehr alß wol
               <lb facs="#facs_4_tr_1_tl_49" n="N058"/>Der Gmein vorſtehen/ wie er ſol.
               <lb facs="#facs_4_tr_1_tl_51" n="N059"/>Er vnd ſy werden beyderſeyt
               <lb facs="#facs_4_tr_1_tl_53" n="N060"/>Einandern lieben ohne ſtreyt:
               <lb facs="#facs_4_tr_1_tl_55" n="N061"/>So/ daß an jhnen eigentlich/
               <lb facs="#facs_4_tr_1_tl_57" n="N062"/>Das Haußgeſind erſpiegle ſich.
               <lb facs="#facs_4_tr_1_tl_59" n="N063"/>Deß woͤll' ſie ſaͤgnen hie vnd dort/
               <lb facs="#facs_4_tr_1_tl_61" n="N064"/>Der einig vnſer aller Hort/
               <lb facs="#facs_4_tr_1_tl_63" n="N065"/>Vnd vnſer liebe Braͤutigam.
               <lb facs="#facs_4_tr_1_tl_65" n="N066"/>O Herꝛ/ gelobet ſey dein Nam.
               <lb facs="#facs_4_tr_1_tl_67" n="N067"/>J. W. Simler/ Zuchtm. zum Frawenmünſter.
            </ab>
