   <text>
      <body>
         <div>
            <pb facs="#facs_1" n="1" xml:id="img_0001"/>
            <pb facs="#facs_2" n="2" xml:id="img_0002"/>
            <ab facs="#facs_2_r_15" type="">
               <lb facs="#facs_2_l_81" n="N001"/><Antiqua>C. Meÿer fecit, et ex:</Antiqua>
            </ab>
            <ab facs="#facs_2_tr_1" type="">
               <lb facs="#facs_2_tr_1_tl_19" n="N001"/><Antiqua><Small_capitals><Spaced_letters>CANTUS.<Small_capitals/></Spaced_letters><Small_capitals/></Small_capitals><Small_capitals/><Spaced_letters/></Antiqua><Spaced_letters/>
               <lb facs="#facs_2_tr_1_tl_24" n="N002"/>Wiewol der zeiten ſchoͤnſte Zeit
               <lb facs="#facs_2_tr_1_tl_36" n="N003"/>Vns abgenadet hat:/:
               <lb facs="#facs_2_tr_1_tl_28" n="N004"/>So kom͂t jedoch/ mit nutzbarkeit/
               <lb facs="#facs_2_tr_1_tl_40" n="N005"/>Der Sommer an jhr ſtatt:
               <lb facs="#facs_2_tr_1_tl_49" n="N006"/>Da wir Gott zuͦ bitten/
               <lb facs="#facs_2_tr_1_tl_61" n="N007"/>Daß/ nach Landes ſitten/
               <lb facs="#facs_2_tr_1_tl_70" n="N008"/>Werden abgeſchnidten
               <lb facs="#facs_2_tr_1_tl_81" n="N009"/>Die Saaten/ fruͤh vnd ſpaat.
               <lb facs="#facs_2_l" n="N010"/><Antiqua><Small_capitals><Spaced_letters>TENOR.<Small_capitals/></Spaced_letters><Small_capitals/></Small_capitals><Small_capitals/><Spaced_letters/></Antiqua><Spaced_letters/>
               <lb facs="#facs_2_tr_1_tl_25" n="N011"/>Wiewol der zeiten ſchoͤnſte Zeit
               <lb facs="#facs_2_tr_1_tl_37" n="N012"/>Vns abgenadet hat:/:
               <lb facs="#facs_2_tr_1_tl_29" n="N013"/>So kom͂t jedoch/ mit nutzbarkeit/
               <lb facs="#facs_2_tr_1_tl_41" n="N014"/>Der Sommer an jhr ſtatt:
               <lb facs="#facs_2_tr_1_tl_50" n="N015"/>Da wir Gott zuͦ bitten/
               <lb facs="#facs_2_tr_1_tl_58" n="N016"/>Daß/ nach Landes ſitten/
               <lb facs="#facs_2_tr_1_tl_72" n="N017"/>Werden abgeſchnidten
               <lb facs="#facs_2_tr_1_tl_79" n="N018"/>Die Saaten/ fruͤh vnd ſpaat.
               <lb facs="#facs_2_tr_1_tl_20" n="N019"/><Antiqua><Small_capitals><Spaced_letters>ALTUS.<Small_capitals/></Spaced_letters><Small_capitals/></Small_capitals><Small_capitals/><Spaced_letters/></Antiqua><Spaced_letters/>
               <lb facs="#facs_2_tr_1_tl_26" n="N020"/>Wiewol der zeiten ſchoͤnſte Zeit
               <lb facs="#facs_2_tr_1_tl_38" n="N021"/>Vns abgenadet hat<unclear reason="Entweder\u0020fehlt\u0020in\u0020diesem\u0020Wiederholungszeichen\u0020die\u0020Virgel\u0020oder\u0020sie\u0020ist\u0020nicht\u0020mehr\u0020erkennbar." alternative="/">: :</unclear>
               <lb facs="#facs_2_tr_1_tl_30" n="N022"/>So kom͂t jedoch/ mit nutzbarkeit/
               <lb facs="#facs_2_tr_1_tl_42" n="N023"/>Der Sommer an jhr ſtatt:
               <lb facs="#facs_2_tr_1_tl_51" n="N024"/>Da wir Gott zuͦ bitten/
               <lb facs="#facs_2_tr_1_tl_59" n="N025"/>Daß<comment comment="Komma\u0020hier\u0020schlecht\u0020zu\u0020erkennen,\u0020aber\u0020in\u0020Diskant\u0020und\u0020Tenor\u0020steht\u0020auch\u0020eines.">/</comment> nach Landes ſitten/
               <lb facs="#facs_2_tr_1_tl_71" n="N026"/>Werden abgeſchnidten
               <lb facs="#facs_2_tr_1_tl_80" n="N027"/>Die Saaten/ fruͤh vnd ſpaat.
               <lb facs="#facs_2_tr_1_tl_18" n="N028"/><Antiqua><Small_capitals><Spaced_letters>BASIS.<Small_capitals/></Spaced_letters><Small_capitals/></Small_capitals><Small_capitals/><Spaced_letters/></Antiqua><Spaced_letters/>
               <lb facs="#facs_2_tr_1_tl_27" n="N029"/>Wiewol der zeiten ſchoͤnſte Zeit
               <lb facs="#facs_2_tr_1_tl_39" n="N030"/>Vns abgenadet hat:/:
               <lb facs="#facs_2_tr_1_tl_31" n="N031"/>So kom͂t jedoch/ mit nutzbarkeit
               <lb facs="#facs_2_tr_1_tl_43" n="N032"/>Der Sommer an jhr ſtatt:
               <lb facs="#facs_2_tr_1_tl_52" n="N033"/>Da wir Gott zuͦ bitten/
               <lb facs="#facs_2_tr_1_tl_60" n="N034"/>Daß<unclear reason="Kaum\u0020zu\u0020erkennen,\u0020ob\u0020das\u0020Komma\u0020wie\u0020in\u0020Diskant\u0020und\u0020Tenor\u0020auch\u0020hier\u0020steht">/</unclear> nach Landes ſitten/
               <lb facs="#facs_2_tr_1_tl_69" n="N035"/>Werden abgeſchnidten
               <lb facs="#facs_2_tr_1_tl_82" n="N036"/>Die Saaten/ fruͤh vnd ſpaat.
            </ab>
            <ab facs="#facs_2_r" type="">
               <lb facs="#facs_2_l_118" n="N001"/><Numbering>2.</Numbering>
               <lb facs="#facs_2_tr_1_tl_83" n="N002"/>Es gibt der Sommer/ was er ſol/
               <lb facs="#facs_2_tr_1_tl_87" n="N003"/>Durch Gottes guͤtigkeit:/:
               <lb facs="#facs_2_tr_1_tl_90" n="N004"/>Korn/ Gaͤrſten/ Bonen/ Hanff vnd Koͤl/
               <lb facs="#facs_2_tr_1_tl_93" n="N005"/>Vnd anderley Getraͤid:
               <lb facs="#facs_2_tr_1_tl_96" n="N006"/>Hoͤw vnd Graß darneben
               <lb facs="#facs_2_tr_1_tl_99" n="N007"/>Thuͦt er/ reichlich/ geben
               <lb facs="#facs_2_tr_1_tl_102" n="N008"/>Allem Vieh/ zuͦ leben
               <lb facs="#facs_2_tr_1_tl_105" n="N009"/>Jm Stall/ vnd auff der Weyd.
               <lb facs="#facs_2_l_122" n="N010"/><Numbering>3.</Numbering>
               <lb facs="#facs_2_tr_1_tl_108" n="N011"/>Der Maͤder auff der Matten fellt
               <lb facs="#facs_2_tr_1_tl_111" n="N012"/>Das noch Taw-naſſe Graß<comment comment="Dieser Doppelpunkt weicht typographisch von den anderen ab.">:</comment>/:
               <lb facs="#facs_2_tr_1_tl_114" n="N013"/>Die Waͤydwerck werden eyngeſtellt/
               <lb facs="#facs_2_tr_1_tl_117" n="N014"/>Deß mehret ſich der Has:
               <lb facs="#facs_2_tr_1_tl_120" n="N015"/>Berg vnd Thal erklingen/
               <lb facs="#facs_2_tr_1_tl_123" n="N016"/>Alle Grillen ſingen/
               <lb facs="#facs_2_tr_1_tl_127" n="N017"/>Die Hoͤwſchraͤcken ſpringen/
               <lb facs="#facs_2_tr_1_tl_129" n="N018"/>Bien-honig fließt fürbaß.
               <lb facs="#facs_2_l_127" n="N019"/><Numbering>4.</Numbering>
               <lb facs="#facs_2_tr_1_tl_84" n="N020"/>Wann Sirius mit ſeiner Gluͦt
               <lb facs="#facs_2_tr_1_tl_86" n="N021"/>Die Saat entfaͤrwet gantz<comment comment="Dieser Doppelpunkt weicht typographisch von den anderen ab.">:</comment>/:
               <lb facs="#facs_2_tr_1_tl_89" n="N022"/>Die Ceres jhr bereiten thuͦt
               <lb facs="#facs_2_tr_1_tl_92" n="N023"/>Von aͤhren einen Krantz:
               <lb facs="#facs_2_tr_1_tl_95" n="N024"/>Bald es anhebt tagen/
               <lb facs="#facs_2_tr_1_tl_98" n="N025"/>Vor dem Sonnen-wagen/
               <lb facs="#facs_2_tr_1_tl_101" n="N026"/>Thuͦt ſie vmbhinſagen
               <lb facs="#facs_2_tr_1_tl_104" n="N027"/>Zum rauchen Sichel-dantz.
               <lb facs="#facs_2_l_131" n="N028"/><Numbering>5.</Numbering>
               <lb facs="#facs_2_tr_1_tl_107" n="N029"/>Die Waͤgen von der Garben laſt/
               <lb facs="#facs_2_tr_1_tl_110" n="N030"/>Vnd groſſer Fuͦdern Hoͤw:/:
               <lb facs="#facs_2_tr_1_tl_113" n="N031"/>Wie ſaͤufftzen hoͤrt man gyren vaſt/
               <lb facs="#facs_2_tr_1_tl_116" n="N032"/>Jſt doch ein froͤlich gſchrey:
               <lb facs="#facs_2_tr_1_tl_119" n="N033"/>Man erfüllt die Scheuren/
               <lb facs="#facs_2_tr_1_tl_122" n="N034"/>Thuͦt dem Hunger ſteuren/
               <lb facs="#facs_2_tr_1_tl_125" n="N035"/>Durch die Hitz verleuren
               <lb facs="#facs_2_tr_1_tl_128" n="N036"/>Die Bronnen ſich vorbey.
               <lb facs="#facs_2_l_136" n="N037"/><Numbering>6.</Numbering>
               <lb facs="#facs_2_tr_1_tl_85" n="N038"/>Darumb beſchaͤr von Wollen dick
               <lb facs="#facs_2_tr_1_tl_88" n="N039"/>Die Schaaffe/ wer es kan:/:
               <lb facs="#facs_2_tr_1_tl_91" n="N040"/>Berupff die Gaͤnß/ beſtreych vnd lick/
               <lb facs="#facs_2_tr_1_tl_94" n="N041"/>Das Baͤltzwerck leg hindan:
               <lb facs="#facs_2_tr_1_tl_97" n="N042"/>Luſtig ſich erkuͤhlen/
               <lb facs="#facs_2_tr_1_tl_100" n="N043"/>Vnd zuͦgleich abſpuͤhlen
               <lb facs="#facs_2_tr_1_tl_103" n="N044"/>Junge leuht/ die fühlen
               <lb facs="#facs_2_tr_1_tl_106" n="N045"/>Des Sommers Hitz voran.
               <lb facs="#facs_2_l_143" n="N046"/><Numbering>7.</Numbering>
               <lb facs="#facs_2_tr_1_tl_109" n="N047"/>Wie nun/ zuͦ end der Sommers zeit/
               <lb facs="#facs_2_tr_1_tl_112" n="N048"/>Zum reyffen ſchicken ſich:/:
               <lb facs="#facs_2_tr_1_tl_115" n="N049"/>Die Traͤubel vnd das Obs bereit/
               <lb facs="#facs_2_tr_1_tl_118" n="N050"/>So ſchick/ o Jüngling/ dich:
               <lb facs="#facs_2_tr_1_tl_121" n="N051"/>Reyff in rechten dingen/
               <lb facs="#facs_2_tr_1_tl_124" n="N052"/>Guͦte frücht zuͦ bringen:
               <lb facs="#facs_2_tr_1_tl_126" n="N053"/>Thuͦ die Laſter zwingen/
               <lb facs="#facs_2_tr_1_tl_130" n="N054"/>Werd auch der Omeiß gleich.
            </ab>
            <ab facs="#facs_2_r_35" type="">
               <lb facs="#facs_2_tr_1_tl_131" n="N001"/>Mag auch geſungen werden in der melodey: Der Fruͤhling ſchoͤn hardringen thuͦt/ ꝛc.
            </ab>
         </div>
      </body>
   </text>
</TEI>