            <pb facs="#facs_2" n="2" xml:id="img_0002"/>
            <ab facs="#facs_2_tr_1" type="">
               <lb facs="#facs_2_tr_1_tl_19" n="N001"/>Treuhertziges Vermahnungsgeſang/ ſo wol für
               <lb facs="#facs_2_tr_1_tl_22" n="N002"/>die ſchon erwachſene/ alß auch für die noch minderjaͤhrige Jugend: Selbige
               <lb facs="#facs_2_tr_1_tl_23" n="N003"/>hierdurch; neben Vorſtellung des verlohrnen Sohns; ab dem gefaͤhrlichen Laſter-
               <lb facs="#facs_2_tr_1_tl_24" n="N004"/>waͤg/ auf die ſichere Tugendbahn zubringen.
               <lb facs="#facs_2_l_19" n="N005"/><Numbering>1.</Numbering>
               <lb facs="#facs_2_l" n="N006"/>Nichts wehrter Sohn, gar boͤſer art
               <lb facs="#facs_2_l_15" n="N007"/>ſein Erb erzwingt, von Heÿmat fahrt.
               <lb facs="#facs_2_l_27" n="N008"/><Numbering>2.</Numbering>
               <lb facs="#facs_2_l_31" n="N009"/>Leichtfehrtig er ſein Guͦt verzehrt:
               <lb facs="#facs_2_l_35" n="N010"/>Groß Armuͦht drauf beÿ ihm eÿnkehrt.
               <lb facs="#facs_2_l_39" n="N011"/><Numbering>3</Numbering>
               <lb facs="#facs_2_tr_1_tl_25" n="N012"/>Der Schweine Speiß; alß Hirt; ſich nehrt:
               <lb facs="#facs_2_tr_1_tl_29" n="N013"/>mit Reüen er zum Vatter kehrt.
               <lb facs="#facs_2_l_68" n="N014"/><Numbering>4.</Numbering>
               <lb facs="#facs_2_tr_1_tl_26" n="N015"/>Der Vatter nim̃t Jhn wider an
               <lb facs="#facs_2_tr_1_tl_30" n="N016"/>alß hett er nie kein Sünd getahn.
               <lb facs="#facs_2_tr_1_tl_28" n="N017"/><Antiqua>Luce.XV.
               <lb facs="#facs_2_tr_1_tl_31" n="N018"/>v.ii.etc.</Antiqua>
               <lb facs="#facs_2_l_5" n="N019"/><Antiqua>Conrad Meÿer fecit.</Antiqua>
            </ab>
            <ab facs="#facs_2_r" type="">
               <lb facs="#facs_2_l_40" n="N001"/><Numbering>1.</Numbering>
               <lb facs="#facs_2_tr_1_tl_33" n="N002"/><Initial_letter>F</Initial_letter>Riſch auf/ friſch auf/ ihr Knaben/
               <lb facs="#facs_2_tr_1_tl_37" n="N003"/>ihr Jungfern auch zugleich/
               <lb facs="#facs_2_tr_1_tl_40" n="N004"/>auff weitem Erdenreich:
               <lb facs="#facs_2_tr_1_tl_43" n="N005"/>Friſch auf/ euch zuerlaben/
               <lb facs="#facs_2_tr_1_tl_46" n="N006"/>ohn Kart- und Würffelſpil/
               <lb facs="#facs_2_tr_1_tl_49" n="N007"/>ohn wetten/ fluͦchen/ rauffen/
               <lb facs="#facs_2_tr_1_tl_52" n="N008"/>auch nicht; wie ihrer vil;
               <lb facs="#facs_2_tr_1_tl_55" n="N009"/>mit unmaß/ freſſen/ ſauffen!
               <lb facs="#facs_2_l_45" n="N010"/><Numbering>2.</Numbering>
               <lb facs="#facs_2_tr_1_tl_57" n="N011"/>Was nützen eitle Sachen?
               <lb facs="#facs_2_tr_1_tl_60" n="N012"/>Was hilfft das bar gezellt
               <lb facs="#facs_2_tr_1_tl_63" n="N013"/>mit ſpilen gſtolne Gelt?
               <lb facs="#facs_2_tr_1_tl_66" n="N014"/>Was Gſellſchafft viler Hachen?
               <lb facs="#facs_2_tr_1_tl_69" n="N015"/>Was Wolluſt? Kleiderpracht?
               <lb facs="#facs_2_tr_1_tl_72" n="N016"/>Was Muͤſſiggang deßgleichen/
               <lb facs="#facs_2_tr_1_tl_75" n="N017"/>wardurch ihr/ armgemacht/
               <lb facs="#facs_2_tr_1_tl_78" n="N018"/>muͤßt etwan gar entweichen?
               <lb facs="#facs_2_l_51" n="N019"/><Numbering>3.</Numbering>
               <lb facs="#facs_2_tr_1_tl_34" n="N020"/>Geht nicht ſo vil ſpatzieren
               <lb facs="#facs_2_tr_1_tl_35" n="N021"/>zum Dantz- und Kegelplatz:
               <lb facs="#facs_2_tr_1_tl_38" n="N022"/>nicht folgt vermum͂tem Schatz:
               <lb facs="#facs_2_tr_1_tl_41" n="N023"/>Laßt nichtes euch verfuͤhren!
               <lb facs="#facs_2_tr_1_tl_45" n="N024"/>Gewiß/ noch Bier/ noch Wein/
               <lb facs="#facs_2_tr_1_tl_47" n="N025"/>auch nicht Taback/ noch ſpilen/
               <lb facs="#facs_2_tr_1_tl_51" n="N026"/>noch buͦhlen wird es ſeyn/
               <lb facs="#facs_2_tr_1_tl_54" n="N027"/>warnach ihr ſoltet zilen.
               <lb facs="#facs_2_l_57" n="N028"/><Numbering>4.</Numbering>
               <lb facs="#facs_2_l_4" n="N029"/>Geht auf die Bahn der Tugend/
               <lb facs="#facs_2_tr_1_tl_58" n="N030"/>der Gottesforcht und Lehr/
               <lb facs="#facs_2_tr_1_tl_61" n="N031"/>die bringet Nutz und Ehr
               <lb facs="#facs_2_tr_1_tl_64" n="N032"/>der Arbeitſammen Jugend.
               <lb facs="#facs_2_tr_1_tl_67" n="N033"/>Wol dem/ und aber wol/
               <lb facs="#facs_2_tr_1_tl_71" n="N034"/>den Kunſt und Weisheit ſchmucket/
               <lb facs="#facs_2_tr_1_tl_73" n="N035"/>Lehrt/ wie er's machen ſol
               <lb facs="#facs_2_tr_1_tl_76" n="N036"/>wan noht und armuͦht trucket.
               <lb facs="#facs_2_l_63" n="N037"/><Numbering>5.</Numbering>
               <lb facs="#facs_2_tr_1_tl_32" n="N038"/>Jhr Jüngling/ und Jungfrauen/
               <lb facs="#facs_2_tr_1_tl_36" n="N039"/>Jhr Kinder/ groß und klein/
               <lb facs="#facs_2_tr_1_tl_39" n="N040"/>woͤllt doch gefoͤlgig ſeyn
               <lb facs="#facs_2_tr_1_tl_42" n="N041"/>wañ Eltern euch erbauen:
               <lb facs="#facs_2_tr_1_tl_44" n="N042"/>Ergetzet euch hinfort
               <lb facs="#facs_2_tr_1_tl_48" n="N043"/>in Vatterlaͤndſchen Gſchichten/
               <lb facs="#facs_2_tr_1_tl_50" n="N044"/>vorauß in Gottes Wort/
               <lb facs="#facs_2_tr_1_tl_53" n="N045"/>wie auch in Kinderbrichten!
               <lb facs="#facs_2_l_67" n="N046"/><Numbering>6.</Numbering>
               <lb facs="#facs_2_tr_1_tl_56" n="N047"/>Erſpieglet euch zugleiche/
               <lb facs="#facs_2_tr_1_tl_59" n="N048"/>Hier/ am verlohrnen Sohn/
               <lb facs="#facs_2_tr_1_tl_62" n="N049"/>und; zuvermeiden Hohn;
               <lb facs="#facs_2_tr_1_tl_65" n="N050"/>von Laſtern jeder weiche:
               <lb facs="#facs_2_tr_1_tl_68" n="N051"/>Suͦcht ſeine Buͦß und Reu/
               <lb facs="#facs_2_tr_1_tl_70" n="N052"/>damit euch widerfahre
               <lb facs="#facs_2_tr_1_tl_74" n="N053"/>geleiche Gnad und Treu:
               <lb facs="#facs_2_tr_1_tl_77" n="N054"/>Der Hoͤheſt euch bewahre!
            </ab>
            <ab facs="#facs_2_r_13" type="">
               <lb facs="#facs_2_tr_1_tl_81" n="N001"/>Der Kunſt- Zucht- und Tugendliebenden Jugend in Zuͤrich/ Ab der Burgerbuͤcherey daſelbſten/
               <lb facs="#facs_2_l_62" n="N002"/>fuͤr das 1669. Jahre/ verehrt.
            </ab>
         </div>
