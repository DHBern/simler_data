            <ab facs="#facs_57_tr_1" type="">
               <lb facs="#facs_57_tr_1_tl_1" n="N001"/><page_number>56</page_number>
               <lb facs="#facs_57_tr_1_tl_3" n="N002"/>Kling- oder Lobgeticht/
               <lb facs="#facs_57_tr_1_tl_4" n="N003"/>Uber
               <lb facs="#facs_57_tr_1_tl_5" n="N004"/>Herꝛen Joh. Jacob Bodmers/
               <lb facs="#facs_57_tr_1_tl_6" n="N005"/>Zunftmeiſters/ Rahtsverwandten/
               <lb facs="#facs_57_tr_1_tl_7" n="N006"/>und Truckerherꝛen/
               <lb facs="#facs_57_tr_1_tl_8" n="N007"/>Wolriechende/ Geiſtliche
               <lb facs="#facs_57_tr_1_tl_9" n="N008"/>Violblumen.
               <lb facs="#facs_57_tr_1_tl_10" n="N009"/><Initial_letter>R</Initial_letter>Echt/ ſo/ Herꝛ Bodmer/ ſo koͤnt Jhr zugleich abwarten
               <lb facs="#facs_57_tr_1_tl_11" n="N010"/>Der Edlen Truckerkunſt/ und dem Regentenſtand/
               <lb facs="#facs_57_tr_1_tl_12" n="N011"/>Wann Jhr/ was beyden nuzt/ <printing_error sic="ergeiffet">ergreiffet</printing_error> mit der hand/
               <lb facs="#facs_57_tr_1_tl_13" n="N012"/>Die Tichterfeder iſt gemeint/ im Muſengarten.
               <lb facs="#facs_57_tr_1_tl_14" n="N013"/>Jhr trachtet im Geſaͤtz/ das Leben recht zuarten:
               <lb facs="#facs_57_tr_1_tl_15" n="N014"/>Jm Glauben gruͤndet Jhr: Beveſtnets mit Gebett:
               <lb facs="#facs_57_tr_1_tl_16" n="N015"/>Und ſucht Erloͤſung nur auf Chriſti Marterſtett/
               <lb facs="#facs_57_tr_1_tl_17" n="N016"/>Der einig außgewezt all' unſre ſuͤndenſcharten.
               <lb facs="#facs_57_tr_1_tl_18" n="N017"/>O/ ſchoͤnſte Violblum: Geruchs und Zierden foll!
               <lb facs="#facs_57_tr_1_tl_19" n="N018"/>Die ihren Herꝛen macht auch ſelber riechen wol/
               <lb facs="#facs_57_tr_1_tl_20" n="N019"/>So wol im Vatterland/ alß an entlegnen Orten:
               <lb facs="#facs_57_tr_1_tl_21" n="N020"/>Und/ neben dem was Er getichtet hat nach mehr/
               <lb facs="#facs_57_tr_1_tl_22" n="N021"/>Dem Chriſtenvolk zu gut/ fuͤrauß zu Gottes Ehr:
               <lb facs="#facs_57_tr_1_tl_23" n="N022"/>Fuͤhrt Jhn/ wie billich iſt/ den weg zur Ehrenpforten.
               <lb facs="#facs_57_tr_1_tl_24" n="N023"/>Zu ſchuldigen Ehren
               <lb facs="#facs_57_tr_1_tl_25" n="N024"/>freywilligſt aufgeſezt
               <lb facs="#facs_57_tr_1_tl_26" n="N025"/>Von J. W. Simler.
            </ab>
