            <ab facs="#facs_2_r" type="">
               <lb facs="#facs_2_l" n="N001"/>Niemand veracht/ dich ſelb betracht.
               <lb facs="#facs_2_l_19" n="N002"/>Der Hertzen ſpiegel zeigt
               <lb facs="#facs_2_l_30" n="N003"/>eim jeden ſeine Mängel:
               <lb facs="#facs_2_l_41" n="N004"/>Wer ſich darin beſchaut
               <lb facs="#facs_2_l_48" n="N005"/>der findet keinen
               <lb facs="#facs_2_l_52" n="N006"/>Engel.
            </ab>
            <ab facs="#facs_2_r_33" type="">
               <lb facs="#facs_2_l_50" n="N001"/>Ab der Burgerbibliothec verehr A°. 1658 Jahr.
               <lb facs="#facs_2_l_54" n="N002"/><Antiqua>Conrad Meÿer invenit fecit et excu.</Antiqua>
            </ab>
