   <text>
      <body>
         <div>
            <pb facs="#facs_1" n="1" xml:id="img_0001"/>
            <pb facs="#facs_2" n="2" xml:id="img_0002"/>
            <ab facs="#facs_2_r" type="">
               <lb facs="#facs_2_l" n="N001"/><Antiqua>Cantus.</Antiqua>
               <lb facs="#facs_2_r_tl_2" n="N002"/>Die dritte Zeit
               <lb facs="#facs_2_r_tl_4" n="N003"/>Jn jedem Jahr/ Nicht minder zwar
               <lb facs="#facs_2_l_33" n="N004"/>Alß andre mich erfreüt:/:
               <lb facs="#facs_2_r_tl_6" n="N005"/>Sie kom̃t herzuͦ geſchlichen
               <lb facs="#facs_2_r_tl_9" n="N006"/>Wañ Stork v<unclear alternative="¨" reason="Anstatt des Nasalstriches könnte hier ein Trema fälschlicherweise gedruckt worden sein.">ñ</unclear> Schwalm entwichen/
               <lb facs="#facs_2_r_tl_11" n="N007"/>Die Sonn der Waag nicht weit.
            </ab>
            <ab facs="#facs_2_r_5" type="">
               <lb facs="#facs_2_r_5_tl_1" n="N001"/><Antiqua>Altus.</Antiqua>
               <lb facs="#facs_2_l_115" n="N002"/>Die dritte Zeit
               <lb facs="#facs_2_r_5_tl_6" n="N003"/>Jn jedem Jahr/ Nicht minder zwar
               <lb facs="#facs_2_l_173" n="N004"/>Alß andre mich erfreüt:/:
               <lb facs="#facs_2_r_5_tl_10" n="N005"/>Sie kom̃t herzuͦ geſchlichen
               <lb facs="#facs_2_r_5_tl_12" n="N006"/>Wañ Stork vñ Schwalm entwichen/
               <lb facs="#facs_2_l_169" n="N007"/>Die Sonn der Waag nicht weit.
            </ab>
            <ab facs="#facs_2_r_6" type="">
               <lb facs="#facs_2_r_6_tl_1" n="N001"/><Antiqua>Tenor.</Antiqua>
               <lb facs="#facs_2_r_6_tl_3" n="N002"/>Die dritte Zeit
               <lb facs="#facs_2_r_6_tl_5" n="N003"/>Jn jedem Jahr/ Nicht minder zwar
               <lb facs="#facs_2_r_6_tl_8" n="N004"/>Alß andre mich erfreüt:/:
               <lb facs="#facs_2_r_6_tl_11" n="N005"/>Sie ko<unclear reason="Nicht\u0020sicher,\u0020ob\u0020wie\u0020in\u0020Diskant\u0020und\u0020Alt\u0020hier\u0020auch\u0020ein\u0020Nasalstrich\u0020steht" alternative="m">m̃</unclear>t herzuͦ geſchlichen
               <lb facs="#facs_2_r_6_tl_13" n="N006"/>Wañ Stork vñ Schwalm entwichen/
               <lb facs="#facs_2_l_208" n="N007"/>Die Sonn der Waag nicht weit.
            </ab>
            <ab facs="#facs_2_r_7" type="">
               <lb facs="#facs_2_r_7_tl_1" n="N001"/><Antiqua>Baſis.</Antiqua>
               <lb facs="#facs_2_l_17" n="N002"/>Die dritte Zeit
               <lb facs="#facs_2_r_7_tl_6" n="N003"/>Jn jedem Jahr/ Nicht minder zwar
               <lb facs="#facs_2_r_7_tl_9" n="N004"/>Alß andre mich erfreüt:/:
               <lb facs="#facs_2_r_7_tl_12" n="N005"/>Sie kom̃t herzuͦ geſchlichen
               <lb facs="#facs_2_r_7_tl_15" n="N006"/>Wañ Stork vñ Schwalm entwichen/
               <lb facs="#facs_2_r_7_tl_17" n="N007"/>Die Sonn der Waag nicht weit.
            </ab>
            <ab facs="#facs_2_r_2" type="">
               <lb facs="#facs_2_l_18" n="N001"/><Numbering>2.</Numbering>
               <lb facs="#facs_2_r_2_tl_1" n="N002"/>Sie bringet mit
               <lb facs="#facs_2_r_2_tl_2" n="N003"/>Vil Garten-frücht/ Vnd andre Z<unclear alternative="ü">uͤ</unclear>cht/
               <lb facs="#facs_2_r_2_tl_3" n="N004"/>Nach jedes landes ſitt:/:
               <lb facs="#facs_2_r_2_tl_4" n="N005"/>Koͤl/ Ruͤben/ Kürbß/ Limonen/
               <lb facs="#facs_2_r_2_tl_5" n="N006"/>Pomrantzen vnd Citronen/
               <lb facs="#facs_2_r_2_tl_6" n="N007"/>Auch wolgeſchmakte Quitt.
               <lb facs="#facs_2_l_22" n="N008"/><Numbering>3.</Numbering>
               <lb facs="#facs_2_r_2_tl_7" n="N009"/>Der Byren laſt
               <lb facs="#facs_2_r_2_tl_8" n="N010"/>Die aͤſte bukt/ Vnd nidertrukt
               <lb facs="#facs_2_r_2_tl_9" n="N011"/>Biß zuͦ der Erden vaſt:/:
               <lb facs="#facs_2_r_2_tl_10" n="N012"/>Die ſchoͤnen Aepfel prangen
               <lb facs="#facs_2_r_2_tl_11" n="N013"/>Mit jhren rohten Wangen/
               <lb facs="#facs_2_r_2_tl_12" n="N014"/>Erquiken manchen Gaſt.
               <lb facs="#facs_2_l_26" n="N015"/><Numbering>4.</Numbering>
               <lb facs="#facs_2_r_2_tl_13" n="N016"/>Man findet auch
               <lb facs="#facs_2_r_2_tl_14" n="N017"/>Auff diſes zil/ Baumnuſſen vil/
               <lb facs="#facs_2_r_2_tl_15" n="N018"/>Zuͦ mancherley gebrauch:/:
               <lb facs="#facs_2_r_2_tl_16" n="N019"/>Wie arme Leuhte wüſſen:
               <lb facs="#facs_2_r_2_tl_17" n="N020"/>So findet man auch nüſſen
               <lb facs="#facs_2_r_2_tl_18" n="N021"/>Am wilden Haſelſtrauch.
            </ab>
            <ab facs="#facs_2_r_3" type="">
               <lb facs="#facs_2_l_34" n="N001"/><Numbering>5.</Numbering>
               <lb facs="#facs_2_r_3_tl_1" n="N002"/>Die Pferſich ſind
               <lb facs="#facs_2_r_3_tl_2" n="N003"/>Ein Kinderſpeiß/ Geleicher weiß
               <lb facs="#facs_2_r_3_tl_3" n="N004"/>Die Naͤſpel teig vnd lind:/:
               <lb facs="#facs_2_r_3_tl_4" n="N005"/>Die Zwetzgen/ Feygen/ Kaͤſten
               <lb facs="#facs_2_r_3_tl_5" n="N006"/>Vnd Mandel ſeind der Gaͤſten:
               <lb facs="#facs_2_r_3_tl_6" n="N007"/>Ziparten ißt das Gſind.
               <lb facs="#facs_2_l_38" n="N008"/><Numbering>6.</Numbering>
               <lb facs="#facs_2_r_3_tl_7" n="N009"/>Jnſonderheit
               <lb facs="#facs_2_r_3_tl_8" n="N010"/>Die edel Frucht/ Der Raͤben zucht
               <lb facs="#facs_2_r_3_tl_9" n="N011"/>Wird flüſſig diſer zeit:/:
               <lb facs="#facs_2_r_3_tl_10" n="N012"/>Der arbeit niemand ſchohnet/
               <lb facs="#facs_2_r_3_tl_11" n="N013"/>Dieweil ſie trewlich lohnet
               <lb facs="#facs_2_r_3_tl_12" n="N014"/>Mit luſt vnd nutzbarkeit.
               <lb facs="#facs_2_l_42" n="N015"/><Numbering>7.</Numbering>
               <lb facs="#facs_2_r_3_tl_13" n="N016"/>Die beſten Fiſch/
               <lb facs="#facs_2_r_3_tl_14" n="N017"/>Den Lachß vorauß/ Man traͤgt zuͦ hauß
               <lb facs="#facs_2_r_3_tl_15" n="N018"/>Den Reichen alſo friſch:/:
               <lb facs="#facs_2_r_3_tl_16" n="N019"/>Auß Weyern/ Seen/ Flüſſen:
               <lb facs="#facs_2_r_3_tl_17" n="N020"/>Der mindern auch genieſſen
               <lb facs="#facs_2_r_3_tl_18" n="N021"/>Die Armen über Tiſch.
            </ab>
            <ab facs="#facs_2_r_8" type="">
               <lb facs="#facs_2_l_50" n="N001"/><Numbering>8.</Numbering>
               <lb facs="#facs_2_r_8_tl_1" n="N002"/>Der Waͤidmann ſich
               <lb facs="#facs_2_r_8_tl_2" n="N003"/>Jm Faͤld ergetzt/ Die Haſen hetzt/
               <lb facs="#facs_2_r_8_tl_3" n="N004"/>Vnd lokt dem Lerchen ſtrich:/:
               <lb facs="#facs_2_r_8_tl_4" n="N005"/>Er ſuͦchet/ mit verlangen/
               <lb facs="#facs_2_r_8_tl_5" n="N006"/>Die Schnaͤpfe beyzuͦfangen
               <lb facs="#facs_2_r_8_tl_6" n="N007"/>Jn Schlingen liſtiglich.
               <lb facs="#facs_2_l_54" n="N008"/><Numbering>9.</Numbering>
               <lb facs="#facs_2_r_8_tl_7" n="N009"/>Der Akkermann/
               <lb facs="#facs_2_r_8_tl_8" n="N010"/>Alß wol vernuͤgt/ Das Faͤlde pfluͤgt/
               <lb facs="#facs_2_r_8_tl_9" n="N011"/>Vnd widrumb ſaͤyet an:/:
               <lb facs="#facs_2_r_8_tl_10" n="N012"/>Die dürꝛen aͤſt er ſchneitelt:
               <lb facs="#facs_2_r_8_tl_11" n="N013"/>Sein Weibe raͤtſcht vnd reitelt
               <lb facs="#facs_2_r_8_tl_12" n="N014"/>Den Hanff/ ſo guͦt ſie kan.
               <lb facs="#facs_2_l_58" n="N015"/><Numbering>10</Numbering>
               <lb facs="#facs_2_r_8_tl_13" n="N016"/>Die Herpſtes-Zeit
               <lb facs="#facs_2_r_8_tl_14" n="N017"/>Jn jedem Jahr/ Nicht minder zwar
               <lb facs="#facs_2_r_8_tl_15" n="N018"/>Alß andre was bedeut:/:
               <lb facs="#facs_2_r_8_tl_16" n="N019"/>Das maͤnnlich Alter; merke;
               <lb facs="#facs_2_r_8_tl_17" n="N020"/>Erzeigen ſol im werke
               <lb facs="#facs_2_r_8_tl_18" n="N021"/>Des Glaubens Fruchtbarkeit.
            </ab>
            <ab facs="#facs_2_r_9" type="">
               <lb facs="#facs_2_r_9_tl_1" n="N001"/>Mag auch geſungen werden in der melodey: Bey mir mein Hertz/ ꝛc.
            </ab>
            <ab facs="#facs_2_r_11" type="">
               <lb facs="#facs_2_l_20" n="N001"/>Einer Ehrliebenden jungen Burgerſchafft zuͦ Zürich/ ab der Burger-
               <lb facs="#facs_2_l_24" n="N002"/>Bibliothek für das 1648. Jahre/ verehrt.
            </ab>
         </div>
