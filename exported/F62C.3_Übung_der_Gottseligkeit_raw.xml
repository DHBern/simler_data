   <text>
      <body>
         <div>
            <pb facs="#facs_1" n="1" xml:id="img_0001"/>
            <pb facs="#facs_2" n="2" xml:id="img_0002"/>
            <ab facs="#facs_2_tr_1" type="">
               <lb facs="#facs_2_tr_1_tl_1" n="N001"/>Wer in Gottſeligkeit, nach reiner lehr, ſich übet,
               <lb facs="#facs_2_tr_1_tl_2" n="N002"/>der bawet felſenfeſt, und ſicher vor dem fal:
               <lb facs="#facs_2_tr_1_tl_3" n="N003"/>Der aber bawt auf ſand, ja grundlos überal,
               <lb facs="#facs_2_tr_1_tl_4" n="N004"/>der falſchen lehrern folgt, und laſtern ſich ergibet.
            </ab>
            <pb facs="#facs_3" n="3" xml:id="img_0003"/>
            <ab facs="#facs_3_r" type="">
               <lb facs="#facs_3_l" n="N001"/>Uͤbung der Gottſeligkeit.
               <lb facs="#facs_3_l_1" n="N002"/>Gottſeligkeit
               <lb facs="#facs_3_l_2" n="N003"/>iſt zu allen
               <lb facs="#facs_3_l_3" n="N004"/>dingen
               <lb facs="#facs_3_l_4" n="N005"/>nutz.
               <lb facs="#facs_3_l_5" n="N006"/>Zürich
               <lb facs="#facs_3_l_6" n="N007"/>Beÿ Johann Jacob Bodmer.
            </ab>
            <pb facs="#facs_4" n="4" xml:id="img_0004"/>
            <pb facs="#facs_5" n="5" xml:id="img_0005"/>
            <pb facs="#facs_6" n="6" xml:id="img_0006"/>
         </div>
      </body>
