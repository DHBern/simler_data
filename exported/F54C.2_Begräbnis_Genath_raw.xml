            <ab facs="#facs_30_tr_1" type="">
               <lb facs="#facs_30_tr_1_tl_1" n="N001"/><Page_number>29</Page_number>
               <lb facs="#facs_30_tr_1_tl_2" n="N002"/>Auf
               <lb facs="#facs_30_tr_1_tl_3" n="N003"/>Herꝛen Johann Jacob Genathen/ ꝛc.
               <lb facs="#facs_30_tr_1_tl_4" n="N004"/>Begraͤbnuß.
               <lb facs="#facs_30_tr_1_tl_5" n="N005"/><Initial_letter>N</Initial_letter><Antiqua>U</Antiqua>n iſts mit Jhm gethan; nun fahrt
               <lb facs="#facs_30_tr_1_tl_6" n="N006"/>Er hin im Friden;
               <lb facs="#facs_30_tr_1_tl_7" n="N007"/>doch iſt ſein guter Nam͂ von uns nicht abge-
               <lb facs="#facs_30_tr_1_tl_8" n="N008"/>ſchiden:
               <lb facs="#facs_30_tr_1_tl_9" n="N009"/>die weitbekañte Preß/ durch die ein Mann
               <lb facs="#facs_30_tr_1_tl_10" n="N010"/>mehr ſchreibt
               <lb facs="#facs_30_tr_1_tl_11" n="N011"/>eins Tags alß ſonſt ein Jahr/ macht daß
               <lb facs="#facs_30_tr_1_tl_12" n="N012"/>Er ewig bleibt.
               <lb facs="#facs_30_tr_1_tl_13" n="N013"/>Johann Willhelm Simler/
               <lb facs="#facs_30_tr_1_tl_14" n="N014"/>Zuchtmeiſter im mehrern
               <lb facs="#facs_30_tr_1_tl_15" n="N015"/>Hof.
               <lb facs="#facs_30_tr_1_tl_17" n="N016"/><Pagination>D iij</Pagination>
            </ab>
            <ab facs="#facs_30_tr_2" type="">
               <lb facs="#facs_30_tr_2_tl_1" n="N001"/>Genath.
            </ab>
