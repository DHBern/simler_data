   <text>
      <body>
         <div>
            <pb facs="#facs_1" n="1" xml:id="img_0001"/>
            <ab facs="#facs_1_tr_1" type="">
               <lb facs="#facs_1_tr_1_tl_3" n="N001"/><Antiqua>ODE TROCHAICA,</Antiqua>
               <lb facs="#facs_1_tr_1_tl_4" n="N002"/>Vber
               <lb facs="#facs_1_tr_1_tl_5" n="N003"/>Das guldene Buͤchlein
               <lb facs="#facs_1_tr_1_tl_6" n="N004"/>Von der ſeligen
               <lb facs="#facs_1_tr_1_tl_7" n="N005"/>Ruͦh- oder Fridens-
               <lb facs="#facs_1_tr_1_tl_8" n="N006"/>uͤbung.
               <lb facs="#facs_1_tr_1_tl_9" n="N007"/><Initial_letter>W</Initial_letter>Ann ich mich zuͦ denen wende/
               <lb facs="#facs_1_tr_1_tl_10" n="N008"/>Die diß Buͤchlein eigentlich
               <lb facs="#facs_1_tr_1_tl_11" n="N009"/>Durchgelaͤſen bis zum ende/
               <lb facs="#facs_1_tr_1_tl_12" n="N010"/>Werden ſie erklaͤren ſich/
               <lb facs="#facs_1_tr_1_tl_13" n="N011"/>Daß es/ zuͦ bequaͤmer zeit/
               <lb facs="#facs_1_tr_1_tl_14" n="N012"/>Jn die Welt werd' außgebreit.
               <lb facs="#facs_1_l" n="N013"/><Numbering>2.</Numbering>
               <lb facs="#facs_1_tr_1_tl_15" n="N014"/>Wünſchen werden ſie darneben/
               <lb facs="#facs_1_tr_1_tl_16" n="N015"/>Daß ſein angebottner Schatz/
               <lb facs="#facs_1_tr_1_tl_17" n="N016"/>Wo auch jmmer Menſchen leben/
               <lb facs="#facs_1_tr_1_tl_18" n="N017"/>Wider moͤge finden platz:
               <lb facs="#facs_1_tr_1_tl_19" n="N018"/>Sonderlich im Teutſchen Land/
               <lb facs="#facs_1_tr_1_tl_20" n="N019"/>Bey dem hoͤchſt- vnd minſten Stand!
               <lb facs="#facs_1_tr_1_tl_21" n="N020"/><Catch_word><Numbering>3.</Numbering> Endt-</Catch_word>
            </ab>
            <pb facs="#facs_2" n="2" xml:id="img_0002"/>
            <ab facs="#facs_2_tr_1" type="">
               <lb facs="#facs_2_l" n="N001"/><Numbering>3.</Numbering>
               <lb facs="#facs_2_tr_1_tl_1" n="N002"/>Endtlich werdens mit mir preiſen
               <lb facs="#facs_2_tr_1_tl_2" n="N003"/>Den Vrhaͤber/ vnd zuͦgleich
               <lb facs="#facs_2_tr_1_tl_3" n="N004"/>Den Tolmetſchen: Die vns weiſen
               <lb facs="#facs_2_tr_1_tl_4" n="N005"/>Zuͦ dem Friden Saͤgen-reich/
               <lb facs="#facs_2_tr_1_tl_5" n="N006"/>Ja zur Himmels-Frewd vnd Ruͦh:
               <lb facs="#facs_2_tr_1_tl_6" n="N007"/><Spaced_letters>HERR/</Spaced_letters> den Fortgang gib darzuͦ!
               <lb facs="#facs_2_l_1" n="N008"/><Numbering>4.</Numbering>
               <lb facs="#facs_2_tr_1_tl_7" n="N009"/>Halleluja: Lobt den <Spaced_letters>HERREN</Spaced_letters>
               <lb facs="#facs_2_tr_1_tl_8" n="N010"/>Jhr/ die in dem Friden lebt:
               <lb facs="#facs_2_tr_1_tl_9" n="N011"/>Vnfrid weiche von euch ferꝛen/
               <lb facs="#facs_2_tr_1_tl_10" n="N012"/>Die jhr nach dem Friden ſtrebt:
               <lb facs="#facs_2_tr_1_tl_11" n="N013"/>Wider Satans liſt vnd gwalt/
               <lb facs="#facs_2_tr_1_tl_12" n="N014"/><Spaced_letters>HERR/</Spaced_letters> im Friden vns erhalt!
               <lb facs="#facs_2_tr_1_tl_13" n="N015"/>J. W. S.
            </ab>
         </div>
      </body>
