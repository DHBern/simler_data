{
  "name": "tei-odd-interpreter",
  "version": "0.1.0",
  "description": "Reads a TEI ODD and renders TEI by its Processing Model, without generating code",
  "keywords": ["tei", "odd", "processing-model", "digital-editions", "hast"],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DHBern/simler_data.git",
    "directory": "preview/lib"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@rgrove/parse-xml": "^4.2.3",
    "@types/hast": "^3.0.4",
    "@types/xast": "^2.0.4"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
